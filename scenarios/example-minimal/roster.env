# example-minimal — 两档案最小场景样例（自测用：证明场景覆写链路通；也可当新场景起点）
# 用法：export MX_SCENARIO=example-minimal 后跑任意 mx-* 工具即走本编制。
USERS=(admin liu zhao)
INSTANCED_USERS=(liu zhao)

boards_of() { case "$1" in
  liu)  echo "liu-pm-plan:sys-analyst liu-review:researcher" ;;
  zhao) echo "zhao-dev-core:developer zhao-dev-review:researcher" ;;
  *) echo "" ;;
esac; }

export MX_CENTRAL_REPO="issac-new/example-minimal"
export MX_CENTRAL_NAME="example-minimal"
export MX_ANCHOR_USER="liu"
export MX_ANCHOR_USER_B="zhao"
export MX_FENCE_ASSIGNEE="zhao-dev-core"
export MX_DISPATCH_ASSIGNEE="liu-sys-analyst"
export SKILLS_INSTALL="capability-report requirements-analyst pm-planning inbox-dedup"
