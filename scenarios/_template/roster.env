# roster.env — 新场景定义（mx-lib 场景层 source；模板=scenarios/_template/）
# 位置：scenarios/<你的场景名>/roster.env，起跑时 export MX_SCENARIO=<场景名>。
# 全部旋钮都可覆写；没写的项回落 aipay 默认（编制/板/中央仓/技能清单见 mux/mx-lib.sh 场景层）。

# ── 1. 编制（本场景的全新团队；名字即 matrix 账号名与 profile 名）──────
# admin 是系统引导账号约定名，建议保留；其余全部换成新团队。
# USERS=(admin <人类账号...>)
# INSTANCED_USERS=(<起 profile 实例的账号...>；USERS 的子集)

# ── 2. 板映射（账号 → "板名:agent 角色名" 列表；重定义函数覆写默认）────
# boards_of() { case "$1" in
#   <账号A>) echo "<账号A>-pm-plan:sys-analyst <账号A>-review:researcher" ;;
#   *) echo "" ;;
# esac; }

# ── 3. 中央仓（全新需求=全新远端仓；GitHub 上先建空仓或已有仓）────────
# export MX_CENTRAL_REPO="<owner>/<repo>"
# export MX_CENTRAL_NAME="<repo 短名，central/ 下的目录名>"

# ── 4. 锚档案（凭证核验/冒烟门禁 G2-G4 用的主档案对）─────────────────
# export MX_ANCHOR_USER="<账号A>"      # 需求分析与评审主线档案
# export MX_ANCHOR_USER_B="<账号B>"    # 交叉隔离断言的对端档案
# export MX_FENCE_ASSIGNEE="<板外围栏测试用的非法 assignee，须为其它账号的执行者>"
# export MX_DISPATCH_ASSIGNEE="<G4 实派生测试用的本场景执行者>"

# ── 5. 技能清单（装进每个 profile 的技能；开发技能建议由 swarm-yuan
#       生成器按新项目生成后放 skills/，再在此登记名册）───────────────
# export SKILLS_INSTALL="capability-report requirements-analyst pm-planning <新项目-dev技能名> inbox-dedup defect-loop testing-shift-left"

# ── 6. 场景驱动器：同目录放 scenario.sh（骨架见 _template/scenario-skeleton.sh），
#       需求材料放同目录 materials/，帧拍摄位登记 mux/capture-plan.env。
