# 派生构建产物(inject 生成,不入库)
.overlay-injected.json
vite.config.overlay.ts
*.log
node_modules
node_modules/
# inject 在仓库根生成的上游派生文件/目录（根锚定：不得误伤 vendor/ 基线同名目录——
# 2026-10-24 单仓整合轮实录：全局 packages//tests/ 规则曾把 vendor/hermes-studio/packages
# 等 24,772 个基线文件挡在 git add 之外）
/packages/
/tests/
# macOS 系统文件
.DS_Store
# 基础运行时:远端 vendor 模式的上游检出缓存(脚本生成,不入库)
.runtime-cache/
__pycache__/
# runtime/ 模板必须入库（D3 事故实锤 2026-10-03：模板无版本控制即漂移——旧基线副本
# 静默覆盖宿主演进态，pin/guardrail/域隔离层被抹）。只忽略其运行垃圾：
runtime/.pytest_cache/
runtime/**/__pycache__/
vite.config.overlay.wt.ts

# worktree 环境的上游符号链（主 checkout 中 upstream/ 是仓外真实目录，不入库）
/upstream
.patch-migrate.json
# 工作区本地产物（与 info/exclude 对齐，保证全新克隆 git status 干净）
/.claude/
/IN-FLIGHT
# ZCode 宿主会话产物与工作区搜索配置（本机生成，不入库）
/.zcode/
/.zcodeignore
# 单仓工作区随 repo 根落位的本地基建目录（升级源/运行数据/工作区备忘，不入库）
/archive
/sim-mux
/governance
/CLAUDE.md

# vendor/ 基线整树入库（含上游跟踪的 plugins/*/dashboard/dist 等资产），只挡本地
# 构建垃圾；vendor 变更走 VENDOR_SYNC=1 显式通道（pre-commit 钩子挡护）
vendor/**/.turbo/
vendor/**/*.tsbuildinfo
