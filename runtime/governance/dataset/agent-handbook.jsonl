{"kind":"verdict","id":"pass","label":"通过","semantics":"全部验收条件成立且有 exercised 级证据"}
{"kind":"verdict","id":"fail","label":"不通过","semantics":"证据明确反驳验收条件；词面相似不构成判定依据，判定只认结构化 verdict 字段"}
{"kind":"verdict","id":"conditional","label":"有条件通过","semantics":"放行但带解除条件，条件未解除前不算 pass"}
{"kind":"verdict","id":"inconclusive","label":"无法判定","semantics":"证据不可得（工具缺失/环境不具备/执行失败）；不是通过也不是失败，先修环境或补跑"}
{"kind":"verdict","id":"waived","label":"豁免","semantics":"有有效豁免记录（豁免人/理由/期限三要素齐）"}
{"kind":"verdict","id":"not_applicable","label":"不适用","semantics":"该门对本对象不适用，须附不适用理由"}
{"kind":"metric","id":"task.done","name":"任务完成","formula":"kanban 卡列流转至 done 且 completion_contract 四件套过闸（kanban_gates.py 强制）；仅列位置达标不算完成","dimensions":["board","assignee","capability"],"authority":"kanban.db（经 hermes CLI 单写者访问）","status":"live"}
{"kind":"metric","id":"gate.passRate","name":"门禁通过率","formula":"周期内结构化 verdict=pass 的闸门判定数 / 判定总数；conditional 计入分母不计入分子；not_applicable 双侧剔除","dimensions":["gate","capability","period"],"authority":"qgate runs 台账（.qgate/runs 扫描：cwd/仓根上寻/示例仓；GOVERNANCE_QGATE_RUNS 覆盖）","status":"live"}
{"kind":"metric","id":"dispatch.successRate","name":"派发成功率","formula":"引擎派发（本地）= 送达数（reason=queued/coalesced）/ 派发总数（同 commandId 去重、column 条目优先；deferred 计分母不计分子）。跨机派发 = task.receipt 状态达 created/running 的派单数 / task.assign 总数（Matrix 侧聚合待接线，如实分列）","dimensions":["unit","capability","period"],"authority":"派发结果台账（~/.hermes-web-ui/overlay/dispatch-ledger.jsonl，引擎派发）+ Matrix 注册房协议事件（跨机）","status":"live"}
{"kind":"metric","id":"run.durationP95","name":"运行时长 P95","formula":"周期内已完成 run 的 wall-clock 时长第 95 百分位；按 sloTier 分档对照目标值","dimensions":["capability","sloTier","period"],"authority":"kanban 事件流 + state.db","status":"live"}
{"kind":"metric","id":"slo.tierSuccessRate","name":"分档任务成功率","formula":"窗口内 done 数 / (done+archived) 数；assignee 经台账单元映射 sloTier，未映射入 unmapped 桶不计预算；样本 <minSamples 预算判定挂起","dimensions":["sloTier","windowDays"],"authority":"kanban.db（root+boards/* 聚合，只读）","status":"live"}
{"kind":"metric","id":"cost.perRun","name":"单次运行成本","formula":"run 内全部 model_call 用量按价目表折算求和；未收录模型不计金额并显式标注","dimensions":["capability","provider","period"],"authority":"usage-store（hermes-web-ui.db）+ token-meter 价目表","status":"defined"}
{"kind":"contract","id":"kanban.create","version":"1","purpose":"创建任务卡（本机执行面唯一入口，RACI 派发随成功路径触发）","input":"标题/正文/assignee(=profile)/skills/priority/tenant；completion_contract 可选，列门禁要求时强制","output":"taskId + 卡片当前状态","errors":["validation_failed","board_not_found","profile_unknown","contract_invalid"],"owner":"hermes-agent（kanban_db.py 单写者）","verdict_carrier":"completion_contract（结构化判定，词表引 metrics.yaml verdicts）"}
{"kind":"contract","id":"kanban.assign","version":"1","purpose":"指派任务到 profile（板级团队围栏 fail-closed）","input":"taskId + assignee；RACI 四元组可随正文 JSON raci 块解析派发","output":"更新后卡片状态","errors":["task_not_found","profile_unknown","fence_closed"],"owner":"hermes-agent（kanban_db.py 单写者；patch 391 围栏）","verdict_carrier":null}
{"kind":"contract","id":"kanban.transition","version":"1","purpose":"卡片列流转（done 等受控流转点挂门禁四件套）","input":"taskId + 目标列；受控列须过 requiredHumanApproval/requiredChecklist/validatorCommand/gateMode","output":"流转后状态；拒绝时带冻结词表原因之一","errors":["approval_required","checklist_incomplete","validator_failed","invalid_transition"],"owner":"hermes-agent（kanban_gates.py；patch 399 挂接）","verdict_carrier":"门禁判定（kanban_gates.py，词表引 metrics.yaml verdicts）"}
{"kind":"contract","id":"delegate_task","version":"1","purpose":"进程内委派子代理执行（goal/context/output_schema 三要素）","input":"goal/context/output_schema/images/group；角色 leaf|orchestrator，工具集继承裁剪","output":"子代理结果 + schema_valid/schema_errors（父代验证+一次纠错重试）","errors":["schema_invalid","depth_exceeded","concurrency_exceeded","subagent_failed"],"owner":"hermes-agent（tools/delegate_tool.py）","verdict_carrier":"output_schema 验证结果（schema_valid 结构化布尔，判定词引 metrics.yaml verdicts）"}
{"kind":"contract","id":"mention.dispatch","version":"1","purpose":"@mention 评论驱动派单（agent/squad/member 三类路由）","input":"评论文本（@agent/@squad/<名>）；单 pending 槽 (workspace,agent) 串行","output":"MentionOutcome（accepted/coalesced/queued/rejected + reason 词表）","errors":["unknown_agent","slot_busy","workspace_denied","engine_unreachable"],"owner":"overlay（custom/server/zcode/mention-dispatch.ts）","verdict_carrier":null}
{"kind":"contract","id":"column.dispatch","version":"2","purpose":"列编排流转触发派发（columns.yaml step 有序执行）","input":"from/to 列 + workspacePath；step(id/role/specialist/provider) 限字符集","output":"ColumnDispatchResult（triggers + outcomes 全量）","errors":["config_invalid","slo_budget_exhausted","engine_unreachable","workspace_denied"],"owner":"overlay（custom/server/kanban/column-dispatch.ts）","verdict_carrier":null}
{"kind":"contract","id":"task.assign","version":"2","purpose":"跨机任务派发协议事件（注册房 message，leader PL50）","input":"taskId/title/body/priority/dueAt/target(account/agentTeam/profile)/issuedBy； v2 增 parentId/capability/phase/dependsOn；admission 未过五问的目标账号告警","output":"房间事件 $event_id；成员侧落地 kanban 建卡","errors":["target_not_declared","room_not_found","admission_incomplete"],"owner":"overlay（matrix-teams 协议；客户端单源 + 服务端镜像对账守门）","verdict_carrier":"task.receipt 状态词表（created/running/waiting-human/done/failed， 终态判定词引 metrics.yaml verdicts）"}
{"kind":"contract","id":"task.receipt","version":"2","purpose":"跨机任务回执协议事件（成员 PL0，同 taskId 最新 reportedAt 幂等覆盖）","input":"taskId/status/localTaskId/reason/reportedBy/reportedAt","output":"房间事件 $event_id；leader 侧外派视图聚合（不做本地镜像）","errors":["task_unknown","stale_receipt"],"owner":"overlay（matrix-teams 协议）","verdict_carrier":"本事件即判定载体（status 词表；终态判定词引 metrics.yaml verdicts）"}
{"kind":"state","id":"triage","object":"task","semantics":"分诊中，未定去留"}
{"kind":"state","id":"todo","object":"task","semantics":"待办，已定做"}
{"kind":"state","id":"scheduled","object":"task","semantics":"已排期"}
{"kind":"state","id":"ready","object":"task","semantics":"就绪可认领"}
{"kind":"state","id":"running","object":"task","semantics":"执行中（有活跃 run）"}
{"kind":"state","id":"blocked","object":"task","semantics":"阻塞（含 dependency_wait）"}
{"kind":"state","id":"review","object":"task","semantics":"待评审（HumanGate 语义挂接点）"}
{"kind":"state","id":"done","object":"task","semantics":"完成（completion_contract 过闸才算，见 metrics task.done）"}
{"kind":"state","id":"archived","object":"task","semantics":"归档（账面留存）"}
{"kind":"transition","id":"run.complete","from":"running","to":"done","trigger":"task_runs.outcome=completed","rules":["completion_contract 四件套（metrics task.done 口径）"],"actions":["kanban.transition"],"evidence":"task_events 流转记录 + task_runs.outcome"}
{"kind":"transition","id":"run.review-request","from":"running","to":"review","trigger":"task_runs.outcome=review_requested","rules":["review 状态门禁 opt-in（gates.json）"],"actions":["kanban.transition"],"evidence":"task_events + 门禁判定"}
{"kind":"transition","id":"run.block","from":"running","to":"blocked","trigger":"task_runs.outcome=blocked|dependency_wait","rules":[],"actions":["kanban.transition"],"evidence":"task_events + run outcome"}
{"kind":"transition","id":"column.enter-review","from":"*","to":"review","trigger":"column_transition（columns.yaml review.entry + 列门禁挂接点）","rules":["requiredHumanApproval","requiredChecklist","validatorCommand","gateMode"],"actions":["kanban.transition","column.dispatch"],"evidence":"task_events + 门禁判定 + 派发结果台账"}
{"kind":"transition","id":"column.enter-done","from":"*","to":"done","trigger":"column_transition（columns.yaml done.exit + done-reporter 步骤）","rules":["done 门禁 opt-in（gates.json）"],"actions":["kanban.transition","column.dispatch"],"evidence":"task_events + 派发结果台账 + completion_contract"}
