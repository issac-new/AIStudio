# 编排域服务端配置（2026-10-31，super-agent 吸收轮）
# 读取点：scripts/serve-server.mjs 启动时注入 process.env（已存在的 shell env 优先）。
# 密钥不写这里：API_SERVER_KEY 由 serve-server.mjs 从 $HERMES_HOME/.env 取同名行。

# 语义评估用的 agent profile（该 profile 必须已配置模型）。
ORCHESTRATOR_EVAL_PROFILE=aiteam-orchestrator

# hermes gateway 的 api_server 地址（config.yaml: platforms.api_server.extra.port）。
ORCHESTRATOR_EVAL_BASE_URL=http://127.0.0.1:8650

# 单次评估的客户端超时（毫秒）。该端点无幂等键，超时不会重发。
ORCHESTRATOR_EVAL_TIMEOUT_MS=120000

# 桥接的看板库（逗号分隔，`~/` 自动展开）。default 板 + 两个命名板。
# 首次接入前须把各板游标设到当前最大 task_events.id，否则会回填历史。
ORCHESTRATOR_KANBAN_DBS=~/.hermes/kanban.db,~/.hermes/kanban/boards/aiteam/kanban.db,~/.hermes/kanban/boards/data/kanban.db

# 编排轮间隔（毫秒）：一轮含 桥接→评估→汇总→投递。0 或缺省=不定时跑，只走 POST /tick。
# 2026-10-31 起取代 ORCHESTRATOR_DELIVER_INTERVAL_MS（投递并入编排轮）。
ORCHESTRATOR_TICK_INTERVAL_MS=60000

# 编排轮里是否做语义评估（设 0 关闭，只桥接与投递）。
ORCHESTRATOR_EVAL_ON_TICK=1

# 每轮最多评估几条（每次评估调一次模型，控制成本）。
ORCHESTRATOR_EVAL_LIMIT=2
