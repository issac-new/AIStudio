    {
      "id": "yuan-self-gates",
      "title": "swarm-yuan 生成器自举门（三档）",
      "scopes": [
        "full"
      ],
      "prepush": "never",
      "run": {
        "argv": [
          "bash",
          "-c",
          "set -e; tmpdir=\"$(mktemp -d)\"; trap 'rm -rf \"$tmpdir\"' EXIT; cp assets/precheck.sh assets/gates-strict.sh assets/gates-warn.sh assets/gates-advisory.sh \"$tmpdir/\"; cp scripts/floor-guard.sh \"$tmpdir/\"; sed \"s|__REPO_ROOT__|${REPO_ROOT}|g\" ci/self-precheck.conf > \"$tmpdir/precheck.conf\"; for mode in --all --all-full --compliance-suite; do echo \"== self-gate $mode\"; bash \"$tmpdir/precheck.sh\" \"$mode\"; done"
        ],
        "cwd": "skills/swarm-yuan",
        "timeoutMs": 900000
      },
      "covers": [],
      "ci": {
        "workflow": "swarm-yuan.yml",
        "anchor": "--compliance-suite"
      }
    },
    {
      "id": "yuan-sweep",
      "title": "swarm-yuan 全量回归（锁测试、e2e、验证器）",
