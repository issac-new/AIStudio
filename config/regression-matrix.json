    {
      "id": "ide-smoke-walkthrough",
      "title": "IDE 工作区浏览器走查（自起 dev server 的全链冒烟）",
      "type": "walkthrough",
      "scopes": [
        "full"
      ],
      "prepush": "never",
      "manual": true,
      "run": {
        "argv": [
          "node",
          "scripts/regression/run-ide-smoke-face.mjs"
