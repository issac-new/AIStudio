{
  "schema_version": 1,
  "note": "回归矩阵：本仓「有哪些测试面、各由哪条命令跑、在哪个关口必须跑」的唯一事实源。新增测试面必须在此登记；scripts/__tests__/regression-matrix.test.ts 守门：仓内发现的测试文件必须能对应到一个测试面，且带 covers 的测试面必须由推送前钩子或 CI 强制执行。",
  "scopes": {
    "prepush": "推送前钩子自动执行。always 面每次推送都跑；paths 面只在变更命中其 paths 时跑。根 vitest 全量不在此档（见 merge）。",
    "merge": "合并到 main 前的人工纪律：npm run regress -- --scope merge。含根 vitest、类型检查、构建与 prepush 的全部面。",
    "full": "发版或全量回归：npm run regress -- --scope full。另含 swarm-yuan 全量、Ycode 工程测试与发布检查。"
  },
  "python": {
    "note": "pytest 面的解释器解析序；全部落空时该面记未执行（退出码 2），不静默跳过。",
    "candidates": [
      {
        "source": "env:AISTUDIO_PYTHON",
        "path": "${AISTUDIO_PYTHON}"
      },
      {
        "source": "hermes-home-venv",
        "path": "${HERMES_HOME}/hermes-agent/.venv/bin/python"
      },
      {
        "source": "default-hermes-venv",
        "path": "${HOME}/.hermes/hermes-agent/.venv/bin/python"
      }
    ],
    "fallback": {
      "source": "path:python3",
      "command": "python3",
      "probe": [
        "-c",
        "import yaml, dotenv"
      ]
    }
  },
  "discovery": {
    "note": "测试文件发现规则。exclude 逐条理由：vendor 与 node_modules 是上游与依赖自带的测试；.claude 是 worktree；dist 与 coverage 是构建产物；team/profiles 与 team/skills 是随 profile 打包的第三方插件，其自带测试不属于本仓测试面；custom/qgate/examples 是门禁框架的黄金场景与演示工程（含故意写错的样例），作为 qgate-persistence 测试的夹具被消费。",
    "patterns": [
      "**/*.test.ts",
      "**/*.test.mts",
      "**/*.test.mjs",
      "**/*.test.sh",
      "**/*.bats",
      "**/test_*.py",
      "**/*_test.py"
    ],
    "exclude": [
      "vendor/**",
      "node_modules/**",
      ".claude/**",
      "dist/**",
      "coverage/**",
      "team/profiles/**",
      "team/skills/**",
      "custom/qgate/examples/**"
    ]
  },
  "axes": [
    {
      "id": "vitest",
      "title": "根 vitest：custom 与 scripts 的守门测试（经 npm test，保留 pretest 的注入确认与 birpc 补丁）",
      "scopes": [
        "merge",
        "full"
      ],
      "prepush": "never",
      "run": {
        "argv": [
          "npm",
          "test"
        ],
        "timeoutMs": 1800000
      },
      "covers": [
        "custom/**/*.test.ts",
        "scripts/**/*.test.ts"
      ],
      "ci": {
        "workflow": "product-tests.yml",
        "anchor": "npx vitest run"
      }
    },
    {
