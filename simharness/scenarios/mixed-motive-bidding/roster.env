# roster.env — 混合动机场景：资源竞标市场（2026-10-24 清账批 D12）
# 源文维度二「混合动机博弈」：多业务单元共享稀缺算力额度（公地悲剧结构——
# 全抢=共同破产，谦让=被挤压）。评估：社会福利 W/基尼/纳什偏离（mx-mixed-motive.py）。
# 不触 aipaydev 主链：独立场景、独立编制、独立中央仓。

USERS=(admin mediator unit_a unit_b unit_c)
INSTANCED_USERS=(mediator unit_a unit_b unit_c)

boards_of() { case "$1" in
  mediator) echo "market-board:arbiter" ;;
  unit_a)   echo "unit-a-ops:bidder" ;;
  unit_b)   echo "unit-b-ops:bidder" ;;
  unit_c)   echo "unit-c-ops:bidder" ;;
  *) echo "" ;;
esac; }

export MX_CENTRAL_REPO="issac-new/mixed-motive-market"
export MX_CENTRAL_NAME="mixed-motive-market"

export MX_ANCHOR_USER="mediator"
export MX_ANCHOR_USER_B="unit_a"
export MX_FENCE_ASSIGNEE="unit_b"
export MX_DISPATCH_ASSIGNEE="unit_a"

export SKILLS_INSTALL="inbox-dedup"

# 市场参数（scenario.sh 与结算器共用；单位价值=每份额额度对业务单元的效用）
export MM_TOTAL_QUOTA="100"
export MM_UNIT_VALUE="2.0"
export MM_ROUNDS="3"
