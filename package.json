{
  "name": "hermes-overlay",
  "version": "0.7.24-overlay-2.33",
  "private": true,
  "type": "module",
  "description": "二次开发 overlay 层:注入到 hermes-studio 上游",
  "scripts": {
    "inject": "node scripts/inject.mjs",
    "clean": "node scripts/inject.mjs --clean",
    "serve": "node scripts/serve-server.mjs",
    "verify": "node scripts/verify-clean.mjs",
    "sync": "bash scripts/sync-upstream.sh",
    "ensure-injected": "node scripts/ensure-injected.mjs",
    "build": "vite build --config vite.config.overlay.ts",
    "prebuild": "node scripts/ensure-injected.mjs",
    "dev": "cross-env HERMES_WEB_UI_BACKEND_PORT=8647 vite --config vite.config.overlay.ts --port 8649 --strictPort",
    "dev:lan": "cross-env HERMES_WEB_UI_BACKEND_PORT=8647 vite --config vite.config.overlay.ts --host --port 8649 --strictPort",
    "//dev:lan": "多实例演练用：--host 全网卡监听。devAutoLogin（registries/client/entry.mts）会以 admin/123456 免密换 JWT，同网段任意设备访问 :8649 即得 super_admin 会话——仅限可信局域网；日常开发用 npm run dev（只绑 localhost）",
    "predev": "node scripts/ensure-injected.mjs",
    "test": "vitest run",
    "build:full": "node scripts/build.mjs",
    "build:dmg": "node scripts/build-dmg.mjs",
    "build:dmg:mac": "node scripts/build-dmg.mjs --mac",
    "build:dmg:win": "node scripts/build-dmg.mjs --win",
    "build:dmg:linux": "node scripts/build-dmg.mjs --linux",
    "catalog-check": "node scripts/zcode-catalog-check.mjs",
    "runtime:doctor": "node scripts/runtime/runtime-doctor.mjs",
    "runtime:vendor-pua": "node scripts/runtime/vendor-pua.mjs",
    "runtime:register": "node scripts/runtime/register-runtime.mjs",
    "zcode:ensure": "node scripts/zcode-engine.mjs ensure",
    "zcode:serve": "node scripts/zcode-engine.mjs serve"
  },
  "engines": {
    "node": ">=23.0.0"
  }
}
