<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.workspace-auto-push</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>~/.hermes/skills/devops/encrypted-git-backup/templates/auto-push.sh</string>
        <string>~/hermes-docker-sandbox/workspace</string>
        <string>main</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>~/.hermes/logs/auto-push-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>~/.hermes/logs/auto-push-launchd.log</string>
</dict>
</plist>
