+  // 我们的 {apps:[...]} 包裹在信封层摊平，避免 SDK inventory() 解析成 []。
+  if ((method === "list_apps" || method === "list_applications") && result && typeof result === "object" && Array.isArray(result.apps)) {
+    return { content: [{ type: "text", text: JSON.stringify(result.apps) }], isError: false };
+  }
+  if (method === "screenshot" && result && typeof result === "object" && result.data) {
+    return {
+      content: [
+        { type: "image", data: result.data, mimeType: result.mediaType ?? "image/png" },
+        { type: "text", text: `Captured ${result.bytes} bytes PNG.` },
+      ],
+      isError: false,
+    };
+  }
+  return { content: [{ type: "text", text: JSON.stringify(result ?? { ok: true }) }], isError: false };
+}
