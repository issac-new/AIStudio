+    },
+
+    async get_app_state() {
+      requirePlatform();
+      if (mac) {
+        const script = [
+          'ObjC.import("AppKit")',
+          "var ws = $.NSWorkspace.sharedWorkspace",
+          "var front = ws.frontmostApplication",
+          "function s(v){ return v === null || v === undefined ? null : String(ObjC.unwrap(v)) }",
+          "JSON.stringify({ app: s(front.localizedName), pid: Number(front.processIdentifier), bundleId: s(front.bundleIdentifier) })",
+        ].join("\n");
+        const out = await macAssertOk(await jxa(script), "get_app_state");
+        return JSON.parse(out);
+      }
+      if (win) {
+        const ps = "Add-Type -TypeDefinition 'using System;using System.Runtime.InteropServices;public class W{[DllImport(\"user32.dll\")]public static extern IntPtr GetForegroundWindow();[DllImport(\"user32.dll\")]public static extern uint GetWindowThreadProcessId(IntPtr h,out uint p);}';$h=[W]::GetForegroundWindow();$p=0;[W]::GetWindowThreadProcessId($h,[ref]$p)|Out-Null;$proc=Get-Process -Id $p;Write-Output ('{\"app\":\"'+$proc.ProcessName+'\",\"pid\":'+$p+'}')";
