+
+/** 工具调用 → broker 方法与参数（method=null 且非 unsupported = 本地应答）。 */
+export function planToolCall(name, input) {
+  const tool = findTool(name);
+  if (!tool) return { error: `unknown tool: ${name}` };
+  if (tool.unsupported === true) {
+    return { error: `${name} is not supported by the node backend: ${tool.description}` };
+  }
+  if (tool.method === null) {
+    return { local: { acknowledged: true, tool: name } };
+  }
+  const params = typeof tool.transform === "function" ? tool.transform(input ?? {}) : (input ?? {});
+  return { method: tool.method, params };
+}
