+#!/usr/bin/env node
+// @zcode/zcode-cua MCP 服务器（stdio，JSON-RPC 2.0 行式 = MCP 传输默认）。
+// 以 CLI 配置名 "computer-use" 注册（isGlobalCliZCodeCuaServer 短路识别该名），
+// 经环境变量 ZCODE_CUA_PERMISSION_BROKER_SOCKET 连接宿主 broker。
+// 运行形态：宿主（desktop/services）在注册本服务器时以 process.execPath +
+// ELECTRON_RUN_AS_NODE=1 启动（不依赖系统 node）。
+import { createInterface } from "node:readline";
+import { BROKER_SOCKET_ENV, callBrokerMethod } from "./broker.js";
+import { createNodeAutomationBackend } from "./node-backend.js";
+import { CUA_TOOLS, planToolCall } from "./tool-map.js";
+
+// 自包含模式：无 BROKER_SOCKET_ENV 时内置直调后端（不经 socket——CLI 直接
+// spawn 本服务器即可用，宿主/桌面注入链缺席时不挡路）。宿主注入优先。
+let embeddedBackend = null;
+function getEmbeddedBackend() {
+  if (embeddedBackend === null) embeddedBackend = createNodeAutomationBackend();
+  return embeddedBackend;
+}
+
+const SERVER_INFO = { name: "zcode-cua", version: "0.6.3-overlay" };
+const PROTOCOL_VERSION = "2024-11-05";
+
+function socketPath() {
+  const value = process.env[BROKER_SOCKET_ENV];
+  if (typeof value !== "string" || !value.trim()) return null;
+  return value.trim();
+}
+
+function writeMessage(msg) {
+  process.stdout.write(`${JSON.stringify(msg)}\n`);
+}
+
+function rpcError(id, code, message) {
+  writeMessage({ jsonrpc: "2.0", id: id ?? null, error: { code, message } });
+}
+
+async function callTool(name, input) {
+  const plan = planToolCall(name, input);
+  if (plan.error) return { content: [{ type: "text", text: plan.error }], isError: true };
+  if (plan.local) return { content: [{ type: "text", text: JSON.stringify(plan.local) }], isError: false };
+  try {
+    const sock = socketPath();
+    const result = sock
+      ? await callBrokerMethod({ socketPath: sock, method: plan.method, params: plan.params, timeoutMs: 30_000 })
+      : await getEmbeddedBackend()[plan.method](plan.params ?? {});
+    if (plan.method === "screenshot" && result && typeof result === "object" && result.data) {
+      const text = `Captured ${result.bytes} bytes PNG${plan.params?.region ? ` (region ${plan.params.region.width}x${plan.params.region.height} @ ${plan.params.region.x},${plan.params.region.y})` : ""}.`;
+      return {
+        content: [
+          { type: "image", data: result.data, mimeType: result.mediaType ?? "image/png" },
+          { type: "text", text },
+        ],
+        isError: false,
+      };
+    }
+    return { content: [{ type: "text", text: JSON.stringify(result) }], isError: false };
+  } catch (err) {
+    const message = err instanceof Error ? err.message : String(err);
+    const hint = /denied|accessibility|screen/i.test(message)
+      ? " Hint: grant Accessibility (input) and Screen Recording (capture) permissions to the host app in OS settings, then retry request_access."
+      : "";
+    return { content: [{ type: "text", text: `${plan.method} failed: ${message}${hint}` }], isError: true };
+  }
+}
+
+async function handleMessage(msg) {
+  const method = msg?.method;
+  const id = msg?.id ?? null;
+  if (method === "initialize") {
+    writeMessage({
+      jsonrpc: "2.0", id,
+      result: {
+        protocolVersion: PROTOCOL_VERSION,
+        capabilities: { tools: {} },
+        serverInfo: SERVER_INFO,
+      },
+    });
+    return;
+  }
+  if (method === "notifications/initialized" || method === "notifications/cancelled") return;
+  if (method === "ping") {
+    writeMessage({ jsonrpc: "2.0", id, result: {} });
+    return;
+  }
+  if (method === "tools/list") {
+    writeMessage({
+      jsonrpc: "2.0", id,
+      result: {
+        tools: CUA_TOOLS.map((t) => ({ name: t.name, description: t.description, inputSchema: t.inputSchema })),
+      },
+    });
+    return;
+  }
+  if (method === "tools/call") {
+    const name = msg?.params?.name;
+    const input = msg?.params?.arguments ?? {};
+    const result = await callTool(String(name ?? ""), input);
+    writeMessage({ jsonrpc: "2.0", id, result });
+    return;
+  }
+  if (id !== null) rpcError(id, -32601, `method not found: ${method}`);
+}
+
+const rl = createInterface({ input: process.stdin });
+rl.on("line", (line) => {
+  const trimmed = line.trim();
+  if (!trimmed) return;
+  let msg;
+  try {
+    msg = JSON.parse(trimmed);
+  } catch {
+    return;
+  }
+  void handleMessage(msg).catch((err) => {
+    if (msg?.id != null) rpcError(msg.id, -32603, err instanceof Error ? err.message : String(err));
+  });
+});
+process.stdin.on("end", () => process.exit(0));
