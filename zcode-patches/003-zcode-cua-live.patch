+        events.push({ type: "up", x: x ?? 0, y: y ?? 0, button });
+        await macAssertOk(await jxa(macPointScript(events)), "click");
+        return { ok: true };
+      }
+      if (win) {
+        const t = button === 2 ? "rclick" : "click";
