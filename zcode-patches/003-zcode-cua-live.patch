+function connectOnce(socketPath, timeoutMs) {
+  return new Promise((resolveConn, rejectConn) => {
+    const socket = createConnection(socketPath);
+    const done = (err, s) => {
+      socket.removeAllListeners();
+      err ? rejectConn(err) : resolveConn(s);
+    };
+    socket.once("connect", () => done(null, socket));
+    socket.once("error", (err) => done(err));
+    const timer = setTimeout(() => done(new Error("broker connect timeout")), timeoutMs);
+    timer.unref?.();
+    socket.once("connect", () => clearTimeout(timer));
+    socket.once("error", () => clearTimeout(timer));
+  });
+}
