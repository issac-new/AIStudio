+        if (res.code !== 0) throw new Error("type_text failed");
+        return { ok: true };
+      }
+      const cmd = await linuxInputCmd();
+      if (!cmd) throw new Error("no linux input tool (xdotool/ydotool)");
+      const res = await runner(cmd, ["type", "--", text], { timeoutMs: RUN_TIMEOUT_INPUT_MS + text.length * 20 });
+      if (res.code !== 0) throw new Error(`type_text failed: ${(res.stderr || "").slice(0, 200)}`);
+      return { ok: true };
+    },
+
+    async key(params = {}) {
+      requirePlatform();
+      const combo = boundedText(params.key ?? params.combo, 100);
+      if (mac) {
