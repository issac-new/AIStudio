+      }
+      if (win) {
+        const ps = [
+          "Add-Type -AssemblyName System.Windows.Forms",
+          `[System.Windows.Forms.SendKeys]::SendWait('${text.replace(/(['{}[\]()+%^~])/g, "{$1}")}')`,
