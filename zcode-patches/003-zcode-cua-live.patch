+        } finally {
+          if (hadClipboard) {
+            const child = spawn("pbcopy", [], { stdio: ["pipe", "ignore", "ignore"] });
+            child.stdin.on("error", () => {});
+            child.stdin.end(saved.stdout, "utf8");
+          }
+        }
