+        const res = await runner("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", winSendInputPs(payload)], { timeoutMs: RUN_TIMEOUT_INPUT_MS });
+        if (res.code !== 0) throw new Error("click failed");
+        return { ok: true };
+      }
+      const cmd = await linuxInputCmd();
+      if (!cmd) throw new Error("no linux input tool (xdotool/ydotool)");
+      const btn = button === 2 ? "3" : "1";
+      const args = cmd === "ydotool" ? ["click", btn] : ["click", btn];
+      const res = await runner(cmd, args, { timeoutMs: RUN_TIMEOUT_INPUT_MS });
+      if (res.code !== 0) throw new Error(`click failed: ${(res.stderr || "").slice(0, 200)}`);
+      return { ok: true };
+    },
+
+    async left_click(params = {}) { return backend._click(params, 0); },
+    async right_click(params = {}) { return backend._click(params, 2); },
+
+    async double_click(params = {}) {
+      requirePlatform();
+      const x = params.x != null ? intCoord(params.x, "x") : null;
+      const y = params.y != null ? intCoord(params.y, "y") : null;
+      if (mac) {
+        const events = [];
+        if (x != null && y != null) events.push({ type: "move", x, y });
+        for (let i = 0; i < 2; i++) {
+          events.push({ type: "down", x: x ?? 0, y: y ?? 0, button: 0 });
+          events.push({ type: "up", x: x ?? 0, y: y ?? 0, button: 0 });
+        }
+        await macAssertOk(await jxa(macPointScript(events)), "double_click");
+        return { ok: true };
+      }
+      if (win) {
+        const res = await runner("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", winSendInputPs([{ t: "dclick", ...(x != null ? { x, y } : {}) }])], { timeoutMs: RUN_TIMEOUT_INPUT_MS });
+        if (res.code !== 0) throw new Error("double_click failed");
+        return { ok: true };
+      }
+      const cmd = await linuxInputCmd();
+      if (!cmd) throw new Error("no linux input tool (xdotool/ydotool)");
+      const args = cmd === "ydotool" ? ["click", "-r", "2", "1"] : ["click", "--repeat", "2", "--delay", "80", "1"];
+      const res = await runner(cmd, args, { timeoutMs: RUN_TIMEOUT_INPUT_MS });
+      if (res.code !== 0) throw new Error(`double_click failed`);
+      return { ok: true };
+    },
+
+    async drag(params = {}) {
+      requirePlatform();
+      const fromX = intCoord(params.fromX ?? params.x, "fromX");
+      const fromY = intCoord(params.fromY ?? params.y, "fromY");
+      const toX = intCoord(params.toX, "toX");
+      const toY = intCoord(params.toY, "toY");
+      if (mac) {
+        const script = [
+          'ObjC.import("CoreGraphics")',
+          `$.CGEventPost(0, $.CGEventCreateMouseEvent(null, 5, $.CGPointMake(${fromX}, ${fromY}), 0));`,
+          `$.CGEventPost(0, $.CGEventCreateMouseEvent(null, 1, $.CGPointMake(${fromX}, ${fromY}), 0));`,
+          `$.CGEventPost(0, $.CGEventCreateMouseEvent(null, 6, $.CGPointMake(${toX}, ${toY}), 0));`,
+          `$.CGEventPost(0, $.CGEventCreateMouseEvent(null, 2, $.CGPointMake(${toX}, ${toY}), 0));`,
+          '"ok"',
+        ].join("\n");
+        await macAssertOk(await jxa(script), "drag");
+        return { ok: true };
+      }
+      if (win) {
+        const ps = [
+          "Add-Type -TypeDefinition 'using System;using System.Runtime.InteropServices;public class D{[DllImport(\"user32.dll\")]public static extern bool SetCursorPos(int x,int y);[DllImport(\"user32.dll\")]public static extern void mouse_event(uint f,uint dx,uint dy,uint d,IntPtr e);}';",
+          `[D]::SetCursorPos(${fromX},${fromY})|Out-Null;[D]::mouse_event(2,0,0,0,[IntPtr]::Zero);Start-Sleep -Milliseconds 60;[D]::SetCursorPos(${toX},${toY})|Out-Null;Start-Sleep -Milliseconds 60;[D]::mouse_event(4,0,0,0,[IntPtr]::Zero);Write-Output ok`,
+        ].join("\n");
+        const res = await runner("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", ps], { timeoutMs: RUN_TIMEOUT_INPUT_MS });
+        if (res.code !== 0) throw new Error("drag failed");
+        return { ok: true };
+      }
+      const cmd = await linuxInputCmd();
+      if (!cmd) throw new Error("no linux input tool (xdotool/ydotool)");
+      if (cmd !== "xdotool") throw new Error("drag on wayland (ydotool) not supported");
+      const script = `mousemove ${fromX} ${fromY} mousedown 1 mousemove ${toX} ${toY} mouseup 1`;
+      const res = await runner("xdotool", script.split(" "), { timeoutMs: RUN_TIMEOUT_INPUT_MS });
+      if (res.code !== 0) throw new Error("drag failed");
+      return { ok: true };
+    },
+
+    async scroll(params = {}) {
+      requirePlatform();
+      const deltaX = params.deltaX != null ? intCoord(params.deltaX, "deltaX") : 0;
+      const deltaY = params.deltaY != null ? intCoord(params.deltaY, "deltaY") : 0;
+      if (deltaX === 0 && deltaY === 0) throw new Error("deltaX/deltaY at least one non-zero");
+      if (mac) {
+        const events = [];
+        const steps = Math.min(10, Math.max(1, Math.ceil(Math.abs(deltaY || deltaX) / 120)));
+        for (let i = 0; i < steps; i++) {
+          events.push({ type: "scroll", deltaX: Math.round(deltaX / steps), deltaY: Math.round(deltaY / steps) });
+        }
+        await macAssertOk(await jxa(macPointScript(events)), "scroll");
+        return { ok: true };
+      }
+      if (win) {
+        const notches = Math.round((deltaY || deltaX) / 120);
