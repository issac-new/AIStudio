+      }) };
+    },
+
+    async open_application(params = {}) {
+      requirePlatform();
+      const app = typeof params.app === "string" ? params.app.trim().slice(0, 500) : "";
+      const url = typeof params.url === "string" ? params.url.trim().slice(0, 2000) : "";
+      const path = typeof params.path === "string" ? params.path.trim().slice(0, 2000) : "";
+      if (!app && !url && !path) throw new Error("app/url/path is required");
+      if (mac) {
+        const args = [];
+        if (app) args.push("-a", app);
+        if (path) args.push(path);
+        if (url) args.push(url);
+        const res = await runner("open", args, { timeoutMs: 10_000 });
+        if (res.code !== 0) throw new Error(`open failed: ${(res.stderr || "").slice(0, 200)}`);
+        return { ok: true };
+      }
+      if (win) {
+        const target = app || url || path;
