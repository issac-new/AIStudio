+  if (!socketPath || !method) throw new Error("socketPath and method are required");
+  const socket = await connectOnce(socketPath, Math.min(timeoutMs, 5_000));
+  try {
+    return await new Promise((resolveCall, rejectCall) => {
+      let buffer = "";
+      const timer = setTimeout(() => {
+        cleanup();
+        rejectCall(new Error(`broker method ${method} timeout (${timeoutMs}ms)`));
