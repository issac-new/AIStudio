+      }
+      const res = await runner("sh", ["-c", "xdotool getactivewindow getwindowpid getwindowname 2>/dev/null || true"], { timeoutMs: 5_000 });
+      const parts = res.stdout.trim().split("\n");
+      if (parts.length < 2 || !parts[0]) return { app: null, note: "xdotool unavailable" };
+      return { windowId: parts[0], pid: Number(parts[1]), title: parts.slice(2).join(" ") };
+    },
+
+    async mouse_move(params = {}) {
+      requirePlatform();
+      const x = intCoord(params.x, "x");
+      const y = intCoord(params.y, "y");
+      if (mac) {
+        await macAssertOk(await jxa(macPointScript([{ type: "move", x, y }])), "mouse_move");
+        return { ok: true, x, y };
+      }
+      if (win) {
+        const res = await runner("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", winSendInputPs([{ t: "move", x, y }])], { timeoutMs: RUN_TIMEOUT_INPUT_MS });
+        if (res.code !== 0) throw new Error("mouse_move failed");
+        return { ok: true, x, y };
+      }
+      const cmd = await linuxInputCmd();
+      if (!cmd) throw new Error("no linux input tool (xdotool/ydotool)");
+      const args = cmd === "ydotool" ? ["mousemove", "-a", String(x), String(y)] : ["mousemove", String(x), String(y)];
+      const res = await runner(cmd, args, { timeoutMs: RUN_TIMEOUT_INPUT_MS });
+      if (res.code !== 0) throw new Error(`mouse_move failed: ${(res.stderr || "").slice(0, 200)}`);
+      return { ok: true, x, y };
+    },
+
+    async _click(params, button) {
+      requirePlatform();
+      const x = params.x != null ? intCoord(params.x, "x") : null;
+      const y = params.y != null ? intCoord(params.y, "y") : null;
+      if (mac) {
+        const events = [];
+        if (x != null && y != null) events.push({ type: "move", x, y });
