+// @zcode/zcode-cua Node 跨平台自动化后端（overlay 补丁件，2026-09-29）。
+//
+// 定位：产品 Helper（原生 addon，tools/cua-helper 产物）缺席时的等价后端——
+// 实现同一 broker 方法面，输入/截屏/应用枚举全部走各平台自带通道：
+//   macOS   截屏 screencapture CLI；输入 JXA CGEvent（CoreGraphics 桥，本机实证）
+//   Windows 截屏 PowerShell System.Drawing；输入 user32 SendInput（Add-Type P/Invoke）
+//   Linux   截屏 maim/scrot/import/gnome-screenshot 链；输入 xdotool(X11)/ydotool(Wayland)
+// 安全边界：所有外部命令固定参数数组 spawn（零 shell 拼接）、统一超时、输出上限、
+// 未知方法显式报错（不静默成功）。权限语义 fail-closed：探测失败如实报 denied/unknown。
+import { spawn } from "node:child_process";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+const RUN_TIMEOUT_MS = 15_000;
+const RUN_TIMEOUT_INPUT_MS = 5_000;
+const OUTPUT_CAP = 4 * 1024 * 1024;
+
+/** 固定参数执行器：零 shell、超时杀、输出上限。返回 {code, stdout}。 */
+export function runCommand(cmd, args, options = {}) {
+  const timeout = options.timeoutMs ?? RUN_TIMEOUT_MS;
+  return new Promise((resolveRun) => {
+    let child;
+    try {
+      child = spawn(cmd, args, { stdio: ["ignore", "pipe", "pipe"], ...options.spawnOptions });
+    } catch (err) {
+      resolveRun({ code: -1, stdout: "", stderr: String(err?.message ?? err) });
+      return;
+    }
+    let out = "";
+    let errOut = "";
+    let capped = false;
+    child.stdout?.on("data", (d) => {
+      if (out.length < OUTPUT_CAP) out += String(d);
+      else capped = true;
+    });
+    child.stderr?.on("data", (d) => {
+      if (errOut.length < 64 * 1024) errOut += String(d);
+    });
+    const timer = setTimeout(() => {
+      try { child.kill("SIGKILL"); } catch { /* 已退 */ }
+    }, timeout);
+    timer.unref?.();
+    child.on("error", (err) => {
+      clearTimeout(timer);
+      resolveRun({ code: -1, stdout: out, stderr: err.message });
+    });
+    child.on("close", (code) => {
+      clearTimeout(timer);
+      resolveRun({ code: code ?? -1, stdout: capped ? out.slice(0, OUTPUT_CAP) : out, stderr: errOut });
+    });
+  });
+}
+
+/** JXA 执行（macOS）：脚本经 stdin 传入（不经 argv——参数注入面归零）。 */
+async function runJxaStdin(script) {
+  return await new Promise((resolveRun) => {
+    let child;
+    try {
+      child = spawn("osascript", ["-l", "JavaScript", "-"], { stdio: ["pipe", "pipe", "pipe"] });
+    } catch (err) {
+      resolveRun({ code: -1, stdout: "", stderr: String(err?.message ?? err) });
+      return;
+    }
+    let out = "";
+    let errOut = "";
+    child.stdout.on("data", (d) => { if (out.length < OUTPUT_CAP) out += String(d); });
+    child.stderr.on("data", (d) => { if (errOut.length < 64 * 1024) errOut += String(d); });
+    const timer = setTimeout(() => { try { child.kill("SIGKILL"); } catch { /* 已退 */ } }, RUN_TIMEOUT_INPUT_MS);
+    timer.unref?.();
+    child.on("error", (err) => { clearTimeout(timer); resolveRun({ code: -1, stdout: out, stderr: err.message }); });
+    child.on("close", (code) => { clearTimeout(timer); resolveRun({ code: code ?? -1, stdout: out, stderr: errOut }); });
+    child.stdin.on("error", () => { /* EPIPE：进程已退出 */ });
+    child.stdin.end(script);
+  });
+}
+
+// ── macOS 输入合成（JXA CGEvent，本机实证 2026-09-29）──
+
+const MAC_KEYCODES = {
+  a: 0, s: 1, d: 2, f: 3, h: 4, g: 5, z: 6, x: 7, c: 8, v: 9, b: 11, q: 12, w: 13,
+  e: 14, r: 15, y: 16, t: 17, '1': 18, '2': 19, '3': 20, '4': 21, '6': 22, '5': 23,
+  '=': 24, '9': 25, '7': 26, '-': 27, '8': 28, '0': 29, ']': 30, o: 31, u: 32, '[': 33,
+  i: 34, p: 35, return: 36, l: 37, n: 38, m: 39, tab: 48, ' ': 49, '`': 50,
+  backspace: 51, escape: 53, f1: 122, f2: 120, f3: 99, f4: 118, f5: 96, f6: 97,
+  f7: 98, f8: 100, f9: 101, f10: 109, f11: 103, f12: 111,
+  right: 124, down: 125, left: 123, up: 126, home: 115, end: 119, pageup: 116,
+  pagedown: 121, delete: 117,
+};
+const MAC_FLAGS = { cmd: 1 << 20, shift: 1 << 17, alt: 1 << 19, ctrl: 1 << 18, meta: 1 << 20, control: 1 << 18, option: 1 << 19 };
+
+function macKeyScript(combo, down) {
+  const parts = String(combo).split("+").map((p) => p.trim().toLowerCase()).filter(Boolean);
+  if (parts.length === 0) throw new Error("key combo is empty");
+  const main = parts[parts.length - 1];
+  const modifiers = parts.slice(0, -1);
+  const keycode = MAC_KEYCODES[main];
+  if (keycode === undefined) throw new Error(`unsupported mac key: ${main}`);
+  let flags = 0;
+  for (const m of modifiers) {
+    const f = MAC_FLAGS[m];
+    if (f === undefined) throw new Error(`unsupported mac modifier: ${m}`);
+    flags |= f;
+  }
+  const state = down ? "true" : "false";
+  return [
+    'ObjC.import("CoreGraphics")',
+    flags > 0
+      ? `var f = $.CGEventCreateKeyboardEvent(null, ${keycode}, ${state}); $.CGEventSetFlags(f, ${flags}); $.CGEventPost(0, f);`
+      : `$.CGEventPost(0, $.CGEventCreateKeyboardEvent(null, ${keycode}, ${state}));`,
+    '"ok"',
+  ].join("\n");
+}
+
+function macPointScript(events) {
+  // events: Array<{type:'move'|'down'|'up'|'scroll', x, y, button?, deltaX?, deltaY?}>
+  const lines = ['ObjC.import("CoreGraphics")'];
+  for (const ev of events) {
+    if (ev.type === "move") {
+      lines.push(`$.CGEventPost(0, $.CGEventCreateMouseEvent(null, 5, $.CGPointMake(${ev.x}, ${ev.y}), 0));`);
+    } else if (ev.type === "down" || ev.type === "up") {
+      // kCGEventLeftMouseDown=1, LeftMouseUp=2, RightMouseDown=25, RightMouseUp=26
+      const t = ev.type === "down" ? (ev.button === 2 ? 25 : 1) : (ev.button === 2 ? 26 : 2);
+      lines.push(`$.CGEventPost(0, $.CGEventCreateMouseEvent(null, ${t}, $.CGPointMake(${ev.x}, ${ev.y}), ${ev.button === 2 ? 2 : 0}));`);
+    } else if (ev.type === "scroll") {
+      lines.push(`$.CGEventPost(0, $.CGEventCreateScrollWheelEvent(null, 0, 2, ${ev.deltaY ?? 0}, ${ev.deltaX ?? 0}));`);
+    }
+  }
+  lines.push('"ok"');
+  return lines.join("\n");
+}
+
+function macTypeScript(text) {
+  const escaped = JSON.stringify(String(text).slice(0, 4000));
+  return [
+    'ObjC.import("CoreGraphics")',
+    `var s = ${escaped}`,
+    "var down = $.CGEventCreateKeyboardEvent(null, 0, true)",
+    "$.CGEventKeyboardSetUnicodeString(down, s.length, s)",
+    "var up = $.CGEventCreateKeyboardEvent(null, 0, false)",
+    "$.CGEventKeyboardSetUnicodeString(up, s.length, s)",
+    "$.CGEventPost(0, down); $.CGEventPost(0, up)",
+    '"ok"',
+  ].join("\n");
+}
+
+// ── Windows（PowerShell SendInput/SetCursorPos/System.Drawing）──
+
+const WIN_PS_KEY = {
+  ctrl: 0x11, shift: 0x10, alt: 0x12, enter: 0x0d, tab: 0x09, esc: 0x1b,
+  backspace: 0x08, space: 0x20, delete: 0x2e, up: 0x26, down: 0x28, left: 0x25, right: 0x27,
+  home: 0x24, end: 0x23, pageup: 0x21, pagedown: 0x22,
+};
+
+function winSendInputPs(events) {
+  // 紧凑 SendInput P/Invoke 片段；events 为鼠标/键盘事件数组
+  const json = JSON.stringify(events).replace(/'/g, "''");
+  const script = [
+    "Add-Type -TypeDefinition 'using System;using System.Runtime.InteropServices;public class U{",
+    "[DllImport(\"user32.dll\")]public static extern uint SendInput(uint n,INPUT[] i,int s);",
+    "[DllImport(\"user32.dll\")]public static extern bool SetCursorPos(int x,int y);",
+    "[StructLayout(LayoutKind.Sequential)]public struct INPUT{public int type;public MOUSEDATA m;}",
+    "[StructLayout(LayoutKind.Sequential)]public struct MOUSEDATA{public int dx,dy,mouseData,dwFlags,time;public IntPtr extra;}",
+    "public const int M=0,K=1;'}'",
+    `$e = '${json}' | ConvertFrom-Json`,
+    "foreach($ev in $e){",
+    "  if($ev.t -eq 'move'){[U]::SetCursorPos([int]$ev.x,[int]$ev.y)|Out-Null}",
+    "  elseif($ev.t -eq 'click' -or $ev.t -eq 'rclick' -or $ev.t -eq 'dclick'){",
+    "    $btn = if($ev.t -eq 'rclick'){6,4,2}else{2,4,8}; $n = if($ev.t -eq 'dclick'){2}else{1}",
+    "    if($ev.x -ne $null){[U]::SetCursorPos([int]$ev.x,[int]$ev.y)|Out-Null}",
+    "    for($i=0;$i -lt $n;$i++){foreach($f in $btn){$inp=@(New-Object U+INPUT);$inp[0].type=0;$inp[0].m.dwFlags=$f;[U]::SendInput(1,$inp,[Runtime.InteropServices.Marshal]::SizeOf([type][U+INPUT]))|Out-Null}}",
+    "  }",
+    "}",
+    "Write-Output ok",
+  ].join("\n");
+  return script;
+}
+
+// ── Linux 探测与实现 ──
+
+async function firstAvailableCmd(candidates, runner = runCommand) {
+  for (const c of candidates) {
+    const res = await runner("sh", ["-c", `command -v ${JSON.stringify(c)}`], { timeoutMs: 2_000 });
+    if (res.code === 0 && res.stdout.trim()) return c;
+  }
+  return null;
+}
+
+
+// ── 参数清洗 ──
+
+function intCoord(value, name) {
+  const n = Number(value);
+  if (!Number.isFinite(n) || !Number.isSafeInteger(Math.round(n)) || Math.abs(n) > 100_000) {
+    throw new Error(`${name} must be a bounded integer coordinate`);
+  }
+  return Math.round(n);
+}
+
+function boundedText(value, max = 4000) {
+  if (typeof value !== "string" || value.length === 0) throw new Error("text is required");
+  if (value.length > max) throw new Error(`text exceeds ${max} chars`);
+  return value;
+}
+
+/**
