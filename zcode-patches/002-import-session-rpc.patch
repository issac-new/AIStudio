index 000000000..857bcf736
--- /dev/null
+++ b/packages/shared/test/taskMigrationSource.regression-1.test.ts
@@ -0,0 +1,59 @@
+import { describe, expect, it } from "vitest";
+import { workspaceTaskListInvalidatedEventSchema } from "../src/task-realtime-core.js";
+import { zcodeSessionImportHistorySchema } from "../src/zcode-protocol/index.js";
+import { zcodeTaskMetaSchema } from "../src/validation.js";
+
+// Regression: ISSUE-001 — 多源导入在持久化 schema 通过后被 realtime schema 拒绝
+// Found by /qa on 2026-11-22
+// Report: .gstack/qa-reports/run-20261122T133641Z/qa-report-aistudio-2026-11-22.md
+function taskMeta(migrationSource: "claudeCode" | "codex" | "kimi") {
+  return {
+    taskId: `import-${migrationSource}-1`,
+    traceId: `trace-import-${migrationSource}-1`,
+    title: `[imported:${migrationSource}] fixture`,
+    workspacePath: "/tmp/ycode-import-fixture",
+    createdAt: 100,
+    updatedAt: 200,
+    mode: "build" as const,
+    migrationSource,
+  };
+}
+
+describe("多源导入的 task realtime 投影", () => {
+  it.each(["claudeCode", "codex", "kimi"] as const)(
+    "持久化与 realtime schema 均接受 %s",
+    (migrationSource) => {
+      const meta = taskMeta(migrationSource);
+      expect(zcodeTaskMetaSchema.parse(meta).migrationSource).toBe(migrationSource);
+      const event = workspaceTaskListInvalidatedEventSchema.parse({
+        eventId: `event-${migrationSource}`,
+        workspacePath: meta.workspacePath,
+        workspaceKey: meta.workspacePath,
+        traceId: meta.traceId,
+        createdAt: 201,
+        reason: "task_created",
+        type: "workspace_task_list_invalidated",
+        taskId: meta.taskId,
+        taskMeta: meta,
+      });
+      expect(event.taskMeta?.migrationSource).toBe(migrationSource);
+    },
+  );
+
+  it("仍拒绝词表外的迁移来源", () => {
+    const meta = { ...taskMeta("codex"), migrationSource: "unknown-source" };
+    expect(zcodeTaskMetaSchema.safeParse(meta).success).toBe(false);
+  });
+
+  it.each(["claudeCode", "codex", "kimi"] as const)(
+    "createSession importedHistory 接受 %s",
+    (source) => {
+      const history = zcodeSessionImportHistorySchema.parse({
+        source,
+        title: `[imported:${source}] fixture`,
+        messages: [{ role: "user", content: "fixture", timestamp: 100 }],
+      });
+      expect(history.source).toBe(source);
+    },
+  );
+});
