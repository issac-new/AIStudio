+    // overlay 002-import-session-rpc（#22 多源导入写入面）：归一化行 → imported
+    // snapshot（claude-native persist 泛化；migrationSource 扩 codex/kimi）。
+    // tool 行并入 assistant（persisted 消息 role 仅 user/assistant，"[tool]" 前缀保留来源语义）。
+    async importSessionV4(params: V4ImportSessionParams) {
+      const { randomUUID } = await import("node:crypto");
+      const { TaskIndexRepo } = await import("../session/taskIndexRepo.js");
+      const { persistImportedClaudeTask } = await import(
+        "../session/claude-native/persistImportedClaudeTask.js"
+      );
+      if (params.rows.length === 0) {
+        throw new Error("fault.importSession.noRows");
+      }
+      const sessionId = `import-${params.source}-${randomUUID().slice(0, 8)}`;
+      const firstAt = params.rows[0]?.at ?? Date.now();
+      const lastAt = params.rows[params.rows.length - 1]?.at ?? firstAt;
+      const meta = {
+        taskId: sessionId,
+        traceId: `trace-${sessionId}`,
+        title: `[imported:${params.source}] ${params.sourceId.slice(0, 60)}`,
+        workspacePath: params.workspacePath,
+        createdAt: Math.floor(firstAt),
+        updatedAt: Math.floor(lastAt),
+        mode: "build" as const,
+        migrationSource: params.source,
+        status: "completed" as const,
+      };
+      const messages = params.rows.map((r, i) => ({
+        id: `${sessionId}-${i}`,
+        role: r.role === "user" ? ("user" as const) : ("assistant" as const),
+        content: r.role === "tool" ? `[tool] ${r.text}` : r.text,
+        timestamp: Math.floor(r.at),
+      }));
+      const repo = new TaskIndexRepo();
+      try {
+        const taskMeta = await persistImportedClaudeTask({
+          taskIndexRepo: repo,
+          sessionFile: { meta, messages },
+          workspaceIdentity: params.workspacePath,
+        });
+        return {
+          sessionId: taskMeta.taskId,
+          rowsWritten: messages.length,
+        } satisfies V4ImportSessionResult;
+      } finally {
+        try { (repo as unknown as { close?: () => void }).close?.() } catch { /* best-effort */ }
+      }
+    },
+
