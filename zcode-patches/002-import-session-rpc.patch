+      try {
+        const created = await repo.applyCliFacts({
+          meta: sessionFileMeta,
+          lastOutcome: "completed",
+        });
+        await writeImportedClaudeTaskSnapshot({
+          sessionFile: { meta: sessionFileMeta, messages: sessionMessages },
+        });
+        const taskMeta = await repo.updateTaskPresentation({
