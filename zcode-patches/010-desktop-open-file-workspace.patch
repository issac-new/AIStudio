+// overlay[open-file-workspace]（zcode-patches 010，spec 2026-11-10-zcode-openfile-workspace）：
+// macOS `open -a ZCode <dir>` 的目录以 open-file 事件到达（不进 argv），此前无处理被
+// 忽略。冷启动（ready 前）并入 startupOpenWorkspaceRequest（首个优先）随主窗口
+// bootstrap 打开，与 --open-workspace argv 同语义；ready 后与 second-instance 同口径
+// 直投 handleOpenWorkspacePath（校验本地目录→IPC 投 renderer，未就绪有排队）。
+if (process.platform === "darwin") {
+  app.on("open-file", (event, openPath) => {
+    event.preventDefault();
+    if (!app.isReady()) {
+      startupOpenWorkspaceRequest ??= { path: openPath, source: "open-workspace-arg" };
+      return;
+    }
+    handleOpenWorkspacePath(openPath, logger, {
+      allowWithoutReadyWindow: true,
+      resolveApplicationWindow: () => getApplicationWindowsExcludingCuaIndicator()[0] ?? null,
+    });
+  });
+}
