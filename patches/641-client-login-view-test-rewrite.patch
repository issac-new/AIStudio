 import LoginView from '@/views/LoginView.vue'
 
+const MATRIX_USER = { id: 1, username: 'mx', role: 'admin', status: 'active' } as const
+
+/** autoLoginFromGateway 的 fetch 桩（缺省不可达：jsdom 无相对 URL fetch base） */
+const fetchMock = vi.fn(() => Promise.reject(new TypeError('Failed to fetch URL')))
+
+/** 挂载并等 onMounted 的 autoLogin 异步链落定（until 供成功路径等 push） */
+async function mountLogin(opts: { until?: () => void } = {}): Promise<ReturnType<typeof mount>> {
+  const wrapper = mount(LoginView)
+  if (opts.until) {
+    await vi.waitFor(opts.until)
+  } else {
+    await new Promise(resolve => setTimeout(resolve, 20))
+  }
+  return wrapper
+}
+
+/** 当前激活表单是否为本地登录 */
+function localFormActive(wrapper: ReturnType<typeof mount>): boolean {
+  return wrapper.find('form.login-form [placeholder="login.usernamePlaceholder"]').exists()
+}
+
+/** 经「后端不可达」路径把组件切到本地表单（组件唯一的 Matrix→Local 切换通道） */
+async function switchToLocal(wrapper: ReturnType<typeof mount>): Promise<void> {
+  if (localFormActive(wrapper)) return
+  mockMatrixSdkLogin.mockRejectedValueOnce(new Error('Failed to fetch'))
+  const inputs = wrapper.findAll('input.login-input')
+  await inputs[0]!.setValue('http://hs')
+  await inputs[1]!.setValue('switch-user')
+  await inputs[2]!.setValue('switch-pass')
+  await wrapper.find('form.login-form').trigger('submit')
+  await vi.waitFor(() => { expect(localFormActive(wrapper)).toBe(true) })
+}
+
+async function submitLocal(wrapper: ReturnType<typeof mount>, username: string, password: string): Promise<void> {
+  await switchToLocal(wrapper)
+  const inputs = wrapper.findAll('input.login-input')
+  await inputs[0]!.setValue(username)
+  await inputs[1]!.setValue(password)
+  await wrapper.find('form.login-form').trigger('submit')
+}
