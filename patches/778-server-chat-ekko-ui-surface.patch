+/**
+ * 声明式界面（ekko-ui/v1）：MCP 工具阻塞等待用户提交/取消/超时。
+ * 与 clarify 同构——请求在途期间没有模型调用，只有可 abort 的 Host Promise。
+ */
+chatRunRoutes.post('/api/studio/surfaces/request', async (ctx: Context) => {
+  const body = (ctx.request.body || {}) as Record<string, unknown>
+  const server = getChatRunServer()
+  if (!server?.requestUiSurface) {
+    ctx.status = 503
+    ctx.body = { ok: false, error: 'Chat run service is unavailable' }
+    return
+  }
+  const abort = new AbortController()
+  const onClose = () => abort.abort()
+  ctx.res.once('close', onClose)
+  try {
+    if (typeof body.context_id !== 'string' || !body.context_id.trim()) throw new SurfaceError('context_id is required')
+    const profile = String(ctx.state.profile?.name || 'default').trim() || 'default'
+    const result = await server.requestUiSurface(body.context_id, profile, body, abort.signal)
+    ctx.body = { ok: true, ...result }
+  } catch (err) {
+    if (!(err instanceof SurfaceError)) throw err
+    ctx.status = err.status
+    ctx.body = { ok: false, error: err.message }
+  } finally {
+    ctx.res.removeListener('close', onClose)
+  }
+})
+
 chatRunRoutes.post('/api/studio/chat-run/runs', ctrl.runOnce)
 chatRunRoutes.post('/api/studio/mobile-calendar/request', ctrl.requestMobileCalendar)
 chatRunRoutes.post('/api/studio/mobile-location/request', ctrl.requestMobileLocation)


