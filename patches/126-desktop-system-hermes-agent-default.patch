+
+function resolveExecutable(command: string): string | undefined {
+  const trimmed = command.trim()
+  if (!trimmed) return undefined
+  if (trimmed.includes('/') || trimmed.includes('\\')) {
+    return existsSync(trimmed) ? resolve(trimmed) : undefined
+  }
+  try {
+    const lookup = process.platform === 'win32'
+      ? execFileSync('where.exe', [trimmed], { encoding: 'utf-8', windowsHide: true })
+      : execFileSync('which', [trimmed], { encoding: 'utf-8' })
+    return lookup.split(/\r?\n/).map(line => line.trim()).find(Boolean)
+  } catch {
+    return undefined
+  }
+}
+
+function preferredSystemHermesCommand(): string | undefined {
+  return resolveExecutable('hermes')
+    ?? resolveExecutable('hermes-agent')
+    ?? undefined
+}
+
+// overlay[explicit-system-hermes]: system Hermes must be explicitly opted in.
+// Without this env var, the desktop always uses the bundled runtime.
+function explicitSystemHermesEnabled(): boolean {
+  const raw = (process.env.HERMES_DESKTOP_USE_SYSTEM_HERMES || '').trim().toLowerCase()
+  if (!['1', 'true', 'yes', 'on'].includes(raw)) return false
+  return true
+}
