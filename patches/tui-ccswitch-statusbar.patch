+
+        // Build compact colored segments: prov │ usage │ tok lat ttft status time │ ip
+        const latText = `${lastL}${lastFT ? ' ' + lastFT : ''}`.trim()
+        const stText = `${lastSt}${lastErr ? ' ' + lastErr : ''}`.trim()
+        const segs: CcSegment[] = [
+          { t: prov, k: 'prov' },
+          { t: ' \u2502 ', k: 'sep' },
+          { t: usageText, k: usageKey(usagePct) },
+          { t: ' \u2502 ', k: 'sep' },
+          { t: lastTok, k: 'tokens' },
+          { t: ' ', k: 'sep' },
+          { t: latText, k: latencyKey(latMs) },
