+// Cached public IP + weather string (refreshed every 10 min).
+type IpWeatherCache = { text: string; ts: number }
+
+async function fetchIpWeather(): Promise<string> {
+  const now = Date.now()
+
+  if (fetchIpWeather.cache && now - fetchIpWeather.cache.ts < 600000) {return fetchIpWeather.cache.text}
+
+  try {
+    const ipRes = await fetch('https://myip.ipip.net', { signal: AbortSignal.timeout(3000) })
+    const ipText = (await ipRes.text()).trim()
+    const ipAddr = ipText.match(/IP：(\S+)/)?.[1] || '-'
+    let weather = ''
+
+    try {
+      const wRes = await fetch('https://wttr.in/?format=%c+%t', { signal: AbortSignal.timeout(3000) })
+      weather = (await wRes.text()).trim()
+    } catch {
+      // weather optional
+    }
+
+    fetchIpWeather.cache = { text: [ipAddr, weather].filter(Boolean).join(' '), ts: now }
+
+    return fetchIpWeather.cache.text
+  } catch {
+    return '-'
+  }
+}
+
+fetchIpWeather.cache = null as (IpWeatherCache | null)
