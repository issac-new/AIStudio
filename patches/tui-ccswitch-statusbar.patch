+// Volcengine (huoshan) coding-plan usage via V4 signature.
+async function fetchVolcengineUsage(ak: string, sk: string): Promise<string> {
+  const { createHmac, createHash } = await import('crypto')
+  const host = 'open.volcengineapi.com', service = 'ark', region = 'cn-beijing'
+  const ct = 'application/json; charset=utf-8', sh = 'host;x-date;x-content-sha256;content-type'
+  const now = new Date()
+  const xDate = now.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z'
+  const shortDate = xDate.slice(0, 8)
+  const hmac = (k: Buffer | string, d: string) => createHmac('sha256', k).update(d).digest()
+  const sha = (d: Buffer | string) => createHash('sha256').update(d).digest('hex')
+  const pairs = [['Action', 'GetCodingPlanUsage'], ['Region', region], ['Version', '2024-01-01']].sort((a, b) => a[0].localeCompare(b[0]))
+  const cq = pairs.map(([k, v]) => `${k}=${v}`).join('&')
+  const body = Buffer.alloc(0)
+  const xcs = sha(body.toString())
+  const ch = `host:${host}\nx-date:${xDate}\nx-content-sha256:${xcs}\ncontent-type:${ct}\n`
+  const cr = `POST\n/\n${cq}\n${ch}\n${sh}\n${xcs}`
+  const cs = `${shortDate}/${region}/${service}/request`
+  const sts = `HMAC-SHA256\n${xDate}\n${cs}\n${sha(Buffer.from(cr))}`
+  const kDate = hmac(Buffer.from(sk, 'utf-8'), shortDate)
+  const kSig = hmac(hmac(hmac(kDate, region), service), 'request')
+  const sig = hmac(kSig, sts).toString('hex')
+  const auth = `HMAC-SHA256 Credential=${ak}/${cs}, SignedHeaders=${sh}, Signature=${sig}`
+
+  const res = await fetch(`https://${host}/?${cq}`, {
+    method: 'POST',
+    headers: { Host: host, 'X-Date': xDate, 'X-Content-Sha256': xcs, 'Content-Type': ct, Authorization: auth },
+    body, signal: AbortSignal.timeout(5000),
+  })
+
+  if (!res.ok) {throw new Error(`HTTP ${res.status}`)}
+  const j = await res.json() as { Result?: { QuotaUsage?: Array<{ Level?: string; Percent?: number }> } }
+  const tiers: Record<string, string> = {}
+
+  for (const q of (j.Result?.QuotaUsage || [])) {tiers[q.Level || ''] = q.Percent?.toFixed(0) || '?'}
+
+  return `5h ${tiers.session || '-'}% │ 7d ${tiers.weekly || '-'}% │ mo ${tiers.monthly || '-'}%`
+}
+
+// A single colored segment of the cc-extra status line.
+// `t` is the text shown; `k` is a semantic key the renderer maps to a theme
+// color (prov | usage | usagePct | latency | tokens | status | statusOk |
+// statusErr | ip | sep). Numbers get urgency-based colors: high usage → warn,
+// slow latency → warn, non-200 status → error, 200 → good.
+type CcSegment = { t: string; k?: string }
+
+// Structured cc-switch status: `text` for width math, `segs` for colored render.
+type CcExtra = { text: string; segs: CcSegment[] }
+
+// Map a usage percentage to a semantic urgency key.
+function usageKey(pct: number | null): string {
+  if (pct == null) {return 'usage'}
+
+  if (pct >= 80) {return 'usageBad'}
+
+  if (pct >= 50) {return 'usageWarn'}
+
+  return 'usageOk'
+}
+
+// Map a latency in ms to a semantic urgency key.
+function latencyKey(ms: number | null): string {
+  if (ms == null) {return 'latency'}
+
+  if (ms >= 30000) {return 'latencyBad'}
+
+  if (ms >= 10000) {return 'latencyWarn'}
+
+  return 'latencyOk'
+}
+
+// Compact usage + last-request line for the active cc switch provider, merged
+// into the status bar's tail (lowest-priority segment, drops first on narrow
+// terminals). Replaces the old standalone dock-top widget row.
+function useCcSwitchExtra(): CcExtra {
+  const [extra, setExtra] = useState<CcExtra>({ text: '', segs: [] })
+
+  useEffect(() => {
+    let cancelled = false
+
+    async function tick() {
+      try {
