+          usagePct = d7Pct ?? h5Pct
+          usageText = `5h ${h5Pct ?? '?'}% | 7d ${d7Pct ?? '?'}%`
+        } else if (name === 'bigmodel' || name === 'BigModel-coding-plan') {
+          const u = await (await fetch('https://open.bigmodel.cn/api/monitor/usage/quota/limit', { headers: { Authorization: 'Bearer ' + token }, signal: AbortSignal.timeout(3000) })).json() as { data?: { limits?: Array<{ type?: string; unit?: number; percentage?: number }> } }
+          let h5 = '?', d7 = '?'
+
+          for (const l of (u.data?.limits || [])) {
+            if (l.type === 'TOKENS_LIMIT') {
+              if (l.unit === 3) {
+                h5 = `${l.percentage}%`
+              }
+
+              if (l.unit === 6) {
+                d7 = `${l.percentage}%`
+              }
+            }
+          }
+
+          usageText = `5h ${h5} | 7d ${d7}`
+        } else if (name === 'deepseek') {
+          const u = await (await fetch('https://api.deepseek.com/user/balance', { headers: { Authorization: 'Bearer ' + token }, signal: AbortSignal.timeout(3000) })).json() as { balance_infos?: Array<{ total_balance?: string }> }
+          const info = (u.balance_infos || [])[0] || {}
+          usageText = `${info.total_balance || '-'} CNY`
+        } else if (name === 'huoshan') {
+          const us = meta?.usage_script
+
+          if (us?.accessKeyId && us?.secretAccessKey) {
+            usageText = await fetchVolcengineUsage(us.accessKeyId, us.secretAccessKey)
+          } else {
+            const reqs = JSON.parse(sql(`SELECT COUNT(*) as n FROM proxy_request_logs WHERE provider_id='${r.id}' AND created_at >= strftime('%s','now','-1 hour');`) || '[]')
+            const n = reqs.length ? Number(reqs[0].n) : 0
+            usagePct = Number((n / 500 * 100).toFixed(0))
+            usageText = `${usagePct}%`
+          }
+        } else {
+          // rate-limit proxy for weekly-z.ai / opus5 etc.
+          const reqs = JSON.parse(sql(`SELECT COUNT(*) as n FROM proxy_request_logs WHERE provider_id='${r.id}' AND created_at >= strftime('%s','now','-1 hour');`) || '[]')
+          const n = reqs.length ? Number(reqs[0].n) : 0
+          usagePct = Number((n / 500 * 100).toFixed(0))
+          usageText = `${usagePct}%`
+        }
+
+        // last request — tokens, latency, status, time (compact: ms→s, drop model)
+        const lr = JSON.parse(sql(`SELECT latency_ms, first_token_ms, input_tokens, output_tokens, status_code, error_message, datetime(created_at,'unixepoch','localtime') as ts FROM proxy_request_logs ORDER BY created_at DESC LIMIT 1;`) || '[]')
+        const lr0 = lr.length ? lr[0] : null
+        const latMs = lr0 ? lr0.latency_ms : null
+        const fmtMs = (ms: number | null) => ms == null ? '' : ms >= 1000 ? `${(ms / 1000).toFixed(0)}s` : `${ms}ms`
+        const lastL = fmtMs(latMs)
+        const lastFT = lr0 && lr0.first_token_ms != null ? `ttft${fmtMs(lr0.first_token_ms)}` : ''
+        const lastTok = lr0 ? `${fmtK(lr0.input_tokens || 0)}\u2192${fmtK(lr0.output_tokens || 0)}` : ''
+        const isOk = lr0 ? lr0.status_code === 200 : false
+        const lastSt = lr0 ? (isOk ? '\u2713' : `${lr0.status_code}\u2717`) : '-'
+        const lastErr = lr0 && lr0.error_message ? lr0.error_message.slice(0, 12) : ''
+        const lastT = lr0 ? (lr0.ts?.split(' ')[1]?.slice(0, 5) || '-') : '-'
+
+        // provider from the /status proxy (model+effort already shown in the
+        // pinned modelText segment by useCcSwitchModel, so no duplication here)
+        const provRes = await fetch('http://127.0.0.1:15721/status', { signal: AbortSignal.timeout(2500) }).then(r => r.ok ? r.json() as { current_provider?: string } : null).catch(() => null)
