+        const rows = JSON.parse(sql(`SELECT json_extract(p.settings_config,'$.env.ANTHROPIC_AUTH_TOKEN') as token, p.name, p.id, p.meta FROM providers p WHERE p.app_type='claude' AND p.is_current=1 LIMIT 1;`) || '[]')
+
+        if (!rows.length) {return}
+        const r = rows[0]
+        const name = r.name || ''
+        const token = r.token || ''
+        let meta: any = {}
+
+        try {
+          meta = JSON.parse(r.meta || '{}')
+        } catch {
+          meta = {}
+        }
+
+        // public IP + weather (cached 10 min via fetchIpWeather)
+        const ipw = await fetchIpWeather()
+
+        // usage by provider type — collects raw % for color mapping
+        let usageText = ''
+        let usagePct: number | null = null
+
+        if (name === 'kimi-mid' || name === 'kimi-max') {
+          const u = await (await fetch('https://api.kimi.com/coding/v1/usages', { headers: { Authorization: 'Bearer ' + token }, signal: AbortSignal.timeout(3000) })).json() as { usage?: { limit?: string; remaining?: string }; limits?: Array<{ detail?: { limit?: number; used?: number } }> }
+          const d7 = ((u.limits || [])[0] || {}).detail || {}
+          const d7Pct = u.usage?.limit !== '?' && u.usage?.remaining !== '?' ? Number(((1 - Number(u.usage?.remaining) / Number(u.usage?.limit)) * 100).toFixed(0)) : null
