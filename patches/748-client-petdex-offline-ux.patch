     manifest.value = await fetchPetdexManifest(force)
     visibleLimit.value = 96
   } catch (err: any) {
-    error.value = err?.message || t('petdex.loadFailed')
+    // overlay[offline]（2026-11-04 Windows 离线回归批）：离线/外部服务不可达时
