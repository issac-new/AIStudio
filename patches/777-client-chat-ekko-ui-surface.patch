+
+/**
+ * 回填一块声明式界面（ekko-ui/v1 Surface）。payload 只在服务端复验后交给 Agent；
+ * 前端乐观状态由工具结果校正。
+ */
+export function respondUiSurface(
+  sessionId: string,
+  surfaceId: string,
+  revision: number,
+  actionId: string,
+  payload?: unknown,
+  profile?: string,
+  transport: ChatRunTransport = 'chat-run',
+): void {
+  const socket = connectChatRun(null, transport)
+  socket.emit('ui.surface.action', {
+    session_id: sessionId,
+    surface_id: surfaceId,
+    revision,
+    action_id: actionId,
+    ...(profile ? { profile } : {}),
+    ...(payload !== undefined ? { payload } : {}),
   })
 }
 
