+        for row in lane_rows:
+            assignee = row["assignee"]
+            if per_profile_running.get(assignee, 0) >= 1:
+                deferred.append((row["id"], assignee))
+                continue
+        assert deferred == [(second, "sage")]  # 同人第二张被围栏拦下
