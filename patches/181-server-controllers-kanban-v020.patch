+// HERMES_CUSTOM[v020] BEGIN: estimate / projects / board project controllers
+
+/** POST /api/hermes/kanban/:id/estimate — rough token + complexity read via the auxiliary model. */
+export async function estimateTask(ctx: Context) {
+  try {
+    ctx.body = await kanbanCli.estimateTask(ctx.params.id, { board: ctx.query.board as string | undefined })
+  } catch (err: any) {
+    ctx.status = 500
+    ctx.body = { error: err.message }
+  }
+}
+
+/** POST /api/hermes/kanban/estimate — estimate from raw title/body (create dialog). */
+export async function estimateText(ctx: Context) {
+  const bodyResult = requestBody(ctx)
+  if (rejectBadRequest(ctx, bodyResult.error)) return
+  const title = requiredNonEmptyString(bodyResult.body.title, 'title')
+  const body = optionalString(bodyResult.body.body, 'body')
+  if (rejectBadRequest(ctx, title.error || body.error)) return
+  try {
+    ctx.body = await kanbanCli.estimateText(title.value!, body.value)
+  } catch (err: any) {
+    ctx.status = 500
+    ctx.body = { error: err.message }
+  }
+}
+
+/** GET /api/hermes/kanban/projects — first-class Hermes projects for board scoping. */
+export async function listProjects(ctx: Context) {
+  try {
+    ctx.body = { projects: await kanbanCli.listProjects() }
+  } catch (err: any) {
+    ctx.status = 500
+    ctx.body = { error: err.message }
+  }
+}
+
+/** PATCH /api/hermes/kanban/boards/:slug — currently only the project scope is mutable. */
+export async function patchBoard(ctx: Context) {
+  const bodyResult = requestBody(ctx)
+  if (rejectBadRequest(ctx, bodyResult.error)) return
+  const hasProject = 'project_id' in (bodyResult.body || {})
+  const projectId = optionalString(bodyResult.body.project_id, 'project_id')
+  if (rejectBadRequest(ctx, projectId.error)) return
+  if (!hasProject) {
+    ctx.status = 400
+    ctx.body = { error: 'nothing to patch (supported: project_id)' }
+    return
+  }
+  try {
+    await kanbanCli.setBoardProject(ctx.params.slug, projectId.value || null)
+    ctx.body = { ok: true }
+  } catch (err: any) {
+    ctx.status = err.message?.includes('does not exist') ? 400 : 500
+    ctx.body = { error: err.message }
+  }
+}
+// HERMES_CUSTOM[v020] END
