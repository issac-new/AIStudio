@@ -0,0 +1,133 @@
+"""Tests for provider coding-plan identity rewrite (GLM → ZCode, Kimi → kimi-code).
+
+GLM Coding Plan (bigmodel / Z.ai) and Kimi Coding Plan fingerprint the agent
+identity string in the system prompt; a request identifying as "Hermes Agent"
+is classified as third-party and downgraded/throttled off the plan lane.
+``build_anthropic_kwargs`` must present the matching product name for those
+models and leave every other model's prompt untouched.
+"""
+
+from agent.anthropic_adapter import (
+    _model_name_is_glm_family,
+    _provider_wire_agent_identity,
+    build_anthropic_kwargs,
+)
+
+_IDENTITY_PROMPT = (
+    "You are Hermes Agent, an intelligent AI assistant created by Nous "
+    "Research. You run on Hermes Agent (by Nous Research). Load the "
+    "`hermes-agent` skill with skill_view(name='hermes-agent')."
+)
+
+
+def _system_text(kwargs):
+    """Flatten kwargs["system"] (str | list[blocks]) to plain text."""
+    system = kwargs.get("system", "")
+    if isinstance(system, str):
+        return system
+    return "".join(
+        block.get("text", "")
+        for block in system
+        if isinstance(block, dict) and block.get("type") == "text"
+    )
+
+
+def _build(model, system_prompt=_IDENTITY_PROMPT):
+    return build_anthropic_kwargs(
+        model=model,
+        messages=[
+            {"role": "system", "content": system_prompt},
+            {"role": "user", "content": "hi"},
+        ],
+        tools=None,
+        max_tokens=1024,
+        reasoning_config=None,
+    )
+
+
+# --- identity resolver ------------------------------------------------------
+
+def test_glm_models_resolve_to_zcode():
+    for model in ("glm-5.3", "glm-5.1", "GLM-5.2-C", "glm-4.6",
+                  "zai/glm-5.3", "chatglm3-turbo"):
+        assert _provider_wire_agent_identity(model) == "ZCode", model
+
+
+def test_kimi_models_resolve_to_kimi_code():
+    for model in ("kimi-k3", "k3", "kimi-k2.5", "moonshot-v1-8k"):
+        assert _provider_wire_agent_identity(model) == "kimi-code", model
+
+
+def test_other_models_resolve_to_none():
+    for model in ("claude-opus-5", "deepseek-v4-flash", "qwen3.5-plus",
+                  "glimpse-1", "", None, 42):
+        assert _provider_wire_agent_identity(model) is None, model
+
+
+def test_glm_family_prefix_does_not_over_match():
+    assert _model_name_is_glm_family("glimpse-1") is False
+    assert _model_name_is_glm_family("glm") is True
+    assert _model_name_is_glm_family(None) is False
+
+
+# --- build_anthropic_kwargs rewrite ----------------------------------------
+
+def test_glm_model_gets_zcode_identity():
+    text = _system_text(_build("glm-5.3"))
+    assert "ZCode" in text
+    assert "Hermes Agent" not in text and "Hermes agent" not in text
+    # Everything but the product name survives verbatim.
+    assert "created by Nous Research" in text
+
+
+def test_kimi_k3_model_gets_kimi_code_identity():
+    text = _system_text(_build("kimi-k3"))
+    assert "kimi-code" in text
+    assert "Hermes Agent" not in text
+
+
+def test_bare_k3_slug_gets_kimi_code_identity():
+    # Kimi Coding Plan serves K3 under the exact slug "k3".
+    text = _system_text(_build("k3"))
+    assert "kimi-code" in text
+    assert "Hermes Agent" not in text
+
+
+def test_non_plan_models_keep_hermes_identity():
+    for model in ("claude-opus-5", "deepseek-v4-flash"):
+        text = _system_text(_build(model))
+        assert "Hermes Agent" in text, model
+
+
+def test_lowercase_hermes_agent_slug_is_preserved():
+    # `hermes-agent` names a real skill and CLI slug — must NOT be rewritten.
+    text = _system_text(_build("glm-5.3"))
+    assert "skill_view(name='hermes-agent')" in text
+
+
+def test_missing_system_is_noop():
+    kwargs = build_anthropic_kwargs(
+        model="glm-5.3",
+        messages=[{"role": "user", "content": "hi"}],
+        tools=None,
+        max_tokens=1024,
+        reasoning_config=None,
+    )
+    assert "system" not in kwargs or not kwargs["system"]
+
+
+def test_rewrite_applies_to_block_list_system():
+    # The gateway path assembles system as a list of text blocks.
+    kwargs = build_anthropic_kwargs(
+        model="kimi-k3",
+        messages=[
+            {"role": "system", "content": [
+                {"type": "text", "text": "You are Hermes Agent."},
+            ]},
+            {"role": "user", "content": "hi"},
+        ],
+        tools=None,
+        max_tokens=1024,
+        reasoning_config=None,
+    )
+    assert "kimi-code" in _system_text(kwargs)
