+# Model-name prefixes that identify the Zhipu / Z.ai GLM family, matched
+# case-insensitively against the post-normalize model slug. Covers official
+# slugs (``glm-4.6``, ``glm-5.3``, ``GLM-5.2-C``), date-stamped variants, the
+# legacy ``chatglm*`` names, and vendor-prefixed forms (``zai/glm-5.3``).
+_GLM_FAMILY_MODEL_PREFIXES = ("glm", "chatglm")
+
+
+def _model_name_is_glm_family(model: str | None) -> bool:
+    """Return True for Zhipu / Z.ai GLM-family model slugs."""
+    if not isinstance(model, str):
+        return False
+    m = model.strip().lower()
+    if not m:
+        return False
+    # Strip vendor prefix (e.g. ``zai/glm-5.3`` → ``glm-5.3``)
+    if "/" in m:
+        m = m.rsplit("/", 1)[-1]
+    return m.startswith(_GLM_FAMILY_MODEL_PREFIXES)
+
+
+def _provider_wire_agent_identity(model: str | None) -> str | None:
+    """Return the coding-agent identity a provider's plan expects on the wire.
+
+    GLM Coding Plan (bigmodel / Z.ai) classifies traffic that does NOT
+    identify as ZCode out of the coding lane into the throttled consumer
+    lane; Kimi Coding Plan does the same for non-``kimi-code`` clients.
+    The fingerprint is the agent identity string in the system prompt, so
+    requests built for these models present the matching product name
+    instead of "Hermes Agent".
+
+    Model-name based (not endpoint based) so proxied gateways (e.g.
+    cc-switch fronting bigmodel) get the same treatment as direct
+    connections. Returns None for models that don't gate on client
+    identity — the vast majority — leaving their prompts untouched.
+    """
+    if _model_name_is_glm_family(model):
+        return "ZCode"
+    if _model_name_is_kimi_family(model):
+        return "kimi-code"
+    return None
+
+
