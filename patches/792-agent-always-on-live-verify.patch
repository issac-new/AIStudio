+def _unwrap_tool_text(raw: Any) -> str:
+    """剥工具结果信封：hindsight 工具返回 ``{"result": ...}``/``{"error": ...}`` JSON 字符串，
+    直接当正文 retain 会把转义 JSON 写进 bank 且空判失效（活体验证 2026-11-16 抓出）。"""
+    text = str(raw or "").strip()
+    if text.startswith("{"):
+        try:
+            data = json.loads(text)
+        except ValueError:
+            return text
+        if isinstance(data, dict):
+            if data.get("error"):
+                return ""
+            value = data.get("result")
+            return str(value or "").strip()
+    return text
