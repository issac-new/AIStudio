@@ -0,0 +1,181 @@
+"""Watcher wiring tests for the follow-up watcher (Always-on P3, 2026-11-16 补漏批).
+
+These exercise ``GatewayFollowupsMixin._followup_fire_one`` end-to-end against a stub
+runner: the REAL followup store (temp SessionDB), the REAL claim/fire state machine,
+and a patched ``admit_route_wake`` recording the injection. No gateway process needed.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import time
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+
+@pytest.fixture
+def hermes_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    from hermes_cli import goals
+
+    goals._DB_CACHE.clear()
+    yield home
+    goals._DB_CACHE.clear()
+
+
+ROUTE = {"platform": "telegram", "chat_id": "42", "chat_type": "dm", "user_id": "u1"}
+
+
+from enum import Enum
+
+
+class _FakePlatform(Enum):
+    TELEGRAM = "telegram"
+
+
+def make_harness(*, busy_keys: set[str] | None = None):
+    """mixin 挂在桩 runner 上：``_followup_fire_one`` 里 ``self`` 就是 runner。"""
+    from gateway.run_followups import GatewayFollowupsMixin
+
+    class Harness(GatewayFollowupsMixin):
+        def __init__(self):
+            self._running_agents = set(busy_keys or set())
+            self.wake_calls: list[tuple[str, str, str]] = []  # (producer, text, followup_id)
+            self.handle_message_events: list[str] = []
+            self.sources: list = []
+
+        def _adapters_for_profile(self, profile):
+            harness = self
+
+            async def _record_handle(event):
+                harness.handle_message_events.append(getattr(event, "text", str(event)))
+
+            return {_FakePlatform.TELEGRAM: SimpleNamespace(handle_message=_record_handle)}
+
+        def _build_process_event_source(self, meta):
+            src = SimpleNamespace(
+                platform=meta.get("platform", ""), chat_id=meta.get("chat_id", ""),
+                chat_type=meta.get("chat_type", ""), thread_id=meta.get("thread_id", ""),
+                user_id=meta.get("user_id", ""), user_name=meta.get("user_name", ""),
+                profile=None,
+            )
+            self.sources.append(src)
+            return src
+
+        def _session_key_for_source(self, source):
+            return f"{source.platform}:{source.chat_id}"
+
+        def _synthetic_prompt_event(self, source, text, *, internal=False):
+            return SimpleNamespace(text=text, source=source, internal=internal)
+
+        async def _run_in_executor_with_context(self, fn, *args, **kwargs):
+            return fn(*args, **kwargs)
+
+        async def fake_admit_route_wake(self, runner, adapter, source, text, producer, metadata=None):
+            self.wake_calls.append((producer, text, str((metadata or {}).get("followup_id", ""))))
+            return True
+
+    return Harness()
+
+
+def _make_state(now: float, **over):
+    from hermes_cli.followups import FollowupState
+
+    base = dict(
+        id="fu1", session_id="sess-1", prompt="check the reply", status="active",
+        created_at=now - 3600, due_at=now - 1, fired_at=0.0, attempts=0, last_error="",
+        route=dict(ROUTE),
+    )
+    base.update(over)
+    return FollowupState(**base)
+
+
+def run(coro):
+    return asyncio.run(coro)
+
+
+class TestFollowupFireOne:
+    def test_due_idle_session_claims_and_fires_via_admit_route_wake(self, hermes_home):
+        from gateway.run_followups import GatewayFollowupsMixin
+        from hermes_cli.followups import create_followup, list_followups
+
+        now = time.time()
+        create_followup("sess-1", "check the reply", 60, ROUTE, now=now - 61)
+        state = list_followups("sess-1")[0]
+        harness = make_harness()
+        with patch("gateway.session_automation.admit_route_wake", harness.fake_admit_route_wake):
+            run(harness._followup_fire_one(state, warned_no_route=set()))
+        assert harness.wake_calls == [("followup", "check the reply", state.id)]
+        assert [s.status for s in list_followups("sess-1")] == ["fired"]
+        assert list_followups("sess-1")[0].fired_at >= now
+
+    def test_busy_session_stays_active_unclaimed(self, hermes_home):
+        from gateway.run_followups import GatewayFollowupsMixin
+        from hermes_cli.followups import create_followup, list_followups
+
+        now = time.time()
+        create_followup("sess-1", "p", 60, ROUTE, now=now - 61)
+        state = list_followups("sess-1")[0]
+        harness = make_harness(busy_keys={"telegram:42"})
+        with patch("gateway.session_automation.admit_route_wake", harness.fake_admit_route_wake):
+            run(harness._followup_fire_one(state, warned_no_route=set()))
+        assert harness.wake_calls == []
+        assert list_followups("sess-1")[0].status == "active"
+
+    def test_admit_wake_refusal_falls_back_to_adapter_handle_message(self, hermes_home):
+        from gateway.run_followups import GatewayFollowupsMixin
+        from hermes_cli.followups import create_followup, list_followups
+
+        now = time.time()
+        create_followup("sess-1", "fallback path", 60, ROUTE, now=now - 61)
+        state = list_followups("sess-1")[0]
+        harness = make_harness()
+
+        async def refuse(*args, **kwargs):
+            return False
+
+        with patch("gateway.session_automation.admit_route_wake", refuse):
+            run(harness._followup_fire_one(state, warned_no_route=set()))
+        assert harness.handle_message_events == ["fallback path"]
+        assert list_followups("sess-1")[0].status == "fired"
+
+    def test_injection_error_releases_for_retry_then_fails(self, hermes_home):
+        from gateway.run_followups import GatewayFollowupsMixin
+        from hermes_cli.followups import create_followup, list_followups
+
+        now = time.time()
+        create_followup("sess-1", "boom", 60, ROUTE, now=now - 61)
+        harness = make_harness()
+
+        async def explode(*args, **kwargs):
+            raise RuntimeError("adapter down")
+
+        for expected_status, expected_attempts in (("active", 1), ("active", 2), ("failed", 3)):
+            state = list_followups("sess-1")[0]
+            assert state.status == "active"
+            with patch("gateway.session_automation.admit_route_wake", explode):
+                run(harness._followup_fire_one(state, warned_no_route=set()))
+            after = list_followups("sess-1")[0]
+            assert after.status == expected_status
+            assert after.attempts == expected_attempts
+
+    def test_no_adapter_warns_once_and_leaves_active(self, hermes_home):
+        from gateway.run_followups import GatewayFollowupsMixin
+        from hermes_cli.followups import create_followup, list_followups
+
+        now = time.time()
+        create_followup("sess-1", "p", 60, ROUTE, now=now - 61)
+        state = list_followups("sess-1")[0]
+
+        harness = make_harness()
+        harness._adapters_for_profile = lambda profile: {}
+        warned: set = set()
+        run(harness._followup_fire_one(state, warned_no_route=warned))
+        assert warned == {state.id}
+        assert list_followups("sess-1")[0].status == "active"
