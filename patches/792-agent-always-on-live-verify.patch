@@ -0,0 +1,127 @@
+"""Live E2E for idle dreaming against the real Hindsight daemon (Always-on P5 补漏批).
+
+Env-gated: only runs when ``HERMES_DREAMING_LIVE=1`` AND ``hindsight_client`` is
+importable (deployment py312). Everything else skips — CI/单测环境零副作用.
+
+隔离：scratch bank（``hermes-live-dream-<ts>``，与生产 bank 前缀区分，可整体删除）；
+预算戳在临时 SessionDB；不触生产 bank。
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+pytestmark = [
+    # 活体豁免：读部署插件 + 经 daemon 写 scratch bank（不经真实 home 文件面）
+    pytest.mark.allow_real_home_io,
+    pytest.mark.skipif(
+        not (Path.home() / ".hermes/plugins/hindsight/__init__.py").exists(),
+        reason="部署插件缺席（~/.hermes/plugins/hindsight）",
+    ),
+    pytest.mark.skipif(
+        importlib.util.find_spec("hindsight_client") is None,
+        reason="hindsight_client 不可导入（需部署解释器，如 anaconda py312）",
+    ),
+]
+
+
+# 打桩 Path.home 之前解析（真实部署位；monkeypatch 后不可再取 Path.home）
+_DEPLOYED_PLUGIN_DIR = Path("/dev/null")  # 占位：在下方真正解析
+
+
+def _resolve_plugin_dir() -> Path:
+    return Path(__import__("os").path.expanduser("~/.hermes/plugins/hindsight"))
+
+
+def _load_provider(bank: str, home_dir: Path):
+    # 本地守护配置先行（initialize 时读取）：mode=local_external + :8888
+    cfg_dir = home_dir / "hindsight"
+    cfg_dir.mkdir(parents=True, exist_ok=True)
+    (cfg_dir / "config.json").write_text(json.dumps({
+        "mode": "local_external", "api_url": "http://localhost:8888",
+        "bank_id": bank, "retain_async": False, "auto_recall": False, "auto_retain": False,
+        "timeout": 180, "idle_timeout": 200,
+    }, ensure_ascii=False), encoding="utf-8")
+    plugin_dir = _resolve_plugin_dir()
+    sys.path.insert(0, str(plugin_dir.parent))
+    spec = importlib.util.spec_from_file_location("hindsight", plugin_dir / "__init__.py")
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules.setdefault("hindsight", mod)
+    spec.loader.exec_module(mod)
+    # 客户端自升级会动部署解释器环境：活体测试一律禁用
+    mod._maybe_upgrade_client = lambda: None
+    provider = mod.HindsightMemoryProvider()
+    provider.initialize(session_id=f"dream-live-{int(time.time())}", platform="cli")
+    provider._bank_id = bank  # scratch：不触生产 bank
+    return provider
+
+
+def test_dreaming_live_reflect_and_retain(tmp_path, monkeypatch):
+    pytest.importorskip("hindsight_client")
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_MEMORY_DREAMING", "1")
+    from hermes_cli import goals
+
+    goals._DB_CACHE.clear()
+    try:
+        bank = f"hermes-live-dream-{int(time.time())}"
+        provider = _load_provider(bank, home)
+
+        # 1) 种子事实（实质内容——10 字符级琐碎文本无可抽取事实，实测 0 memory unit；
+        #    轮询等待 daemon 异步抽取落库，实测 ~10s 可召回）
+        for i in (1, 2):
+            out = provider.handle_tool_call("hindsight_retain", {
+                "content": (
+                    f"活体验证记录 {i}：AIStudio 常驻智能体批次于 2026-11-16 落地空闲 dreaming 机制，"
+                    "要求网关安静至少 30 分钟才触发，每个 profile 每 24 小时至多执行一次，"
+                    "产出以 tag dream 写回同一 bank。本验证只写 scratch bank，不触生产数据。"
+                ),
+                "context": "live-verify", "tags": ["live-dream"],
+            })
+            assert '"error"' not in out, out
+        deadline = time.time() + 60
+        seen = False
+        while time.time() < deadline:
+            recalled = provider.handle_tool_call("hindsight_recall", {"query": "dreaming 机制 触发条件"})
+            if "dreaming" in (recalled or "") and "No relevant" not in (recalled or ""):
+                seen = True
+                break
+            time.sleep(5)
+        assert seen, "种子事实 60s 内未可召回（daemon 抽取异常或内容无可抽取事实？）"
+
+        # 2) 真跑一轮 dream（force 绕过 24h 预算；预算戳落临时库）
+        from hermes_cli.goals import _get_session_db
+        from agent.memory_dreaming import DREAM_META_KEY, run_dreaming
+
+        db = _get_session_db()
+        result = run_dreaming(now=time.time(), db=db, provider=provider, force=True)
+        assert result.get("dreamed") is True, result
+        assert result.get("retained_chars", 0) > 0
+        assert db.get_meta(DREAM_META_KEY), "预算戳未落"
+
+        # 3) dream 产物可召回（tag dream 已进 scratch bank；索引异步，轮询窗口）
+        from agent.memory_dreaming import _unwrap_tool_text
+
+        deadline = time.time() + 60
+        hit = False
+        while time.time() < deadline:
+            recalled = _unwrap_tool_text(
+                provider.handle_tool_call("hindsight_recall", {"query": "跨会话模式 提炼"})
+            )
+            if "No relevant memories found." not in recalled and recalled:
+                hit = True
+                break
+            time.sleep(5)
+        assert hit, "dream 产物 60s 内未可召回"
+        provider.shutdown()
+    finally:
+        goals._DB_CACHE.clear()
