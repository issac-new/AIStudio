+"""Watcher wiring tests for the deferred-approval watcher (Always-on P6 补漏批, 2026-11-16).
+
+Exercises ``GatewayDeferredApprovalMixin._deferred_scan_one`` against a stub runner with
+the REAL ledger (temp HERMES_HOME), REAL response files and REAL settle/expire state
+machines; only ``admit_route_wake`` is patched to record injections.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import time
+from enum import Enum
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+
+@pytest.fixture
+def hermes_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    from hermes_cli import goals
+
+    goals._DB_CACHE.clear()
+    yield home
+    goals._DB_CACHE.clear()
+
+
+ROUTE = {"platform": "telegram", "chat_id": "42", "chat_type": "dm", "user_id": "u1"}
+
+
+class _FakePlatform(Enum):
+    TELEGRAM = "telegram"
+
+
+def make_harness():
+    from gateway.run_deferred import GatewayDeferredApprovalMixin
+
+    class Harness(GatewayDeferredApprovalMixin):
+        def __init__(self):
+            self.wake_calls: list[tuple[str, str]] = []  # (outcome, text)
+            self.handle_message_events: list[str] = []
+
+        def _adapters_for_profile(self, profile):
+            harness = self
+
+            async def _record_handle(event):
+                harness.handle_message_events.append(getattr(event, "text", str(event)))
+
+            return {_FakePlatform.TELEGRAM: SimpleNamespace(handle_message=_record_handle)}
+
+        def _build_process_event_source(self, meta):
+            return SimpleNamespace(
+                platform=meta.get("platform", ""), chat_id=meta.get("chat_id", ""),
+                chat_type=meta.get("chat_type", ""), thread_id=meta.get("thread_id", ""),
+                user_id=meta.get("user_id", ""), user_name=meta.get("user_name", ""),
+                profile=None,
+            )
+
+        def _session_key_for_source(self, source):
+            return f"{source.platform}:{source.chat_id}"
+
+        _running_agents: set = set()  # idle by default
+
+        def _synthetic_prompt_event(self, source, text, *, internal=False):
+            return SimpleNamespace(text=text, source=source, internal=internal)
+
+        async def _run_in_executor_with_context(self, fn, *args, **kwargs):
+            return fn(*args, **kwargs)
+
+        async def fake_admit_route_wake(self, runner, adapter, source, text, producer, metadata=None):
+            self.wake_calls.append((str((metadata or {}).get("outcome", "")), text))
+            return True
+
+    return Harness()
+
+
+def run(coro):
+    return asyncio.run(coro)
+
+
+def _write_response(request_id: str, choice: str, by: str = "qa"):
+    from tools.deferred_calls import responses_dir
+
+    responses_dir().mkdir(parents=True, exist_ok=True)
+    (responses_dir() / f"{request_id}.json").write_text(
+        json.dumps({"request_id": request_id, "choice": choice, "by": by}), encoding="utf-8"
+    )
+
+
+class TestDeferredScanOne:
+    def test_approval_response_settles_and_wakes_with_approved_text(self, hermes_home):
+        from tools.deferred_calls import list_deferred, record_deferred
+
+        rec = record_deferred(
+            session_key="kanban:b:t1", request_id="rq-ok", tool="terminal",
+            preview="rm -rf build", route=ROUTE, now=time.time(),
+        )
+        _write_response("rq-ok", "once")
+        harness = make_harness()
+        with patch("gateway.session_automation.admit_route_wake", harness.fake_admit_route_wake):
+            run(harness._deferred_scan_one("p1", warned_no_route=set()))
+        assert len(harness.wake_calls) == 1
+        outcome, text = harness.wake_calls[0]
+        assert outcome == "approved"
+        assert "已批准" in text and "rm -rf build" in text
+        assert list_deferred("pending") == []
+        assert list_deferred("approved")[0]["id"] == rec["id"]
+        # 二轮扫描：pending 空，不再唤醒
+        with patch("gateway.session_automation.admit_route_wake", harness.fake_admit_route_wake):
+            run(harness._deferred_scan_one("p1", warned_no_route=set()))
+        assert len(harness.wake_calls) == 1
+
+    def test_deny_response_wakes_with_denied_text(self, hermes_home):
+        from tools.deferred_calls import record_deferred
+
+        record_deferred(
+            session_key="kanban:b:t2", request_id="rq-no", tool="terminal",
+            preview="git push", route=ROUTE, now=time.time(),
+        )
+        _write_response("rq-no", "deny")
+        harness = make_harness()
+        with patch("gateway.session_automation.admit_route_wake", harness.fake_admit_route_wake):
+            run(harness._deferred_scan_one("p1", warned_no_route=set()))
+        outcome, text = harness.wake_calls[0]
+        assert outcome == "denied"
+        assert "拒绝" in text and "不要重试" in text
+
+    def test_expired_record_wakes_once_with_expired_text(self, hermes_home):
+        from tools.deferred_calls import list_deferred, record_deferred
+
+        record_deferred(
+            session_key="kanban:b:t3", request_id="rq-old", tool="terminal",
+            preview="kubectl apply", route=ROUTE, ttl_seconds=60, now=time.time() - 3600,
+        )
+        harness = make_harness()
+        with patch("gateway.session_automation.admit_route_wake", harness.fake_admit_route_wake):
+            run(harness._deferred_scan_one("p1", warned_no_route=set()))
+        outcome, text = harness.wake_calls[0]
+        assert outcome == "expired"
+        assert "超时" in text
+        assert list_deferred("expired")[0]["status"] == "expired"
+        # 二轮：无 pending 无再过期 → 零唤醒
+        with patch("gateway.session_automation.admit_route_wake", harness.fake_admit_route_wake):
+            run(harness._deferred_scan_one("p1", warned_no_route=set()))
+        assert len(harness.wake_calls) == 1
+
+    def test_invalid_choice_response_is_ignored_not_settled(self, hermes_home):
+        from tools.deferred_calls import list_deferred, record_deferred
+
+        record_deferred(
+            session_key="kanban:b:t4", request_id="rq-bad", tool="terminal",
+            preview="x", route=ROUTE, now=time.time(),
+        )
+        _write_response("rq-bad", "maybe")
+        harness = make_harness()
+        with patch("gateway.session_automation.admit_route_wake", harness.fake_admit_route_wake):
+            run(harness._deferred_scan_one("p1", warned_no_route=set()))
+        assert harness.wake_calls == []
+        assert list_deferred("pending")[0]["id"]  # 未被误裁决
+
+    def test_wake_failure_is_logged_not_raised(self, hermes_home):
+        from tools.deferred_calls import record_deferred
+
+        record_deferred(
+            session_key="kanban:b:t5", request_id="rq-err", tool="terminal",
+            preview="y", route=ROUTE, now=time.time(),
+        )
+        _write_response("rq-err", "once")
+        harness = make_harness()
+
+        async def explode(*args, **kwargs):
+            raise RuntimeError("adapters gone")
+
+        with patch("gateway.session_automation.admit_route_wake", explode):
+            run(harness._deferred_scan_one("p1", warned_no_route=set()))  # 不抛
