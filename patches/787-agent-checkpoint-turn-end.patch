+"""Tests for session_checkpoint 轮终写（Always-on Agents P4）。"""
+
+from __future__ import annotations
+
+import os
+import time
+
+import pytest
+
+from agent.session_checkpoint import (
+    maybe_write_turn_end_checkpoint, checkpoint_age_seconds, load_checkpoint,
+)
+
+VALID = """## goal
+Ship the follow-up timer.
+## done
+- Added follow-up store to `agent/session_checkpoint.py:60` (anchor).
+## next
+Run the targeted pytest file.
+## blockers
+none
+## artifacts
+- patches/780-agent-followup-timer.patch
+"""
+
+
+def _writer(system, prompt):
+    return VALID
+
+
+@pytest.fixture(autouse=True)
+def _env(monkeypatch):
+    monkeypatch.setenv("HERMES_SESSION_CHECKPOINT", "1")
+    monkeypatch.setenv("HERMES_SESSION_CHECKPOINT_TURN_END", "1")
+    yield
+
+
+def test_first_turn_end_writes_checkpoint(tmp_path):
+    path = maybe_write_turn_end_checkpoint("t1", 3, final_response="did work", call_fn=_writer, memory_root=tmp_path)
+    assert path is not None and path.exists()
+    text = path.read_text(encoding="utf-8")
+    assert "reason=turn_end" in text.splitlines()[0]
+    sections = load_checkpoint("t1", memory_root=tmp_path)
+    assert sections is not None
+    assert "follow-up" in sections["goal"]
+
+
+def test_throttle_suppresses_second_normal_write(tmp_path):
+    first = maybe_write_turn_end_checkpoint("t1", 1, final_response="a", call_fn=_writer, memory_root=tmp_path)
+    assert first is not None
+    second = maybe_write_turn_end_checkpoint("t1", 2, final_response="b", call_fn=_writer, memory_root=tmp_path)
+    assert second is None
+    # mtime 变老 → 允许再写
+    old = time.time() - 700
+    os.utime(first, (old, old))
+    third = maybe_write_turn_end_checkpoint("t1", 3, final_response="c", call_fn=_writer, memory_root=tmp_path)
+    assert third is not None
+
+
+def test_interrupted_bypasses_throttle(tmp_path):
+    first = maybe_write_turn_end_checkpoint("t1", 1, final_response="a", call_fn=_writer, memory_root=tmp_path)
+    assert first is not None
+    second = maybe_write_turn_end_checkpoint(
+        "t1", 2, interrupted=True, final_response="stopped", call_fn=_writer, memory_root=tmp_path,
+    )
+    assert second is not None
+    assert "reason=interrupted" in second.read_text(encoding="utf-8").splitlines()[0]
+
+
+def test_env_switch_disables(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_SESSION_CHECKPOINT_TURN_END", "off")
+    assert maybe_write_turn_end_checkpoint("t1", 1, final_response="a", call_fn=_writer, memory_root=tmp_path) is None
+
+
+def test_age_none_when_missing(tmp_path):
+    assert checkpoint_age_seconds("absent", memory_root=tmp_path) is None
