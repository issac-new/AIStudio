+# Always-on Agents P4（2026-11-16）：轮终也写 checkpoint（不只预算触顶）。
+# 节流：同一 task 10 分钟内不重复写（写手是 LLM 调用）；中断不受节流（用户主动停止
+# 时状态最需要落盘）。
+TURN_END_THROTTLE_SECONDS = 600
+
+
+def turn_end_checkpoint_enabled() -> bool:
+    return os.environ.get("HERMES_SESSION_CHECKPOINT_TURN_END", "1").strip().lower() not in (
+        "0", "false", "off", "no",
+    )
+
+
+def checkpoint_age_seconds(task_id: str, memory_root: Optional[Path] = None) -> Optional[float]:
+    """现有 checkpoint 的年龄（秒）；文件缺席/不可读返回 None。"""
+    path = checkpoints_dir(memory_root) / f"{task_id}.md"
+    try:
+        return max(0.0, time.time() - path.stat().st_mtime)
+    except OSError:
+        return None
+
+
+def maybe_write_turn_end_checkpoint(
+    task_id: str,
+    generation: int,
+    *,
+    interrupted: bool = False,
+    final_response: str = "",
+    call_fn: Optional[Callable[[str, str], str]] = None,
+    memory_root: Optional[Path] = None,
+) -> Optional[Path]:
+    """轮终写 checkpoint（P4）：首次立即写；正常轮终 10 分钟节流；中断绕过节流。
+
+    只做状态面（不改任务状态/不派发 next）；写手故障走 write_checkpoint 兜底，
+    绝不阻断收尾链。返回写入路径或 None（关闭/节流/失败）。
+    """
+    if not checkpoint_enabled() or not turn_end_checkpoint_enabled() or not task_id:
+        return None
+    if not interrupted:
+        age = checkpoint_age_seconds(task_id, memory_root)
+        if age is not None and age < TURN_END_THROTTLE_SECONDS:
+            return None
+    reason = "interrupted" if interrupted else "turn_end"
+    digest = (final_response or "").strip()
+    if not digest:
+        digest = "(回合在最终回复前结束/中断)" if interrupted else "(回合无最终回复文本)"
+    return write_checkpoint(
+        task_id,
+        generation,
+        reason=reason,
+        goal_hint=f"kanban task {task_id}",
+        trajectory_digest=digest[:1200],
+        call_fn=call_fn,
+        memory_root=memory_root,
+    )
+
+
 def checkpoints_dir(memory_root: Optional[Path] = None) -> Path:
     if memory_root is not None:
         return Path(memory_root) / "checkpoints"
