+# SwarmStudio base runtime: exa (code-specialized external search MCP).
+# Single source of truth — injected into hermes-agent optional-mcps/exa/ by patch 396（原 384，撞号重编）.
+# Consumed by the studio MCP catalog browser and `hermes mcp install exa`.
+# Rationale: MiMo-Code ships a codesearch tool on the Exa Code API; hermes web_search
+# is generic — this gives coding agents a dedicated SDK/library/API research channel
+# (2026-09-24 MiMo research P9).
+manifest_version: 1
+
+name: exa
+description: Exa neural web search and code research — web search, crawling, and multi-step research tuned for libraries, SDKs, and API references.
+source: https://github.com/exa-labs/exa-mcp-server
+
+# Official exa-labs npm server, spawned locally via npx (no vendor-hosted URL;
+# mcp_security intentionally allows npx/uvx commands).
+# 版本锁定 exa-mcp-server@3.4.1（npm latest，2026-09-25 registry.npmjs.org 实测）：
+# 不锁版本时每次启动解析 npm latest 并携带 EXA_API_KEY 运行任意新代码（供应链面）。
+# EXA_API_KEY 的凭据声明在 auth.env（安装期提示并存入 profile 的 .env）；
+# transport.env 只放 ${EXA_API_KEY} 引用、不落明文。保留该引用是对
+# mcp_catalog.py TransportSpec.env "NOT for secrets" 注释的有注偏离：stdio 子进程
+# 环境只认 server config 的 env 映射（tools/mcp_tool_transport.py 的
+# _build_safe_env(config.get("env"))），.env 值不经该映射进不了子进程。
+transport:
+  type: stdio
+  command: npx
+  args:
+    - "-y"
+    - exa-mcp-server@3.4.1
+  version: "3.4.1"
+  env:
+    EXA_API_KEY: "${EXA_API_KEY}"
+
+auth:
+  type: api_key
+  env:
+    - name: EXA_API_KEY
+      prompt: "Exa API key (create one at dashboard.exa.ai → API keys)"
+
+# Composer-suggestion triggers (desktop brand pills).
+suggest:
+  keywords:
+    - exa
+    - code search
+    - library research
+  hosts:
+    - exa.ai
+
+post_install: |
+  Create an API key at dashboard.exa.ai/api-keys and paste it when
+  prompted (it is stored in the profile's .env; config.yaml only ever
+  carries the ${EXA_API_KEY} reference). Restart the session so tools
+  load. Search usage is metered against your Exa account.
