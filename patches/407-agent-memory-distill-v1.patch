+"""记忆自动沉淀 v1 守门（mimo P4 二期：规则式 distill——去重/容量剪枝/报告）。"""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+_WORKTREE = Path(__file__).resolve().parents[2]
+if str(_WORKTREE) not in sys.path:
+    sys.path.insert(0, str(_WORKTREE))
+
+from tools.memory_consolidate import distill_pass  # noqa: E402
+from tools.memory_tool_store import MemoryStore  # noqa: E402
+
+
+class TestDistill:
+    def test_dedup_normalized(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        store = MemoryStore(memory_char_limit=2000)
+        store.memory_entries = [
+            "登录页 token  持久化方案",   # 双空格
+            "登录页 token 持久化方案",    # 归一化后重复 → 合并
+            "编译缓存命中优化",
+        ]
+        r = distill_pass(store)
+        assert r.merged == 1 and len(store.memory_entries) == 2
+        assert "登录页" in store.memory_entries[0]
+
+    def test_capacity_prune_oldest_first_only_when_over_line(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        store = MemoryStore(memory_char_limit=100)
+        store.memory_entries = ["x" * 30, "y" * 30, "z" * 30]  # 90 ≤ 90 线下 → 不剪
+        r = distill_pass(store)
+        assert r.pruned == 0 and len(store.memory_entries) == 3
+        store.memory_entries = ["x" * 40, "y" * 40, "z" * 40]  # 120 > 90 → 剪最旧
+        r = distill_pass(store)
+        assert r.pruned == 1 and store.memory_entries[0] == "y" * 40
+
+    def test_report_and_action_surface(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        from tools import memory_tool as mt
+        store = MemoryStore()
+        store.memory_entries = ["a", "a", "b"]
+        out = json.loads(mt.memory_tool("consolidate", store=store))
+        assert out["success"] is True and out["merged"] == 1
+        assert out["entries_after"] == 2
+        unknown = json.loads(mt.memory_tool("explode", store=store))
+        assert "consolidate" in unknown.get("error", "")
