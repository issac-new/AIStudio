+export function parseProjectListTable(stdout: string): KanbanProject[] {
+  const out: KanbanProject[] = []
+  for (const line of stdout.split('\n')) {
+    const m = line.match(/^([* ])\s+(\S+)\s+(.*?)(?:\s+\(archived\))?\s+\[\d+ folder\(s\)\]\s*$/)
