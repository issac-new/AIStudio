+// 同步上传的附件到任务 workspace 目录（若任务有 workspace_path），便于 agent 直接读取
+async function syncAttachmentToWorkspace(taskId: string, board: string | undefined, filename: string, srcPath: string): Promise<void> {
+  try {
+    const detail = await kanbanCli.getTask(taskId, { board: board || 'default' })
+    const wsPath = detail?.task?.workspace_path
+    if (!wsPath) return // 任务无 workspace，跳过
+    const kanbanHome = resolve(homedir(), '.hermes', 'kanban')
+    const workspacesRoot = (!board || board === 'default')
+      ? resolve(kanbanHome, 'workspaces')
+      : resolve(kanbanHome, 'boards', board, 'workspaces')
+    const root = resolve(workspacesRoot, normalize(wsPath))
+    if (!isPathWithin(root, workspacesRoot)) return // 越界，静默跳过
+    await mkdir(root, { recursive: true })
+    await copyFile(srcPath, join(root, filename)).catch(() => {})
+  } catch { /* workspace 同步失败不影响上传主流程 */ }
+}
+
+// 删除附件时同步从任务 workspace 目录移除对应文件（与 syncAttachmentToWorkspace 对称）
+async function removeAttachmentFromWorkspace(taskId: string, board: string | undefined, filename: string): Promise<void> {
+  try {
+    const detail = await kanbanCli.getTask(taskId, { board: board || 'default' })
+    const wsPath = detail?.task?.workspace_path
+    if (!wsPath) return
+    const kanbanHome = resolve(homedir(), '.hermes', 'kanban')
+    const workspacesRoot = (!board || board === 'default')
+      ? resolve(kanbanHome, 'workspaces')
+      : resolve(kanbanHome, 'boards', board, 'workspaces')
+    const root = resolve(workspacesRoot, normalize(wsPath))
+    if (!isPathWithin(root, workspacesRoot)) return
+    await unlink(join(root, filename)).catch(() => {})
+  } catch { /* workspace 删除失败不影响主流程 */ }
+}
