+}
+
+function zoomIn(): void {
+  clampScale(scale.value * 1.25)
+}
+
+function zoomOut(): void {
+  clampScale(scale.value / 1.25)
+}
+
+function guessName(url: string): string {
+  if (props.downloadName) return props.downloadName
+  const m = url.match(/([^/?#]+)(?:[?#].*)?$/)
