+}
+
+function download(): void {
+  const a = document.createElement('a')
+  a.href = currentSrc.value
+  a.download = guessName(currentSrc.value)
+  document.body.appendChild(a)
+  a.click()
+  a.remove()
+}
+
 function handleKeydown(event: KeyboardEvent) {
