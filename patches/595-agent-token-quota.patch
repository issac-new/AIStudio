+class QuotaExceededError(RuntimeError):
+    """Profile token quota exhausted — raised at turn entry so callers surface it."""
+
+
+def _profile_token_quota_denial(agent) -> Optional[str]:
+    try:
+        from hermes_constants import get_hermes_home
+        from pathlib import Path as _P
+
+        qfile = _P(get_hermes_home()) / "token-quota.txt"
+        try:
+            cap = int(qfile.read_text(encoding="utf-8").strip())
+        except (OSError, ValueError):
+            return None
+        if cap <= 0:
+            return None
+        db = getattr(agent, "_get_session_db_for_recall", lambda: None)()
+        if db is None:
+            return None
+        used = int(db.usage_totals().get("tokens", 0))
+        if used >= cap:
+            return (
+                f"Token quota exhausted for this profile: used {used:,} / cap {cap:,} "
+                "(HERMES_HOME/token-quota.txt). Raise the cap or start a fresh profile."
+            )
+        if used >= cap * 0.9:
+            logger.warning("Token quota %.0f%% consumed (%s / %s)", used * 100.0 / cap, used, cap)
+        return None
+    except Exception:
+        return None
 
 
