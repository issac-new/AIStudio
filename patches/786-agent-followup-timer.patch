+class TestHandler:
+    def test_create_list_cancel(self, hermes_home):
+        from tools.followup_tool import _handler
+
+        with patch("hermes_cli.followups.capture_route", return_value=ROUTE):
+            created = json.loads(_handler({"action": "create", "prompt": "ping", "delay": "30m"},
+                                          session_id="sess-1"))
+        assert created["success"] is True
+        fid = created["id"]
+
+        listed = json.loads(_handler({"action": "list"}, session_id="sess-1"))
+        assert listed["count"] == 1
+        assert listed["followups"][0]["id"] == fid
+
+        cancelled = json.loads(_handler({"action": "cancel", "id": fid}, session_id="sess-1"))
+        assert cancelled["success"] is True
+
+        listed2 = json.loads(_handler({"action": "list"}, session_id="sess-1"))
+        assert listed2["followups"][0]["status"] == "cancelled"
+
+    def test_create_without_route_fails_closed(self, hermes_home):
