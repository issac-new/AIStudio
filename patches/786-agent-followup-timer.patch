+        assert out["success"] is False
+        assert "路由" in out["error"] or "cronjob" in out["error"]
+
+    def test_missing_session_fails(self):
+        from tools.followup_tool import _handler
+
+        out = json.loads(_handler({"action": "list"}, session_id=""))
+        assert out["success"] is False
+
+    def test_unknown_action(self, hermes_home):
+        from tools.followup_tool import _handler
+
+        out = json.loads(_handler({"action": "explode"}, session_id="s"))
+        assert out["success"] is False
