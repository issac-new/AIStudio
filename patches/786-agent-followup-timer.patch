+"""Tests for hermes_cli/followups.py — agent self-set follow-up timers (Always-on P3)."""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def hermes_home(tmp_path, monkeypatch):
+    """Isolated HERMES_HOME so SessionDB.state_meta writes don't clobber the real one."""
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    from hermes_cli import goals
+
+    goals._DB_CACHE.clear()
+    yield home
+    goals._DB_CACHE.clear()
+
+
+ROUTE = {"platform": "telegram", "chat_id": "42", "chat_type": "dm", "user_id": "u1"}
+
+
+class TestCreateAndList:
+    def test_create_persists_and_lists(self, hermes_home):
+        from hermes_cli.followups import create_followup, list_followups
+
+        now = 1_000_000.0
+        st = create_followup("sess-1", "check the reply", 3600, ROUTE, now=now)
+        assert st.status == "active"
+        assert st.due_at == now + 3600
+        rows = list_followups("sess-1")
+        assert [r.id for r in rows] == [st.id]
+        assert rows[0].route["platform"] == "telegram"
+
+    def test_rejects_bad_input(self, hermes_home):
+        from hermes_cli.followups import create_followup
+
+        with pytest.raises(ValueError):
+            create_followup("s", "p", 30, ROUTE)  # < 60s
+        with pytest.raises(ValueError):
+            create_followup("s", "p", 31 * 86400, ROUTE)  # > 30d
+        with pytest.raises(ValueError):
+            create_followup("s", "", 60, ROUTE)
+        with pytest.raises(ValueError):
+            create_followup("s", "p", 60, None)  # no route
+
+    def test_per_session_cap(self, hermes_home):
+        from hermes_cli.followups import MAX_ACTIVE_PER_SESSION, create_followup
+
+        for i in range(MAX_ACTIVE_PER_SESSION):
+            create_followup("s", f"p{i}", 60, ROUTE)
+        with pytest.raises(ValueError):
+            create_followup("s", "one-too-many", 60, ROUTE)
+
+
+class TestDueAndFiring:
+    def test_list_due_filters_status_and_time(self, hermes_home):
+        from hermes_cli.followups import create_followup, list_due_followups, mark_fired
+
+        a = create_followup("s", "a", 60, ROUTE, now=1000)
+        b = create_followup("s", "b", 600, ROUTE, now=1000)
+        assert [x.id for x in list_due_followups(now=1100)] == [a.id]
+        assert {x.id for x in list_due_followups(now=2000)} == {a.id, b.id}
+        mark_fired(a.id, now=1101)
+        assert [x.id for x in list_due_followups(now=2000)] == [b.id]
+
+    def test_claim_is_one_shot(self, hermes_home):
+        from hermes_cli.followups import claim_followup, create_followup
+
+        st = create_followup("s", "p", 60, ROUTE, now=1000)
+        first = claim_followup(st.id)
+        assert first is not None and first.status == "firing" and first.attempts == 1
+        assert claim_followup(st.id) is None  # already firing
+
+    def test_release_retries_then_fails(self, hermes_home):
+        from hermes_cli.followups import claim_followup, create_followup, release_followup
+
+        st = create_followup("s", "p", 60, ROUTE, now=1000)
+        for expected in (1, 2):
+            claimed = claim_followup(st.id)
+            assert claimed is not None and claimed.attempts == expected
+            released = release_followup(st.id, "boom")
+            assert released is not None and released.status == "active"
+        claimed = claim_followup(st.id)
+        assert claimed is not None and claimed.attempts == 3
+        failed = release_followup(st.id, "boom")
+        assert failed is not None and failed.status == "failed"
+
+    def test_recover_stale_firing(self, hermes_home):
+        from hermes_cli.followups import claim_followup, create_followup, recover_stale_firing
+
+        st = create_followup("s", "p", 60, ROUTE, now=1000)
+        claim_followup(st.id)
+        # due_at=1060; at 1100 it is only 40s stale → untouched
+        assert recover_stale_firing(now=1100) == 0
+        # at 2000 it is 940s stale → reset to active
+        assert recover_stale_firing(now=2000) == 1
+
+
+class TestCancel:
+    def test_cancel_requires_owner_and_terminal_semantics(self, hermes_home):
+        from hermes_cli.followups import cancel_followup, create_followup, list_followups
+
+        st = create_followup("s", "p", 60, ROUTE)
+        assert cancel_followup(st.id, session_id="other") is False
+        assert cancel_followup(st.id, session_id="s") is True
+        assert cancel_followup(st.id, session_id="s") is False  # terminal
+        assert list_followups("s")[0].status == "cancelled"
