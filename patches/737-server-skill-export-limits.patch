+/** GET /api/hermes/skills/:category/:skill/export — 技能目录实时打包为 ZIP 下载（736）。
+ *  来源策略：builtin/hub/local 可导出；external（external_dirs 只读挂载）403——
+ *  getSkillSource 只产 builtin/hub/local 三值，external 判定等价于「解析出的目录
+ *  不在本仓技能树内」（isPathWithin），可能是他人版权资产，导出即再分发。 */
+export async function exportSkill(ctx: any) {
+  const { category } = ctx.params
+  const name = String((ctx.params as any)?.skill || '')
+  try {
+    const skillsDir = requestTargetSkillsDir(ctx)
+    const skillDir = await resolveSkillDirForTarget(ctx, category, name)
+    if (!skillDir) {
+      ctx.status = 404
+      ctx.body = { error: 'Skill not found' }
+      return
+    }
+    if (!isPathWithin(skillDir, skillsDir)) {
+      ctx.status = 403
+      ctx.body = { error: 'External skills (read-only mounted directories) cannot be exported' }
+      return
+    }
+    // 打包前先量体：超限直接 413，不把大目录读进内存（实时打包不缓存，技能可变）
+    let totalBytes = 0
+    for (const f of await listFilesRecursive(skillDir, '')) {
+      totalBytes += (await stat(join(skillDir, f.path))).size
+      if (totalBytes > MAX_SKILL_EXPORT_SIZE) {
+        ctx.status = 413
+        ctx.body = { error: `Skill directory too large to export (max ${MAX_SKILL_EXPORT_SIZE / 1024 / 1024}MB)` }
+        return
+      }
+    }
+    const zip = new AdmZip()
+    zip.addLocalFolder(skillDir, name)
+    ctx.type = 'application/zip'
+    ctx.attachment(`${name.replace(/[<>:"/\\|?*\x00-\x1f]/g, '_')}.zip`)
+    ctx.set('Cache-Control', 'no-store')
+    ctx.body = await zip.toBufferPromise()
+  } catch (err: any) {
+    ctx.status = 500
+    ctx.body = { error: err.message }
+  }
+}
