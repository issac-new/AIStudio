+/** 导出技能 ZIP（736）：带鉴权 fetch→blob（照 api/studio/theme.ts exportThemeArchive
+ *  形态）；鉴权头照本文件 importSkill（Authorization + X-Hermes-Profile）。 */
+export async function exportSkillZip(category: string, skill: string, target: SkillTarget = 'hermes'): Promise<Blob> {
+  await ensureDesktopAuthReady()
+  const headers = new Headers()
+  const token = getApiKey()
+  if (token) headers.set('Authorization', `Bearer ${token}`)
+  const profile = getActiveProfileName()
+  if (profile) headers.set('X-Hermes-Profile', profile)
+  const c = encodeURIComponent(category)
+  const s = encodeURIComponent(skill)
+  const response = await fetch(`${getBaseUrlValue()}/api/hermes/skills/${c}/${s}/export${targetQuery(target)}`, { headers })
+  if (!response.ok) throw new Error(`Failed to export skill (${response.status})`)
+  return response.blob()
+}
