+// ── SwarmStudio deep link（swarmstudio://）+ dock badge（overlay 537，2026-10-01
+//    吸收批 #8：element-web protocol.ts/badge.ts 吸收）──
+// 安全口径同 element-web：深链只接受白名单路径（/app 树与 /matrix），query 透传、
+// fragment 透传，其余静默丢弃；badge 仅 darwin（app.badgeCount），其它平台记 debug。
+const DEEP_LINK_SCHEME = 'swarmstudio'
+const DEEP_LINK_PATH_ALLOWLIST = /^\/(app(\/|$)|matrix(\/|$))/
+
+function handleDeepLink(rawUrl: string): void {
+  try {
+    const parsed = new URL(rawUrl)
+    if (parsed.protocol !== `${DEEP_LINK_SCHEME}:`) return
+    const target = `${parsed.pathname}${parsed.search}`
+    if (!DEEP_LINK_PATH_ALLOWLIST.test(target)) {
+      console.warn('[deep-link] rejected non-allowlisted path:', target)
+      return
+    }
+    if (!mainWindow || mainWindow.isDestroyed()) return
+    showMainWindow()
+    void mainWindow.webContents
+      .executeJavaScript(`window.location.hash = ${JSON.stringify(`#${target}`)}`)
+      .catch(error => console.warn('[deep-link] navigation failed:', error))
+  } catch (error) {
+    console.warn('[deep-link] unparseable url:', rawUrl, error)
+  }
+}
+
+function findDeepLinkArg(argv: readonly string[]): string | null {
+  for (const arg of argv) {
+    if (arg.startsWith(`${DEEP_LINK_SCHEME}://`)) return arg
+  }
+  return null
+}
+
+ipcMain.handle('hermes-desktop:set-badge-count', (_event, rawCount?: unknown) => {
+  const n = typeof rawCount === 'number' && Number.isFinite(rawCount) && rawCount > 0 ? Math.floor(rawCount) : 0
+  if (process.platform === 'darwin') {
+    app.badgeCount = n
+    return true
+  }
+  // Windows/Linux overlay 图标需要 renderer 侧画布配合（element-web favicon 管线），
+  // 本层先行提供通道；未支持平台如实返回 false，renderer 不做假呈现。
+  return false
+})
+
 function quitApp() {
   appLifecycle.quit()
 }
