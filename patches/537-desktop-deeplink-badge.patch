+// overlay[wm]: 驾驶舱操作页弹出独立窗口（2026-09-18 统一导航 /goal 追加）。
+// 与 openChatWindow 同模式（preload + window-kind 标记 + 去重聚焦），key = 路由
+// 路径含 query（渲染侧已带 standalone=1，独立窗口据此渲染精简壳）。
+function normalizePanelRoutePath(value: unknown): string | null {
+  if (typeof value !== 'string') return null
+  const trimmed = value.trim()
+  if (!trimmed.startsWith('/') || trimmed.length > 1024) return null
+  if (/[\u0000-\u001f\u007f]/.test(trimmed)) return null
+  // 仅允许应用内 hash 路由字符（含 query），拒绝协议/外部 URL 注入
+  if (!/^\/[A-Za-z0-9\-._~!$&'()*+,;=:@%/?]*$/.test(trimmed)) return null
+  return trimmed
+}
+
+async function openPanelWindow(
+  routePathInput: unknown,
+  sizeInput?: unknown,
+): Promise<void> {
+  const routePath = normalizePanelRoutePath(routePathInput)
+  if (!routePath) throw new Error('Invalid panel route path')
+
+  const size =
+    sizeInput && typeof sizeInput === 'object'
+      ? (sizeInput as { width?: unknown; height?: unknown })
+      : {}
+  const width = typeof size.width === 'number' && size.width >= 480 && size.width <= 3840 ? Math.round(size.width) : 1100
+  const height = typeof size.height === 'number' && size.height >= 360 && size.height <= 2160 ? Math.round(size.height) : 720
+
+  const existing = panelWindows.get(routePath)
+  if (existing && !existing.isDestroyed()) {
+    if (existing.isMinimized()) existing.restore()
+    existing.show()
+    existing.focus()
+    return
+  }
+
+  const url = webUiHashUrl(routePath)
+  if (!url) throw new Error('Desktop Web UI is not ready')
+
+  const panelWindow = new BrowserWindow({
+    width,
+    height,
+    minWidth: 480,
+    minHeight: 360,
+    title: 'SwarmStudio',
+    backgroundColor: '#1a1a1a',
+    autoHideMenuBar: true,
+    show: false,
+    ...(process.platform === 'darwin'
+      ? {
+          titleBarStyle: 'hiddenInset' as const,
+          trafficLightPosition: { x: 20, y: 12 },
+        }
+      : process.platform === 'win32'
+        ? {
+            titleBarStyle: 'hidden' as const,
+            titleBarOverlay: { height: 40 },
+          }
+        : {}),
+    ...(process.platform === 'linux' ? { icon: desktopIcon() } : {}),
+    webPreferences: {
+      preload: join(__dirname, '..', 'preload', 'index.js'),
+      contextIsolation: true,
+      nodeIntegration: false,
+      sandbox: true,
+      additionalArguments: ['--hermes-window-kind=panel'],
+    },
+  })
+  panelWindows.set(routePath, panelWindow)
+
+  panelWindow.once('ready-to-show', () => {
+    if (panelWindow.isDestroyed()) return
+    panelWindow.show()
+    panelWindow.focus()
+  })
+  panelWindow.on('maximize', () => notifyWindowStateChanged(panelWindow))
+  panelWindow.on('unmaximize', () => notifyWindowStateChanged(panelWindow))
+  panelWindow.on('restore', () => notifyWindowStateChanged(panelWindow))
+  panelWindow.on('closed', () => {
+    if (panelWindows.get(routePath) === panelWindow) panelWindows.delete(routePath)
+  })
+
+  installSelectionContextMenu(panelWindow)
+  panelWindow.webContents.setWindowOpenHandler(({ url: targetUrl, frameName }) => {
+    const agentLinkPopup = groupChatAgentLinkPopupResponse(targetUrl, frameName)
+    if (agentLinkPopup) return agentLinkPopup
+    if (isTrustedDesktopAppUrl(targetUrl, serverUrl)) {
+      return { action: 'allow' }
+    }
+    shell.openExternal(targetUrl).catch(() => undefined)
+    return { action: 'deny' }
+  })
+
+  await panelWindow.loadURL(url)
+}
