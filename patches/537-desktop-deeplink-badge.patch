       quitApp()
       return
     }
+    // Windows/Linux 深链入口：second-instance 尾参携带 swarmstudio:// URL
+    const deepLink = findDeepLinkArg(argv)
+    if (deepLink) {
+      handleDeepLink(deepLink)
+      return
+    }
     showMainWindow()
   })
 
+  // macOS 深链入口（open-url 在 whenReady 前后均可能到达，注册放锁之后）
+  app.on('open-url', (event, url) => {
+    event.preventDefault()
+    handleDeepLink(url)
+  })
+
   app.whenReady().then(async () => {
     if (QUIT_EXISTING) {
       quitApp()
@@ -1473,6 +1529,14 @@ function runDesktopApp() {
