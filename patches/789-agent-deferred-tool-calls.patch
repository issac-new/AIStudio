+"""Tests for approval defer-on-timeout wiring (Always-on P6)."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    h = tmp_path / ".hermes"
+    h.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(h))
+    yield h
+
+
+def _should_defer(config_value, kanban=False, cron=False):
+    from tools import approval
+
+    with patch("tools.approval.approval_context._get_approval_config",
+               return_value={"defer_on_timeout": config_value} if config_value is not None else {}):
+        with patch.dict("os.environ", {
+            **({"HERMES_KANBAN_TASK": "t1"} if kanban else {}),
+            **({"HERMES_CRON_SESSION": "1"} if cron else {}),
+        }, clear=False):
+            if not kanban:
+                import os
+                os.environ.pop("HERMES_KANBAN_TASK", None)
+            if not cron:
+                import os
+                os.environ.pop("HERMES_CRON_SESSION", None)
+            return approval._should_defer_approval()
+
+
+class TestShouldDefer:
+    def test_unattended_default_kanban(self):
+        assert _should_defer(None, kanban=True) is True
+
+    def test_unattended_default_cron(self):
+        assert _should_defer(None, cron=True) is True
+
+    def test_unattended_default_interactive(self):
+        assert _should_defer(None) is False
+
+    def test_always(self):
+        assert _should_defer("always") is True
+
+    def test_never(self):
+        assert _should_defer("never", kanban=True) is False
+
+
+class TestDeferredResult:
+    def test_result_carries_marker_and_ids(self):
+        from tools.approval import _deferred_approval_result
+
+        class Spec:
+            noun = "command"
+
+        result = _deferred_approval_result(
+            Spec, pattern_key="rm:*", command="rm -rf build", description="destructive",
+            deferred={"id": "d1", "request_id": "rq1"},
+        )
+        assert result["deferred"] is True
+        assert result["status"] == "deferred_approval"
+        assert result["deferred_id"] == "d1"
+        assert "[deferred_tool_call:d1]" in result["message"]
+
+    def test_record_uses_captured_route(self, home):
+        from tools.approval import _record_deferred_approval
+        from tools.deferred_calls import list_deferred
+
+        with patch("hermes_cli.followups.capture_route",
+                   return_value={"platform": "matrix", "chat_id": "room1"}):
+            rec = _record_deferred_approval(
+                session_key="kanban:b:t1", request_id="rq1", tool="terminal",
+                preview="rm -rf build", risk="destructive",
+            )
+        assert rec is not None
+        rows = list_deferred("pending")
+        assert rows[0]["id"] == rec["id"]
+        assert rows[0]["route"]["platform"] == "matrix"
+
+    def test_record_without_route_returns_none(self, home):
+        from tools.approval import _record_deferred_approval
+
+        with patch("hermes_cli.followups.capture_route", return_value=None):
+            assert _record_deferred_approval(
+                session_key="s", request_id="rq", tool="t", preview="p", risk="r",
+            ) is None
