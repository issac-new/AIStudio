+++ b/tests/tools/test_deferred_calls.py
@@ -0,0 +1,73 @@
+"""Tests for tools/deferred_calls.py — deferred approval ledger (Always-on P6)."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    h = tmp_path / ".hermes"
+    h.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(h))
+    yield h
+
+
+def test_record_and_list(home):
+    from tools.deferred_calls import deferred_file, deferred_marker, list_deferred, record_deferred
+
+    rec = record_deferred(
+        session_key="kanban:board:t1", session_id="s1", request_id="rq1",
+        tool="terminal", preview="rm -rf build", risk="high",
+        route={"platform": "matrix", "chat_id": "room1"}, now=1000,
+    )
+    assert rec["status"] == "pending"
+    assert rec["expires_at"] == 1000 + 24 * 3600
+    assert deferred_file().exists()
+    assert [r["id"] for r in list_deferred("pending")] == [rec["id"]]
+    assert deferred_marker(rec["id"]) == f"[deferred_tool_call:{rec['id']}]"
+    raw = json.loads(deferred_file().read_text(encoding="utf-8"))
+    assert raw[0]["route"]["platform"] == "matrix"
+
+
+def test_settle_first_wins(home):
+    from tools.deferred_calls import list_deferred, record_deferred, settle_deferred
+
+    rec = record_deferred(session_key="s", request_id="rq", tool="t", now=1000)
+    settled = settle_deferred(rec["id"], "once", now=1001, by="alice")
+    assert settled is not None and settled["status"] == "approved" and settled["decision"] == "once"
+    assert settle_deferred(rec["id"], "deny", now=1002) is None  # already settled
+    assert list_deferred("pending") == []
+
+
+def test_settle_deny_and_invalid_choice(home):
+    from tools.deferred_calls import record_deferred, settle_deferred
+
+    rec = record_deferred(session_key="s", request_id="rq", tool="t")
+    assert settle_deferred(rec["id"], "maybe") is None
+    settled = settle_deferred(rec["id"], "deny")
+    assert settled is not None and settled["status"] == "denied"
+
+
+def test_expire(home):
+    from tools.deferred_calls import expire_deferred, record_deferred
+
+    rec = record_deferred(session_key="s", request_id="rq", tool="t", ttl_seconds=60, now=1000)
+    assert expire_deferred(now=1059) == []
+    expired = expire_deferred(now=1061)
+    assert [r["id"] for r in expired] == [rec["id"]]
+    assert expired[0]["status"] == "expired"
+
+
+def test_read_response(home):
+    from tools.deferred_calls import read_response, responses_dir
+
+    responses_dir().mkdir(parents=True, exist_ok=True)
+    (responses_dir() / "rq9.json").write_text(json.dumps({"request_id": "rq9", "choice": "deny"}), encoding="utf-8")
+    assert read_response("rq9") == {"request_id": "rq9", "choice": "deny"}
+    assert read_response("missing") is None
+    (responses_dir() / "bad.json").write_text("{oops", encoding="utf-8")
+    assert read_response("bad") is None
