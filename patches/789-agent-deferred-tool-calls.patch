+++ b/tests/agent/test_turn_tool_round_deferred.py
@@ -0,0 +1,41 @@
+"""Tests for the deferred-tool-call batch detector (Always-on P6)."""
+
+from __future__ import annotations
+
+from agent.turn_tool_round import _detect_deferred_tool_call
+
+
+def _tool(content):
+    return {"role": "tool", "content": content}
+
+
+def _assistant():
+    return {"role": "assistant", "content": "", "tool_calls": []}
+
+
+def test_detects_marker_in_current_batch():
+    messages = [
+        {"role": "user", "content": "do it"},
+        _assistant(),
+        _tool('{"status":"deferred_approval","message":"... [deferred_tool_call:abc123]"}'),
+    ]
+    assert _detect_deferred_tool_call(messages) == "abc123"
+
+
+def test_marker_before_assistant_boundary_is_ignored():
+    messages = [
+        _tool("old [deferred_tool_call:old1]"),
+        _assistant(),
+        _tool("plain result"),
+    ]
+    assert _detect_deferred_tool_call(messages) is None
+
+
+def test_no_marker():
+    messages = [_assistant(), _tool("ok"), _tool("done")]
+    assert _detect_deferred_tool_call(messages) is None
+
+
+def test_non_dict_messages_ignored():
+    messages = [None, "junk", _assistant(), _tool("x [deferred_tool_call:id9]")]
+    assert _detect_deferred_tool_call(messages) == "id9"
diff --git a/tools/approval.py b/tools/approval.py
--- a/tools/approval.py
+++ b/tools/approval.py
@@ -609,8 +609,71 @@
     key = f"approval.summary.{outcome}" if outcome in _USER_SUMMARY_OUTCOMES else "approval.summary.default"
     noun_text = t(f"approval.noun.{noun}") if noun in _USER_SUMMARY_NOUNS else noun
     return t(key, noun=noun_text, window=window)
+
 
+def _should_defer_approval() -> bool:
+    """P6：超时是否改为延迟调用。approvals.defer_on_timeout = unattended(缺省)|always|never。
 
+    unattended 只看「无人在场」信号：kanban worker 与 cron 会话。交互会话/桌面端保持
+    fail-closed deny（有人在场时阻塞等待是正确体验，D10）。"""
+    try:
+        raw = str(approval_context._get_approval_config().get("defer_on_timeout", "unattended")).strip().lower()
+    except Exception:
+        raw = "unattended"
+    if raw == "never":
+        return False
+    if raw == "always":
+        return True
+    return bool(os.environ.get("HERMES_KANBAN_TASK") or os.environ.get("HERMES_CRON_SESSION"))
+
+
+def _record_deferred_approval(*, session_key: str, request_id: str, tool: str,
+                              preview: str, risk: str):
+    """落 deferred.json；路由从当前回合环境捕获（无路由=唤醒不了，返回 None）。"""
+    try:
+        from hermes_cli.followups import capture_route
+        from tools.deferred_calls import record_deferred
+
+        route = capture_route()
+        if not route:
+            return None
+        session_id = approval_context._session_env("HERMES_SESSION_ID") or ""
