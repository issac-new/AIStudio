+def _detect_deferred_tool_call(messages: Any) -> Optional[str]:
+    """扫本批工具结果里的延迟调用机器标记（Always-on P6）。
+
+    只扫到最近一条 assistant 消息为止（本批 staged 的 tool-call 行），不翻历史——
+    历史里的旧挂起不应结束新回合。
+    """
+    import re
+
+    for message in reversed(list(messages or [])):
+        if not isinstance(message, dict):
+            continue
+        role = message.get("role")
+        if role == "assistant":
+            break
+        if role != "tool":
+            continue
+        match = re.search(r"\[deferred_tool_call:([A-Za-z0-9_-]+)\]", str(message.get("content") or ""))
+        if match:
+            return match.group(1)
+    return None
+
