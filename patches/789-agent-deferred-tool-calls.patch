+++ b/tools/deferred_calls.py
@@ -0,0 +1,170 @@
+"""延迟工具调用持久账本（Always-on Agents P6，2026-11-16）。
+
+语义来源（Anthropic《Building always-on agents》权限·Deferred tool calls）：需要用户
+确认的工具调用不再原地阻塞——结束本轮、把请求落盘、用户回复作为新事件唤醒会话继续。
+
+契约：
+- 记录落 ``<HERMES_HOME>/approvals/deferred.json``（JSON 数组，原子写，环形 200）；
+- 用户答复走既有 studio-file-approval 协议：``responses/<request_id>.json``
+  （``{request_id, choice: once|session|always|deny, by?}``）；
+- 网关 watcher（``gateway/run_deferred.py``）轮询答复文件，settle 后向原会话注入
+  「用户已答复」事件；
+- 超时（缺省 24h）转 ``expired``，watcher 唤醒一次告知未批准。
+
+工具结果的机器标记：``[deferred_tool_call:<id>]``——``agent/turn_tool_round.py`` 据此
+结束本轮（结束 Run 而不是占用线程等用户）。
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import time
+import uuid
+from pathlib import Path
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+DEFERRED_MARKER_PREFIX = "[deferred_tool_call:"
+DEFAULT_TTL_SECONDS = 24 * 3600
+MAX_RECORDS = 200
+STATUSES = ("pending", "approved", "denied", "expired")
+
+
+def deferred_root() -> Path:
+    home = os.environ.get("HERMES_HOME") or os.path.expanduser("~/.hermes")
+    return Path(home) / "approvals"
+
+
+def deferred_file() -> Path:
+    return deferred_root() / "deferred.json"
+
+
+def responses_dir() -> Path:
+    return deferred_root() / "responses"
+
+
+def _read_all() -> list[dict[str, Any]]:
+    path = deferred_file()
+    if not path.exists():
+        return []
+    try:
+        raw = json.loads(path.read_text(encoding="utf-8"))
+    except Exception:
+        logger.debug("deferred_calls: unreadable ledger", exc_info=True)
+        return []
+    return [r for r in raw if isinstance(r, dict) and isinstance(r.get("id"), str)] if isinstance(raw, list) else []
+
+
+def _write_all(records: list[dict[str, Any]]) -> bool:
+    path = deferred_file()
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        tmp = path.with_name(path.name + ".tmp")
+        tmp.write_text(json.dumps(records, ensure_ascii=False, indent=2), encoding="utf-8")
+        os.replace(tmp, path)
+        return True
+    except Exception:
+        logger.warning("deferred_calls: ledger write failed", exc_info=True)
+        return False
+
+
+def record_deferred(
+    *,
+    session_key: str,
+    session_id: str = "",
+    request_id: str = "",
+    tool: str = "",
+    preview: str = "",
+    risk: str = "",
+    route: Optional[dict[str, str]] = None,
+    ttl_seconds: float = DEFAULT_TTL_SECONDS,
+    now: Optional[float] = None,
+) -> dict[str, Any]:
+    """落一条 pending 延迟调用；返回记录（含 id）。"""
+    at = now if now is not None else time.time()
+    rid = request_id or uuid.uuid4().hex
+    record = {
+        "id": uuid.uuid4().hex[:12],
+        "session_key": session_key,
+        "session_id": session_id,
+        "request_id": rid,
+        "tool": tool,
+        "preview": (preview or "")[:500],
+        "risk": risk,
+        "route": dict(route or {}),
+        "created_at": at,
+        "expires_at": at + max(60.0, float(ttl_seconds)),
+        "status": "pending",
+    }
+    records = _read_all()
+    records.append(record)
+    if len(records) > MAX_RECORDS:
+        records = records[-MAX_RECORDS:]
+    _write_all(records)
+    logger.info("deferred_calls: recorded %s (session=%s tool=%s)", record["id"], session_key, tool)
+    return record
+
+
+def list_deferred(status: Optional[str] = None) -> list[dict[str, Any]]:
+    records = _read_all()
+    if status is None:
+        return records
+    return [r for r in records if r.get("status") == status]
+
+
+def settle_deferred(deferred_id: str, decision: str, *, now: Optional[float] = None, by: str = "") -> Optional[dict[str, Any]]:
+    """裁决一条 pending 记录；非 pending 返回 None（幂等：先到先得）。"""
+    choice = (decision or "").strip().lower()
+    if choice not in ("once", "session", "always", "deny"):
+        return None
+    at = now if now is not None else time.time()
+    records = _read_all()
+    for r in records:
+        if r.get("id") != deferred_id:
+            continue
+        if r.get("status") != "pending":
+            return None
+        r["status"] = "denied" if choice == "deny" else "approved"
+        r["decision"] = choice
+        r["decided_at"] = at
+        if by:
+            r["decided_by"] = by
+        _write_all(records)
+        return r
+    return None
+
+
+def expire_deferred(*, now: Optional[float] = None) -> list[dict[str, Any]]:
+    """把过期 pending 标 expired；返回本次过期的记录（供 watcher 唤醒告知）。"""
+    at = now if now is not None else time.time()
+    records = _read_all()
+    expired: list[dict[str, Any]] = []
+    for r in records:
+        if r.get("status") == "pending" and float(r.get("expires_at") or 0) <= at:
+            r["status"] = "expired"
+            r["decided_at"] = at
+            expired.append(r)
+    if expired:
+        _write_all(records)
+    return expired
+
+
+def read_response(request_id: str) -> Optional[dict[str, Any]]:
+    """读 studio-file-approval 响应文件；不存在/非法返回 None。"""
+    if not request_id:
+        return None
+    path = responses_dir() / f"{request_id}.json"
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except Exception:
+        return None
+    if not isinstance(data, dict) or data.get("request_id") != request_id:
+        return None
+    return data
+
+
+def deferred_marker(deferred_id: str) -> str:
+    return f"{DEFERRED_MARKER_PREFIX}{deferred_id}]"
diff --git a/gateway/run_deferred.py b/gateway/run_deferred.py
new file mode 100644
--- /dev/null
+++ b/gateway/run_deferred.py
@@ -0,0 +1,119 @@
+"""Deferred-approval watcher：用户答复延迟审批后唤醒原会话（Always-on Agents P6）。
+
+数据源：``tools/deferred_calls``（``<HERMES_HOME>/approvals/deferred.json``）＋
+studio-file-approval 响应文件（``responses/<request_id>.json``）。每次 tick：
+1) 过期 pending → 标 expired 并向原会话注入一次「未批准」告知；
+2) 已答复 pending → settle（先到先得）→ 注入「用户已批准/拒绝」事件。
+
+注入走 ``admit_route_wake``（与 followup/loop 同构）：不直接跑 turn，交给会话 authority 排队。
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+from contextlib import suppress
+from typing import Optional
+
+logger = logging.getLogger("gateway.run")
+
+
+class GatewayDeferredApprovalMixin:
+    async def _deferred_approval_watcher(self, interval: float = 10.0) -> None:
+        from gateway.run import _async_profile_runtime_scope, _resolve_handoff_watch_scopes
+        from tools.deferred_calls import expire_deferred, list_deferred, read_response, settle_deferred
+
+        await asyncio.sleep(5)
+        warned_no_route: set = set()
+
+        def _scope(profile_home):
+            if profile_home is not None:
+                return _async_profile_runtime_scope(profile_home)
+            from tui_gateway.launch_profile_policy import async_launch_profile_scope_if_multiplexed
+            return async_launch_profile_scope_if_multiplexed()
+
+        async def _scan_one_store(profile_name: Optional[str]) -> None:
+            # 1) 过期处置（标记 + 一次告知）
+            expired = await self._run_in_executor_with_context(expire_deferred)
+            for record in expired or []:
+                await self._deferred_wake(
+                    record, "expired",
+                    f"此前的审批请求已超时未被回答（{record.get('tool') or '操作'}："
+                    f"{record.get('preview') or ''}）。不要重试该操作；继续其他工作或等待用户指示。",
+                    warned_no_route, profile_name,
+                )
+            # 2) 答复处置
+            for record in await self._run_in_executor_with_context(list_deferred, "pending"):
+                response = await self._run_in_executor_with_context(
+                    read_response, str(record.get("request_id") or ""),
+                )
+                if not response:
+                    continue
+                choice = str(response.get("choice") or "").strip().lower()
+                settled = await self._run_in_executor_with_context(
+                    settle_deferred, record["id"], choice, by=str(response.get("by") or ""),
+                )
+                if settled is None:
+                    continue  # 已被别处裁决
+                approved = settled.get("status") == "approved"
+                text = (
+                    f"用户已批准你此前挂起的操作（{settled.get('tool') or '操作'}："
+                    f"{settled.get('preview') or ''}，决定={settled.get('decision')}）。"
+                    "可继续执行；若已不再需要，说明并跳过。"
+                    if approved else
+                    f"用户拒绝了此前挂起的操作（{settled.get('tool') or '操作'}："
+                    f"{settled.get('preview') or ''}）。不要重试；说明影响并给出替代方案或等待用户指示。"
+                )
+                await self._deferred_wake(settled, settled.get("status", ""), text, warned_no_route, profile_name)
+
+        while self._running:
+            try:
+                for profile_name, profile_home in await _resolve_handoff_watch_scopes(self):
+                    async with _scope(profile_home):
+                        await _scan_one_store(profile_name)
+            except Exception as exc:  # noqa: BLE001 - one bad store must not stop the watcher
+                logger.debug("deferred-approval watcher error: %s", exc)
+            await asyncio.sleep(interval)
+
+    async def _deferred_wake(self, record: dict, outcome: str, text: str,
+                             warned_no_route: set, profile: Optional[str] = None) -> None:
+        """向记录的原会话注入答复事件（无路由/无 adapter 时只告警一次）。"""
+        route = record.get("route") or {}
+        platform_name = route.get("platform", "")
+        chat_id = route.get("chat_id", "")
+        if not platform_name or not chat_id:
+            if record.get("id") not in warned_no_route:
+                warned_no_route.add(record.get("id"))
+                logger.debug("deferred-approval: no route (id=%s)", record.get("id"))
+            return
+        profile = route.get("profile") or profile
+        adapters = self._adapters_for_profile(profile)
+        adapter = next((a for p, a in adapters.items() if p.value == platform_name), None)
+        if adapter is None:
+            if record.get("id") not in warned_no_route:
+                warned_no_route.add(record.get("id"))
+                logger.debug("deferred-approval: no adapter for %r", platform_name)
+            return
+        source = self._build_process_event_source({
+            "session_key": "",
+            "platform": platform_name,
+            "chat_id": chat_id,
+            **{k: route.get(k, "") for k in ("chat_type", "thread_id", "user_id", "user_name")},
+        })
+        if source is None:
+            return
+        if profile and not getattr(source, "profile", None):
+            source.profile = profile
+        try:
+            from gateway.session_automation import admit_route_wake
+
+            if not await admit_route_wake(
+                    self, adapter, source, text, "deferred-approval",
+                    metadata={"deferred_id": record.get("id", ""), "outcome": outcome}):
+                await adapter.handle_message(self._synthetic_prompt_event(source, text, internal=True))
+            logger.info("deferred-approval %s woke session %s (%s)",
+                        record.get("id"), record.get("session_key"), outcome)
+        except Exception as exc:  # noqa: BLE001 - wake failure is logged, not retried
+            logger.warning("deferred-approval wake failed for %s: %s", record.get("id"), exc)
+            with suppress(Exception):
+                pass
