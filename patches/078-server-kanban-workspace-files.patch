+interface WorkspaceFileEntry {
+  name: string
+  isDir: boolean
+  size: number
+  modified: number
+  children?: WorkspaceFileEntry[]
+}
+
+async function readDirTree(dir: string, depth: number): Promise<WorkspaceFileEntry[]> {
+  if (depth <= 0) return []
+  let names: string[]
+  try {
+    names = await readdir(dir)
+  } catch {
+    return []
+  }
+  return Promise.all(names.map(async (name) => {
+    const full = join(dir, name)
+    let st: Awaited<ReturnType<typeof stat>>
+    try {
+      st = await stat(full)
+    } catch {
+      return { name, isDir: false, size: 0, modified: 0 }
+    }
+    const entry: WorkspaceFileEntry = {
+      name, isDir: st.isDirectory(),
+      size: st.size, modified: st.mtimeMs,
+    }
+    if (entry.isDir && depth > 1) {
+      entry.children = await readDirTree(full, depth - 1)
+    }
+    return entry
+  }))
+}
+
+export async function listWorkspaceFiles(ctx: Context) {
+  const taskId = ctx.query.task_id as string | undefined
+  const board = (ctx.query.board as string | undefined) || 'default'
+  const sub = (ctx.query.path as string | undefined) ?? ''
+  const depthRaw = parseInt(ctx.query.depth as string, 10)
+  const depth = Number.isFinite(depthRaw) ? Math.min(Math.max(depthRaw, 1), 4) : 2
+
+  if (!taskId) {
+    ctx.status = 400
+    ctx.body = { error: 'task_id is required' }
+    return
+  }
+
+  const detail = await kanbanCli.getTask(taskId, { board })
+  const wsPath = detail?.task?.workspace_path
+  if (!wsPath) {
+    ctx.body = { path: '', entries: [] }
+    return
+  }
+
+  // board-aware workspaces root: default→workspaces，其他→boards/<slug>/workspaces
+  const kanbanHome = resolve(homedir(), '.hermes', 'kanban')
+  const workspacesRoot = board === 'default'
+    ? resolve(kanbanHome, 'workspaces')
+    : resolve(kanbanHome, 'boards', board, 'workspaces')
+  const root = resolve(workspacesRoot, normalize(wsPath))
+  if (!isPathWithin(root, workspacesRoot)) {
+    ctx.status = 403
+    ctx.body = { error: 'workspace path out of sandbox' }
+    return
+  }
+  const target = sub ? resolve(root, normalize(sub)) : root
+  if (!isPathWithin(target, root)) {
+    ctx.status = 403
+    ctx.body = { error: 'sub path out of task workspace' }
+    return
+  }
+
+  try {
+    const entries = await readDirTree(target, depth)
+    ctx.body = { path: sub, entries }
+  } catch (err: any) {
+    ctx.status = 500
+    ctx.body = { error: err.message }
+  }
+}
