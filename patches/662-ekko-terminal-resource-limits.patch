+function withResourceLimits(command: string, args: string[]): { command: string; args: string[] } {
+  if (process.platform === 'win32') return { command, args }
+  const cpu = Number(process.env.HERMES_TOOL_RLIMIT_CPU_SEC)
+  const fsize = Number(process.env.HERMES_TOOL_RLIMIT_FSIZE_MB)
+  const nproc = Number(process.env.HERMES_TOOL_RLIMIT_NPROC)
+  const mem = Number(process.env.HERMES_TOOL_RLIMIT_MEM_MB)
+  const limits: string[] = []
+  if (Number.isFinite(cpu) && cpu > 0) limits.push(`ulimit -t ${Math.floor(cpu)}`)
+  if (Number.isFinite(fsize) && fsize > 0) limits.push(`ulimit -f ${Math.floor(fsize * 1024)}`)
+  if (Number.isFinite(nproc) && nproc > 0) limits.push(`ulimit -u ${Math.floor(nproc)}`)
+  if (process.platform === 'linux' && Number.isFinite(mem) && mem > 0) limits.push(`ulimit -v ${Math.floor(mem * 1024)}`)
+  if (limits.length === 0) return { command, args }
+  return { command: '/bin/sh', args: ['-c', `${limits.join('; ')}; exec "$@"`, 'hermes-rlimit', command, ...args] }
+}
