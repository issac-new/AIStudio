@@ -0,0 +1,194 @@
+"""完成契约（A 层）单元测试：派生、源哈希、回执校验、证据重算。"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from completion_contract import (
+    ContractViolation,
+    contract_source_sha256,
+    derive_contract,
+    parse_contract,
+    validate_receipt,
+)
+
+
+def _contract(body: str) -> dict:
+    return derive_contract(body)
+
+
+def _workspace(tmp_path: Path) -> Path:
+    (tmp_path / "dist").mkdir()
+    (tmp_path / "reports").mkdir()
+    (tmp_path / "dist" / "app.js").write_text("console.log('ok')\n", encoding="utf8")
+    (tmp_path / "reports" / "tap.txt").write_text(
+        "1..3\nok 1 - A\nok 2 - B\nok 3 - C\n", encoding="utf8"
+    )
+    return tmp_path
+
+
+def _receipt(**overrides):
+    base = {
+        "version": 1,
+        "criteria": [
+            {
+                "id": "AC-1",
+                "status": "pass",
+                "evidence": [{"kind": "artifact", "path": "dist/app.js"}],
+            }
+        ],
+        "artifacts": ["dist/app.js"],
+        "verifications": [
+            {"command": "npx vitest run", "exitCode": 0, "report": "reports/tap.txt", "format": "tap"}
+        ],
+    }
+    base.update(overrides)
+    return base
+
+
+def test_no_acceptance_criteria_keeps_mode_off():
+    contract = _contract("普通任务，没有验收标准")
+    assert contract["mode"] == "off"
+    assert contract["criteria"] == []
+
+
+def test_ac_lines_derive_enforce_contract():
+    contract = _contract("## 验收标准\n- AC-1: 完成门拒绝空回执\n- AC_2 证据可重算\n")
+    assert contract["mode"] == "enforce"
+    assert [item["id"] for item in contract["criteria"]] == ["AC-1", "AC-2"]
+    assert contract["criteria"][1]["statement"] == "证据可重算"
+
+
+def test_dod_block_can_strengthen_and_cannot_drop_declared_ac():
+    body = """AC-1: 测试通过
+```dod
+{"mode":"enforce","minTests":2,"criteria":[{"id":"AC-1","require":["test","artifact"]}],"artifactGlobs":["dist/*"]}
+```
+"""
+    contract = _contract(body)
+    assert contract["minTests"] == 2
+    assert contract["artifactGlobs"] == ["dist/*"]
+    assert [item["id"] for item in contract["criteria"]] == ["AC-1"]
+    assert contract["criteria"][0]["require"] == ["test", "artifact"]
+
+
+def test_invalid_dod_json_blocks_instead_of_silently_disabling():
+    contract = _contract('AC-1: x\n```dod\n{"mode":\n```\n')
+    assert contract["mode"] == "enforce"
+    assert contract["criteria"] == []
+    assert "dod JSON 解析失败" in contract["invalid"]
+    with pytest.raises(ContractViolation, match="声明无效"):
+        validate_receipt(contract, _receipt(), ".")
+
+
+def test_source_hash_ignores_text_outside_contract_source():
+    a = "AC-1: 通过\n一些正文"
+    b = "AC-1: 通过\n正文被改写，但契约没变"
+    assert contract_source_sha256(a) == contract_source_sha256(b)
+    assert contract_source_sha256(a) != contract_source_sha256("AC-1: 通过\nAC-2: 新增")
+
+
+def test_valid_receipt_passes_and_recomputes_counts(tmp_path):
+    ws = _workspace(tmp_path)
+    contract = _contract("AC-1: 产物存在\n")
+    result = validate_receipt(contract, _receipt(), ws)
+    assert result["ok"] is True
+    assert result["totals"] == {"tests": 3, "failures": 0}
+    assert result["artifacts"][0]["path"] == "dist/app.js"
+    assert len(result["artifacts"][0]["sha256"]) == 64
+    assert result["verifications"][0]["tests"] == 3
+
+
+def test_missing_criterion_is_rejected(tmp_path):
+    ws = _workspace(tmp_path)
+    contract = _contract("AC-1: x\nAC-2: y\n")
+    with pytest.raises(ContractViolation, match="缺少契约要求的 criterion"):
+        validate_receipt(contract, _receipt(), ws)
+
+
+def test_self_reported_failure_is_rejected(tmp_path):
+    ws = _workspace(tmp_path)
+    contract = _contract("AC-1: x\n")
+    receipt = _receipt(criteria=[{"id": "AC-1", "status": "fail", "note": "没过"}])
+    with pytest.raises(ContractViolation, match="自报 fail"):
+        validate_receipt(contract, receipt, ws)
+
+
+def test_sha_mismatch_is_rejected(tmp_path):
+    ws = _workspace(tmp_path)
+    contract = _contract("AC-1: x\n")
+    receipt = _receipt(
+        criteria=[{
+            "id": "AC-1",
+            "status": "pass",
+            "evidence": [{"path": "dist/app.js", "sha256": "0" * 64}],
+        }]
+    )
+    with pytest.raises(ContractViolation, match="sha256 不匹配"):
+        validate_receipt(contract, receipt, ws)
+
+
+def test_path_escape_is_rejected(tmp_path):
+    ws = _workspace(tmp_path)
+    (tmp_path.parent / "outside.txt").write_text("secret", encoding="utf8")
+    contract = _contract("AC-1: x\n")
+    receipt = _receipt(criteria=[{
+        "id": "AC-1",
+        "status": "pass",
+        "evidence": [{"path": "../outside.txt"}],
+    }])
+    with pytest.raises(ContractViolation, match="越出 workspace"):
+        validate_receipt(contract, receipt, ws)
+
+
+def test_junit_failures_are_recomputed(tmp_path):
+    ws = _workspace(tmp_path)
+    (ws / "reports" / "junit.xml").write_text(
+        '<testsuites><testsuite tests="4" failures="1" errors="0"/></testsuites>', encoding="utf8"
+    )
+    contract = _contract("AC-1: x\n")
+    receipt = _receipt(
+        verifications=[{"command": "pytest", "exitCode": 0, "report": "reports/junit.xml", "format": "junit"}]
+    )
+    with pytest.raises(ContractViolation, match="1 个失败"):
+        validate_receipt(contract, receipt, ws)
+
+
+def test_min_tests_requires_enough_recomputed_cases(tmp_path):
+    ws = _workspace(tmp_path)
+    contract = _contract('AC-1: x\n```dod\n{"minTests": 10}\n```\n')
+    with pytest.raises(ContractViolation, match="至少 10 个测试"):
+        validate_receipt(contract, _receipt(), ws)
+
+
+def test_text_report_cannot_satisfy_test_requirement(tmp_path):
+    ws = _workspace(tmp_path)
+    (ws / "reports" / "log.txt").write_text("all good\n", encoding="utf8")
+    contract = _contract('AC-1: x\n```dod\n{"criteria":[{"id":"AC-1","require":["test"]}]}\n```\n')
+    receipt = _receipt(
+        verifications=[{"command": "npm test", "exitCode": 0, "report": "reports/log.txt", "format": "text"}]
+    )
+    with pytest.raises(ContractViolation, match="没有 TAP/JUnit"):
+        validate_receipt(contract, receipt, ws)
+
+
+def test_na_requires_note(tmp_path):
+    ws = _workspace(tmp_path)
+    contract = _contract("AC-1: x\n")
+    receipt = _receipt(criteria=[{"id": "AC-1", "status": "na"}])
+    with pytest.raises(ContractViolation, match="必须写 note"):
+        validate_receipt(contract, receipt, ws)
+
+
+def test_artifact_glob_is_enforced(tmp_path):
+    ws = _workspace(tmp_path)
+    contract = _contract('AC-1: x\n```dod\n{"artifactGlobs": ["build/**"]}\n```\n')
+    with pytest.raises(ContractViolation, match="至少一个产物匹配"):
+        validate_receipt(contract, _receipt(), ws)
+
+
+def test_parse_contract_rejects_wrong_version():
+    with pytest.raises(ContractViolation, match="version"):
+        parse_contract(json.dumps({"version": 2, "mode": "enforce"}))

diff --git a/tests/gateway/test_capacity_retry_anchor.py b/tests/gateway/test_capacity_retry_anchor.py
new file mode 100644
--- /dev/null
+++ b/tests/gateway/test_capacity_retry_anchor.py
@@ -0,0 +1,105 @@
+"""容量重试队列年龄锚守门（run11 根治①）：重入条目必须继承首见时间。
+
+锚点：run_busy._capacity_retry_anchor —— id(event) 在跨进程拒绝回环中每次换新对象，
+首见时间被重置 → MAX_AGE 永不过期（run11 实锤：一条回声广播重入 300+ 次、队列
+恒满数小时零过期）。稳定键=event_id（Matrix）；无 event_id 载荷按 (sender,body)
+哈希；再退化为 id()。配套断言：_queue_capacity_retry 对同 event_id 的两个不同对象
+只建一个锚，且第二条 pending 继承第一条的 first_seen（重入退避生效）。
+"""
+
+from __future__ import annotations
+
+import sys
+import types
+from pathlib import Path
+
+_WORKTREE = Path(__file__).resolve().parents[2]
+if str(_WORKTREE) not in sys.path:
+    sys.path.insert(0, str(_WORKTREE))
+
+from gateway.run_busy import GatewayBusySessionMixin, _capacity_retry_anchor
+
+
+class _FakeEvent:
+    def __init__(self, event_id=None, sender="@u:t", body=None):
+        self.event_id = event_id
+        self.sender = sender
+        if body is not None:
+            self.content = types.SimpleNamespace(body=body)
+        else:
+            self.content = None
+
+
+class _FakeRunner(GatewayBusySessionMixin):
+    CAPACITY_RETRY_MAX_PENDING = 64
+    CAPACITY_RETRY_POLL_SEC = 2.0
+    CAPACITY_RETRY_MAX_AGE_SEC = 20 * 60.0
+
+
+class TestAnchor:
+    def test_event_id_is_the_anchor(self):
+        a, b = _FakeEvent(event_id="$same"), _FakeEvent(event_id="$same")
+        assert _capacity_retry_anchor(a) == "$same"
+        assert _capacity_retry_anchor(a) == _capacity_retry_anchor(b)  # 新对象同键
+
+    def test_body_fallback_without_event_id(self):
+        a = _FakeEvent(body="hello")
+        b = _FakeEvent(body="hello")
+        c = _FakeEvent(body="world")
+        assert _capacity_retry_anchor(a) == _capacity_retry_anchor(b)
+        assert _capacity_retry_anchor(a) != _capacity_retry_anchor(c)
+        assert _capacity_retry_anchor(_FakeEvent()) is not None  # 兜底 id()
+
+    def test_reentry_inherits_first_seen_and_backs_off(self, monkeypatch):
+        class _DeadPump:  # 入队会想拉泵任务——测试无事件循环，stub 成"已完成"
+            def done(self):
+                return True
+
+            def cancelled(self):
+                return False
+
+            def exception(self):
+                return None
+
+        monkeypatch.setattr("gateway.run_busy.asyncio.create_task", lambda coro: _DeadPump())
+        r = _FakeRunner()
+        e1 = _FakeEvent(event_id="$re")
+        assert r._queue_capacity_retry(e1, None, "agent:x") is True
+        t1 = r._capacity_retry_since["$re"]
+        # 跨进程拒绝回环：同消息以新对象回来
+        e2 = _FakeEvent(event_id="$re")
+        assert r._queue_capacity_retry(e2, None, "agent:x") is True
+        assert r._capacity_retry_since == {"$re": t1}          # 锚不新增
+        assert len(r._capacity_retry_queue) == 2
+        assert r._capacity_retry_queue[1][0] == t1              # 继承首见时间
+        assert r._capacity_retry_queue[1][4] > r._capacity_retry_queue[0][4]  # 退避生效
+
+    def test_pump_expiry_uses_same_anchor(self):
+        # 泵过期路径按同键清锚（_capacity_retry_pump 的 pop 调用与入队同键）：
+        # 此处以单元面断言键函数对 pump 侧可见的一致性（异步泵全路径由 533 既有
+        # 测试域覆盖，这里钉住键契约不回退）。
+        e = _FakeEvent(event_id="$k")
+        key = _capacity_retry_anchor(e)
+        r = _FakeRunner()
+        r._capacity_retry_since = {}  # 惰性初始化（生产由 _queue_capacity_retry 建）
+        r._capacity_retry_since[key] = 1.0
+        r._capacity_retry_since.pop(_capacity_retry_anchor(_FakeEvent(event_id="$k")))
+        assert key not in r._capacity_retry_since
+
+
+class TestCapacitySidecar:
+    def test_enqueue_writes_depth_sidecar_throttled(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        class _DP:
+            def done(self): return True
+            def cancelled(self): return False
+            def exception(self): return None
+        monkeypatch.setattr("gateway.run_busy.asyncio.create_task", lambda coro: _DP())
+        r = _FakeRunner()
+        r._queue_capacity_retry(_FakeEvent(event_id="$a"), None, "agent:x")
+        r._queue_capacity_retry(_FakeEvent(event_id="$b"), None, "agent:y")
+        import json as _j, pathlib as _pl
+        f = _pl.Path(tmp_path) / "runtime" / "capacity_retry.json"
+        assert f.exists()
+        d = _j.loads(f.read_text())
+        assert d["cap"] == 64 and d["anchors"] >= 1

diff --git a/hermes_cli/board_team_keys.py b/hermes_cli/board_team_keys.py
new file mode 100644
--- /dev/null
+++ b/hermes_cli/board_team_keys.py
@@ -0,0 +1,21 @@
+"""板级团队键选择（单一源）。
+
+``board.json`` 有两个历史键：
+- ``profiles``：dispatcher team-fence 契约键（早期围栏只认它）
+- ``profile_scope``：板生命周期/创建入口实际写入的键（live 板实测）
+两者都表示「这块板挂哪些 agent」，围栏必须同源识别；``profiles`` 优先，
+缺失才回落 ``profile_scope``。非 dict / 两键皆缺 → ``None``（无围栏）。
+"""
+
+from __future__ import annotations
+
+from typing import Any, Optional
+
+
+def team_raw(meta: Any) -> Optional[Any]:
+    if not isinstance(meta, dict):
+        return None
+    raw = meta.get("profiles")
+    if raw is None:
+        raw = meta.get("profile_scope")
+    return raw

diff --git a/completion_contract.py b/completion_contract.py
new file mode 100644
--- /dev/null
+++ b/completion_contract.py
@@ -0,0 +1,507 @@
+"""完成契约（DoD）的派生、校验与证据重算。
+
+设计边界（2026-10-31 模型波动加固 A 层）：
+- 契约来自任务 body 的 ``AC-n`` 行或 ```dod JSON 块；派发时由 dispatcher 写入
+  ``HERMES_KANBAN_DOD_CONTRACT`` 并锁定契约源哈希，worker 改卡面无法削弱契约。
+- 回执只做确定性重算：路径存在性、sha256/字节数、TAP/JUnit 计数与失败数。
+  不执行验证命令（复跑属独立验证层），因此完成门本身不产生副作用。
+- 无 AC 且无 dod 块的卡 ``mode=off``，行为与加固前一致；有声明但声明畸形时
+  ``mode=enforce`` + ``invalid``，完成被拒而不是静默放行。
+"""
+from __future__ import annotations
+
+import fnmatch
+import hashlib
+import json
+import re
+import xml.etree.ElementTree as ET
+from pathlib import Path
+from typing import Any
+
+CONTRACT_ENV = "HERMES_KANBAN_DOD_CONTRACT"
+SOURCE_SHA_ENV = "HERMES_KANBAN_DOD_SOURCE_SHA256"
+VERSION = 1
+
+MAX_SOURCE_BYTES = 64 * 1024
+MAX_RECEIPT_BYTES = 256 * 1024
+MAX_REPORT_BYTES = 8 * 1024 * 1024
+MAX_CRITERIA = 64
+MAX_EVIDENCE = 64
+MAX_ARTIFACTS = 128
+MAX_VERIFICATIONS = 32
+MAX_PATH_LEN = 512
+MAX_STATEMENT_LEN = 500
+MAX_COMMAND_LEN = 500
+
+ALLOWED_MODES = {"off", "warn", "enforce"}
+ALLOWED_REQUIREMENTS = {"evidence", "artifact", "test", "command", "doc"}
+ALLOWED_STATUS = {"pass", "fail", "na"}
+ALLOWED_FORMATS = {"tap", "junit", "text"}
+ALLOWED_KINDS = {"artifact", "test_report", "command", "doc", "other"}
+
+_AC_LINE = re.compile(r"^\s*(?:[-*+]\s+)?(AC[-_ ]?\d+)\b[^\n]*$", re.IGNORECASE | re.MULTILINE)
+_DOD_FENCE = re.compile(r"```dod[ \t]*\r?\n(.*?)```", re.IGNORECASE | re.DOTALL)
+_DOD_COMMENT = re.compile(r"<!--\s*dod:\s*(\{.*?\})\s*-->", re.IGNORECASE | re.DOTALL)
+_SHA256 = re.compile(r"^[a-f0-9]{64}$")
+_AC_PREFIX = re.compile(r"^[-*+\s]*AC[-_ ]?\d+\s*[:：.\-–]?\s*", re.IGNORECASE)
+
+
+class ContractViolation(ValueError):
+    """回执不满足契约。消息直接面向 worker，必须写明改法。"""
+
+
+def _sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _norm_ac_id(raw: str) -> str:
+    digits = re.search(r"\d+", raw or "")
+    return f"AC-{digits.group(0)}" if digits else (raw or "").strip().upper()
+
+
+def _ac_statements(body: str) -> list[dict[str, str]]:
+    out: list[dict[str, str]] = []
+    seen: set[str] = set()
+    for match in _AC_LINE.finditer(body or ""):
+        cid = _norm_ac_id(match.group(1))
+        if not cid or cid in seen:
+            continue
+        seen.add(cid)
+        line = match.group(0).strip()
+        statement = _AC_PREFIX.sub("", line).strip()
+        out.append({"id": cid, "statement": statement[:MAX_STATEMENT_LEN]})
+    return out
+
+
+def _extract_dod(body: str) -> Any:
+    for pattern in (_DOD_FENCE, _DOD_COMMENT):
+        matches = pattern.findall(body or "")
+        if matches:
+            raw = matches[-1].strip()
+            try:
+                return json.loads(raw)
+            except Exception as exc:  # noqa: BLE001 - 组合成可行动的 invalid 原因
+                return {"__invalid__": f"dod JSON 解析失败：{exc}"}
+    return None
+
+
+def contract_source(body: str) -> str:
+    """契约源的正规范化文本：只含 AC 行与 dod 块，正文其它改动不改变哈希。"""
+    canonical = {
+        "acs": _ac_statements(body),
+        "dod": _extract_dod(body),
+    }
+    return json.dumps(canonical, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+
+def contract_source_sha256(body: str) -> str:
+    return _sha256_bytes(contract_source(body).encode("utf-8"))
+
+
+def _safe_glob(value: str) -> bool:
+    if not value or len(value) > 256 or "\x00" in value:
+        return False
+    if value.startswith(("/", "\\")) or re.match(r"^[A-Za-z]:", value):
+        return False
+    return ".." not in Path(value.replace("\\", "/")).parts
+
+
+def _normalize_contract(raw: dict[str, Any]) -> dict[str, Any]:
+    mode = str(raw.get("mode") or "enforce").strip().lower()
+    if mode not in ALLOWED_MODES:
+        raise ContractViolation(f"contract.mode 必须是 {sorted(ALLOWED_MODES)}，收到 {mode!r}")
+
+    criteria_raw = raw.get("criteria") or []
+    if not isinstance(criteria_raw, list) or len(criteria_raw) > MAX_CRITERIA:
+        raise ContractViolation(f"contract.criteria 必须是数组且不超过 {MAX_CRITERIA} 条")
+    criteria: list[dict[str, Any]] = []
+    seen: set[str] = set()
+    for index, item in enumerate(criteria_raw):
+        if not isinstance(item, dict):
+            raise ContractViolation(f"contract.criteria[{index}] 不是对象")
+        cid = str(item.get("id") or "").strip()
+        if not cid or len(cid) > 64 or cid in seen:
+            raise ContractViolation(f"contract.criteria[{index}].id 为空/超长/重复：{cid!r}")
+        seen.add(cid)
+        require_raw = item.get("require") or ["evidence"]
+        if not isinstance(require_raw, list) or not require_raw:
+            raise ContractViolation(f"{cid}.require 必须是非空数组")
+        require: list[str] = []
+        for value in require_raw:
+            key = str(value).strip().lower()
+            if key not in ALLOWED_REQUIREMENTS:
+                raise ContractViolation(f"{cid}.require 含未知项 {key!r}（允许 {sorted(ALLOWED_REQUIREMENTS)}）")
+            if key not in require:
+                require.append(key)
+        criteria.append({
+            "id": cid,
+            "statement": str(item.get("statement") or "")[:MAX_STATEMENT_LEN],
+            "require": require,
+        })
+
+    min_tests = raw.get("minTests") or 0
+    if not isinstance(min_tests, int) or isinstance(min_tests, bool) or not (0 <= min_tests <= 100000):
+        raise ContractViolation("contract.minTests 必须是 0..100000 的整数")
+
+    globs_raw = raw.get("artifactGlobs") or []
+    if not isinstance(globs_raw, list) or len(globs_raw) > 16:
+        raise ContractViolation("contract.artifactGlobs 必须是不超过 16 条的数组")
+    globs: list[str] = []
+    for value in globs_raw:
+        text = str(value).strip().replace("\\", "/")
+        if not _safe_glob(text):
+            raise ContractViolation(f"artifactGlobs 非法（不得绝对路径/含 ..）：{value!r}")
+        globs.append(text)
+
+    source_sha = str(raw.get("sourceSha256") or "")
+    if source_sha and not _SHA256.match(source_sha):
+        raise ContractViolation("contract.sourceSha256 不是 64 位十六进制")
+    invalid = raw.get("invalid")
+    out: dict[str, Any] = {
+        "version": VERSION,
+        "mode": mode,
+        "criteria": criteria,
+        "minTests": min_tests,
+        "artifactGlobs": globs,
+        "sourceSha256": source_sha,
+    }
+    if invalid:
+        out["invalid"] = str(invalid)[:1000]
+    return out
+
+
+def derive_contract(body: str) -> dict[str, Any]:
+    """从任务 body 派生契约。畸形声明返回 enforce+invalid（不静默关闭）。"""
+    body = body or ""
+    if len(body.encode("utf-8")) > MAX_SOURCE_BYTES:
+        body = body.encode("utf-8")[:MAX_SOURCE_BYTES].decode("utf-8", "ignore")
+    source_sha = contract_source_sha256(body)
+    acs = _ac_statements(body)
+    dod = _extract_dod(body)
+
+    if isinstance(dod, dict) and dod.get("__invalid__"):
+        return {
+            "version": VERSION, "mode": "enforce", "criteria": [], "minTests": 0,
+            "artifactGlobs": [], "sourceSha256": source_sha,
+            "invalid": str(dod["__invalid__"]),
+        }
+    if dod is not None and not isinstance(dod, dict):
+        return {
+            "version": VERSION, "mode": "enforce", "criteria": [], "minTests": 0,
+            "artifactGlobs": [], "sourceSha256": source_sha,
+            "invalid": "dod 块必须是 JSON 对象",
+        }
+    if dod is None and not acs:
+        return {
+            "version": VERSION, "mode": "off", "criteria": [], "minTests": 0,
+            "artifactGlobs": [], "sourceSha256": source_sha,
+        }
+
+    raw: dict[str, Any] = dict(dod or {})
+    criteria = raw.get("criteria")
+    if not isinstance(criteria, list) or not criteria:
+        criteria = [{"id": ac["id"], "statement": ac["statement"], "require": ["evidence"]} for ac in acs]
+    else:
+        # dod 块不得漏掉 body 里已声明的 AC：缺的按默认要求补回。
+        declared = {str(item.get("id") or "") for item in criteria if isinstance(item, dict)}
+        for ac in acs:
+            if ac["id"] not in declared:
+                criteria.append({"id": ac["id"], "statement": ac["statement"], "require": ["evidence"]})
+    raw["criteria"] = criteria
+    raw["mode"] = raw.get("mode") or "enforce"
+    raw["sourceSha256"] = source_sha
+    try:
+        return _normalize_contract(raw)
+    except ContractViolation as exc:
+        return {
+            "version": VERSION, "mode": "enforce", "criteria": [], "minTests": 0,
+            "artifactGlobs": [], "sourceSha256": source_sha, "invalid": str(exc),
+        }
+
+
+def parse_contract(raw: str) -> dict[str, Any]:
+    if not raw or not raw.strip():
+        raise ContractViolation("完成契约为空")
+    try:
+        value = json.loads(raw)
+    except ValueError as exc:
+        raise ContractViolation(f"完成契约不是合法 JSON：{exc}") from None
+    if not isinstance(value, dict):
+        raise ContractViolation("完成契约必须是 JSON 对象")
+    if value.get("version") != VERSION:
+        raise ContractViolation(f"完成契约 version 必须是 {VERSION}")
+    return _normalize_contract(value)
+
+
+def _resolve_under(root: Path, rel: str, *, field: str) -> Path:
+    text = str(rel or "").strip()
+    if not text or len(text) > MAX_PATH_LEN or "\x00" in text:
+        raise ContractViolation(f"{field} 路径为空/超长/含 NUL")
+    if Path(text).is_absolute():
+        raise ContractViolation(f"{field} 必须相对 workspace：{text}")
+    target = (root / text).resolve()
+    if target != root and root not in target.parents:
+        raise ContractViolation(f"{field} 越出 workspace：{text}")
+    if not target.is_file():
+        raise ContractViolation(f"{field} 文件不存在：{text}")
+    return target
+
+
+def _file_fingerprint(path: Path, expected_sha: str | None, *, field: str) -> dict[str, Any]:
+    data = path.read_bytes()
+    actual = _sha256_bytes(data)
+    if expected_sha:
+        expected = str(expected_sha).strip().lower()
+        if not _SHA256.match(expected):
+            raise ContractViolation(f"{field} sha256 不是 64 位十六进制")
+        if actual != expected:
+            raise ContractViolation(f"{field} sha256 不匹配：声明 {expected}，实际 {actual}")
+    return {"sha256": actual, "bytes": len(data)}
+
+
+def _normalize_evidence(root: Path, item: Any, *, field: str) -> dict[str, Any]:
+    if isinstance(item, str):
+        kind, rel, expected_sha = "artifact", item, None
+    elif isinstance(item, dict):
+        kind = str(item.get("kind") or "artifact").strip().lower()
+        if kind not in ALLOWED_KINDS:
+            raise ContractViolation(f"{field}.kind 未知：{kind!r}")
+        rel = item.get("path")
+        expected_sha = item.get("sha256")
+        if not isinstance(rel, str):
+            raise ContractViolation(f"{field}.path 必须是字符串")
+    else:
+        raise ContractViolation(f"{field} 必须是路径字符串或对象")
+    path = _resolve_under(root, str(rel), field=field)
+    fingerprint = _file_fingerprint(path, expected_sha if isinstance(expected_sha, str) else None, field=field)
+    return {"kind": kind, "path": Path(str(rel)).as_posix(), **fingerprint}
+
+
+def _parse_tap(text: str) -> tuple[int, int]:
+    tests = failures = 0
+    for line in text.splitlines():
+        stripped = line.strip()
+        if re.match(r"^ok\b", stripped):
+            tests += 1
+        elif re.match(r"^not ok\b", stripped):
+            tests += 1
+            failures += 1
+    if tests == 0:
+        raise ContractViolation("TAP 报告没有任何 ok/not ok 行，不能作为测试证据")
+    return tests, failures
+
+
+def _parse_junit(text: str) -> tuple[int, int]:
+    try:
+        root = ET.fromstring(text)
+    except ET.ParseError as exc:
+        raise ContractViolation(f"JUnit XML 解析失败：{exc}") from None
+    if root.tag == "testsuite":
+        suites = [root]
+    elif root.tag == "testsuites":
+        suites = root.findall("testsuite")
+    else:
+        suites = list(root.iter("testsuite"))
+    if not suites:
+        raise ContractViolation("JUnit 报告没有 testsuite 节点")
+    tests = failures = 0
+    for suite in suites:
+        try:
+            tests += int(suite.get("tests") or 0)
+            failures += int(suite.get("failures") or 0) + int(suite.get("errors") or 0)
+        except ValueError:
+            raise ContractViolation("JUnit testsuite 的 tests/failures/errors 不是整数") from None
+    if tests == 0:
+        raise ContractViolation("JUnit 报告 tests=0，不能作为测试证据")
+    return tests, failures
+
+
+def _infer_format(report: Path, declared: str | None) -> str:
+    if declared:
+        fmt = str(declared).strip().lower()
+        if fmt not in ALLOWED_FORMATS:
+            raise ContractViolation(f"verification.format 必须是 {sorted(ALLOWED_FORMATS)}")
+        return fmt
+    suffix = report.suffix.lower()
+    if suffix in (".tap",):
+        return "tap"
+    if suffix in (".xml", ".junit"):
+        return "junit"
+    head = report.read_bytes()[:512].decode("utf-8", "ignore").lstrip()
+    if head.startswith("<?xml") or head.startswith("<testsuite") or head.startswith("<testsuites"):
+        return "junit"
+    if re.search(r"^(ok|not ok)\b", head, re.MULTILINE):
+        return "tap"
+    return "text"
+
+
+def _match_any(path: str, globs: list[str]) -> bool:
+    normalized = path.replace("\\", "/")
+    return any(
+        fnmatch.fnmatchcase(normalized, glob) or fnmatch.fnmatchcase(Path(normalized).name, glob)
+        for glob in globs
+    )
+
+
+def validate_receipt(contract: dict[str, Any], receipt: Any, workspace: str | Path) -> dict[str, Any]:
+    """校验回执并返回可落库的规范化结果；违规抛 ContractViolation。"""
+    contract = _normalize_contract(contract)
+    if contract["mode"] == "off":
+        return {"ok": True, "skipped": "off", "contractSha256": _sha256_bytes(json.dumps(contract, sort_keys=True).encode())}
+    if contract.get("invalid"):
+        raise ContractViolation(
+            f"任务的完成契约声明无效：{contract['invalid']}。修正卡面 AC/dod 块后由派发方重新下发契约，"
+            "不要伪造回执。"
+        )
+    if not isinstance(receipt, dict):
+        raise ContractViolation(
+            "缺少结构化回执。请在 kanban_complete 的 receipt 参数中提供："
+            '{"version":1,"criteria":[{"id":"AC-1","status":"pass","evidence":[{"path":"..."}]}],'
+            '"verifications":[{"command":"...","exitCode":0,"report":"...","format":"tap|junit"}]}'
+        )
+    if receipt.get("version") != VERSION:
+        raise ContractViolation(f"receipt.version 必须是 {VERSION}")
+    encoded = json.dumps(receipt, ensure_ascii=False).encode("utf-8")
+    if len(encoded) > MAX_RECEIPT_BYTES:
+        raise ContractViolation(f"receipt 超过 {MAX_RECEIPT_BYTES} 字节，请只保留可核验证据")
+
+    root = Path(workspace).expanduser().resolve()
+    if not root.is_dir():
+        raise ContractViolation(f"workspace 不是目录，无法核验证据：{root}")
+
+    criteria_contract = {item["id"]: item for item in contract["criteria"]}
+    receipt_criteria = receipt.get("criteria")
+    if not isinstance(receipt_criteria, list):
+        raise ContractViolation("receipt.criteria 必须是数组")
+    seen: set[str] = set()
+    validated: list[dict[str, Any]] = []
+    for index, item in enumerate(receipt_criteria):
+        if not isinstance(item, dict):
+            raise ContractViolation(f"receipt.criteria[{index}] 不是对象")
+        cid = str(item.get("id") or "").strip()
+        if cid not in criteria_contract:
+            raise ContractViolation(f"receipt 含契约外 criterion：{cid!r}（允许 {sorted(criteria_contract)}）")
+        if cid in seen:
+            raise ContractViolation(f"receipt 重复声明 criterion：{cid}")
+        seen.add(cid)
+        status = str(item.get("status") or "").strip().lower()
+        if status not in ALLOWED_STATUS:
+            raise ContractViolation(f"{cid}.status 必须是 {sorted(ALLOWED_STATUS)}")
+        if status == "fail":
+            raise ContractViolation(f"{cid} 自报 fail——失败项不能用于完成；修复后重新提交，或 kanban_block 说明阻塞")
+        note = str(item.get("note") or "").strip()
+        if status == "na" and not note:
+            raise ContractViolation(f"{cid} 标记 na 必须写 note 说明为何不适用")
+        evidence_raw = item.get("evidence") or []
+        if not isinstance(evidence_raw, list) or len(evidence_raw) > MAX_EVIDENCE:
+            raise ContractViolation(f"{cid}.evidence 必须是不超过 {MAX_EVIDENCE} 条的数组")
+        if status == "pass" and not evidence_raw:
+            raise ContractViolation(f"{cid} 标记 pass 但没有任何 evidence（路径/报告），不能作为通过依据")
+        evidence = [
+            _normalize_evidence(root, value, field=f"{cid}.evidence[{position}]")
+            for position, value in enumerate(evidence_raw)
+        ]
+        require = criteria_contract[cid]["require"]
+        kinds = {entry["kind"] for entry in evidence}
+        if "artifact" in require and not evidence:
+            raise ContractViolation(f"{cid} 要求 artifact 证据，但 evidence 为空")
+        if "doc" in require and "doc" not in kinds:
+            raise ContractViolation(f"{cid} 要求 doc 证据，但 evidence 未提供 kind=doc 的条目")
+        validated.append({
+            "id": cid,
+            "status": status,
+            "note": note[:MAX_STATEMENT_LEN],
+            "evidence": evidence,
+        })
+
+    missing = sorted(set(criteria_contract) - seen)
+    if missing:
+        raise ContractViolation(f"回执缺少契约要求的 criterion：{', '.join(missing)}")
+
+    artifacts_raw = receipt.get("artifacts") or []
+    if not isinstance(artifacts_raw, list) or len(artifacts_raw) > MAX_ARTIFACTS:
+        raise ContractViolation(f"receipt.artifacts 必须是不超过 {MAX_ARTIFACTS} 条的数组")
+    artifacts = [
+        _normalize_evidence(root, value, field=f"artifacts[{position}]")
+        for position, value in enumerate(artifacts_raw)
+    ]
+    if contract["artifactGlobs"]:
+        if not any(_match_any(item["path"], contract["artifactGlobs"]) for item in artifacts):
+            raise ContractViolation(
+                f"契约要求至少一个产物匹配 {contract['artifactGlobs']}，回执 artifacts 均不匹配"
+            )
+
+    verifications_raw = receipt.get("verifications") or []
+    if not isinstance(verifications_raw, list) or len(verifications_raw) > MAX_VERIFICATIONS:
+        raise ContractViolation(f"receipt.verifications 必须是不超过 {MAX_VERIFICATIONS} 条的数组")
+    verifications: list[dict[str, Any]] = []
+    total_tests = total_failures = 0
+    machine_evidence = False
+    for index, item in enumerate(verifications_raw):
+        if not isinstance(item, dict):
+            raise ContractViolation(f"verifications[{index}] 不是对象")
+        command = str(item.get("command") or "").strip()
+        if not command or len(command) > MAX_COMMAND_LEN:
+            raise ContractViolation(f"verifications[{index}].command 为空或超长")
+        exit_code = item.get("exitCode")
+        if not isinstance(exit_code, int) or isinstance(exit_code, bool):
+            raise ContractViolation(f"verifications[{index}].exitCode 必须是整数")
+        if exit_code != 0:
+            raise ContractViolation(f"verifications[{index}] 退出码 {exit_code}≠0，不能作为通过证据")
+        report_raw = item.get("report")
+        if report_raw is None or str(report_raw).strip() == "":
+            fmt = str(item.get("format") or "text").strip().lower()
+            if fmt != "text":
+                raise ContractViolation(f"verifications[{index}] 声明 {fmt} 但未提供 report 路径")
+            verifications.append({"command": command, "exitCode": exit_code, "format": "text",
+                                  "tests": None, "failures": None})
+            continue
+        report = _resolve_under(root, str(report_raw), field=f"verifications[{index}].report")
+        size = report.stat().st_size
+        if size > MAX_REPORT_BYTES:
+            raise ContractViolation(f"verifications[{index}].report 超过 {MAX_REPORT_BYTES} 字节")
+        text = report.read_text(encoding="utf-8", errors="replace")
+        fmt = _infer_format(report, item.get("format") if isinstance(item.get("format"), str) else None)
+        if fmt == "text":
+            verifications.append({"command": command, "exitCode": exit_code, "format": "text",
+                                  "path": Path(str(report_raw)).as_posix(), "tests": None, "failures": None,
+                                  "sha256": _sha256_bytes(report.read_bytes())})
+            continue
+        tests, failures = _parse_tap(text) if fmt == "tap" else _parse_junit(text)
+        if failures > 0:
+            raise ContractViolation(
+                f"verifications[{index}] 报告有 {failures} 个失败，不能作为通过证据"
+            )
+        machine_evidence = True
+        total_tests += tests
+        total_failures += failures
+        verifications.append({
+            "command": command, "exitCode": exit_code, "format": fmt,
+            "path": Path(str(report_raw)).as_posix(), "tests": tests, "failures": failures,
+            "sha256": _sha256_bytes(report.read_bytes()),
+        })
+
+    if contract["minTests"] > 0 and total_tests < contract["minTests"]:
+        raise ContractViolation(
+            f"契约要求至少 {contract['minTests']} 个测试，回执可重算的测试数为 {total_tests}"
+        )
+    needs_test = any("test" in item["require"] for item in criteria_contract.values())
+    if needs_test and not machine_evidence:
+        raise ContractViolation("至少一条 criterion 要求 test 证据，但回执没有 TAP/JUnit 可重算报告")
+
+    contract_sha = _sha256_bytes(
+        json.dumps(
+            {key: contract[key] for key in ("version", "mode", "criteria", "minTests", "artifactGlobs", "sourceSha256")},
+            ensure_ascii=False, sort_keys=True, separators=(",", ":"),
+        ).encode("utf-8")
+    )
+    return {
+        "ok": True,
+        "version": VERSION,
+        "contractSha256": contract_sha,
+        "sourceSha256": contract.get("sourceSha256") or None,
+        "criteria": validated,
+        "artifacts": artifacts,
+        "verifications": verifications,
+        "totals": {"tests": total_tests, "failures": total_failures},
+    }

diff --git a/gateway/noise_filter.py b/gateway/noise_filter.py
new file mode 100644
--- /dev/null
+++ b/gateway/noise_filter.py
@@ -0,0 +1,204 @@
+"""AI 基础设施环境噪声过滤（共享 util，matrix + weixin 等 adapter 共用）。
+
+设计目标：挡下混在消息流里的「伪消息」，避免触发 agent turn 烧 token。
+设计原则（matrix-collaboration-termination.md 第 7 层）：
+  - 可观测：每次过滤打 debug 日志（含原因）
+  - 可回退：单类开关 + 平台总开关
+  - 平台分级：高置信度噪声默认拦；语义级噪声（复读/纯表情等）默认只记日志
+
+平台开关命名：{PLATFORM}_NOISE_FILTER / {PLATFORM}_NOISE_FILTER_{CLASS}
+  例：MATRIX_NOISE_FILTER_HEARTBEAT / WEIXIN_NOISE_FILTER_SINGLE_CHAR
+
+「高置信度 vs 语义级」分级（2026-08-20 图爸决策：微信保守，只拦高置信度）：
+  - 高置信度（默认拦）：空消息/纯标点、加密失败占位符、单字符误发、
+    心跳/健康检查、同步重放回声、语音转文字失败、撤回回声
+  - 语义级（默认不拦只记日志）：纯表情、链接卡片无文字、复读、空转
+"""
+from __future__ import annotations
+
+import logging
+import os
+import string
+from typing import Optional, Sequence
+
+logger = logging.getLogger(__name__)
+
+# ---------------------------------------------------------------------------
+# 开关读取
+# ---------------------------------------------------------------------------
+
+def noise_env(platform: str, name: str, default: bool = True) -> bool:
+    """读取平台级噪声开关。env 名形如 WEIXIN_NOISE_FILTER_EMPTY。"""
+    val = os.getenv(f"{platform.upper()}_NOISE_FILTER_{name}", "")
+    if not val:  # 未设置 → 用平台默认
+        return default
+    return val.strip().lower() in ("true", "1", "yes", "on")
+
+
+def noise_enabled(platform: str) -> bool:
+    """平台总开关（{PLATFORM}_NOISE_FILTER），默认开启。"""
+    val = os.getenv(f"{platform.upper()}_NOISE_FILTER", "")
+    if not val:
+        return True
+    return val.strip().lower() in ("true", "1", "yes", "on")
+
+
+# ---------------------------------------------------------------------------
+# 特征库（小写匹配）
+# ---------------------------------------------------------------------------
+
+# 心跳/健康检查/状态上报
+HEARTBEAT_PATTERNS: Sequence[str] = (
+    "alive", "heartbeat", "ping", "pong", "health check", "healthcheck",
+    "status: ok", "status ok", "still running", "keep-alive", "keepalive",
+    "i'm alive", "im alive", "uptime", "心跳", "存活",
+)
+
+# 加密失败占位符（mautrix/E2EE 客户端解不出来时的占位文案）
+DECRYPT_FAILURE_PATTERNS: Sequence[str] = (
+    "unable to decrypt", "unable to locate", "decryption failed",
+    "megolm", "olm session", "could not decrypt", "waiting for this message",
+    "encrypted message", "无法解密", "解密失败",
+)
+
+# 语音转文字失败占位符（weixin 等 STT 失败时的占位）
+STT_FAILURE_PATTERNS: Sequence[str] = (
+    "[语音]", "语音转文字失败", "无法识别", "语音识别失败",
+    "transcription failed", "voice message",
+)
+
+# 撤回回声（revoke/recall 系统消息残片）
+RECALL_PATTERNS: Sequence[str] = (
+    "撤回了一条消息", "recalled a message", "message recalled",
+    "you recalled a message", "已撤回",
+)
+
+# 单字符无意义噪声（保留数字和命令）
+SINGLE_CHAR_NOISE: Sequence[str] = (
+    "c", "k", "z", "嗯", "啊", "哦", "呃", "哈", "哼",
+)
+
+# 纯标点 strip 字符集（中英标点 + 全角空格）
+_PUNCT_STRIP = string.punctuation + " \t\n\r　。，、！？…—·【】（）《》「」"
+
+
+# ---------------------------------------------------------------------------
+# 核心判定
+# ---------------------------------------------------------------------------
+
+def noise_reason(
+    body: str,
+    platform: str,
+    *,
+    event_ts: float = 0.0,
+    startup_ts: float = 0.0,
+    enable_decrypt: bool = True,
+    enable_sync_replay: bool = True,
+    enable_stt_failure: bool = True,
+    enable_recall: bool = True,
+) -> Optional[str]:
+    """判定一条文本消息是否为高置信度基础设施噪声。
+
+    返回噪声原因字符串（用于日志），非噪声返回 None。
+
+    平台差异通过关键字参数控制：
+      - enable_decrypt: E2EE 平台（matrix）开，非 E2EE（weixin）关
+      - enable_sync_replay: 有同步重放机制的平台（matrix）开，轮询（weixin）关
+      - enable_stt_failure / enable_recall: 有语音/撤回的平台（weixin）开
+
+    只拦高置信度噪声——语义级（复读/纯表情/链接卡片）由 semantic_reason 处理。
+    """
+    if not noise_enabled(platform):
+        return None
+
+    text = (body or "").strip()
+
+    # 1) 空消息 / 纯 whitespace / 纯标点
+    if noise_env(platform, "EMPTY", True):
+        if not text:
+            return "empty"
+        if not text.strip(_PUNCT_STRIP):
+            return "punctuation_only"
+
+    # 2) 加密失败占位符（E2EE 平台专用）
+    if enable_decrypt and noise_env(platform, "DECRYPT", True):
+        low = text.lower()
+        if any(p in low for p in DECRYPT_FAILURE_PATTERNS):
+            return "decrypt_failure"
+
+    # 3) 心跳 / 健康检查 / 状态上报
+    if noise_env(platform, "HEARTBEAT", True):
+        low = text.lower()
+        if low in HEARTBEAT_PATTERNS:
+            return "heartbeat_exact"
+        if len(text) < 30 and any(low.startswith(p) for p in HEARTBEAT_PATTERNS):
+            return "heartbeat_prefix"
+
+    # 4) 单字符误发（保留数字和命令）
+    if noise_env(platform, "SINGLE_CHAR", True):
+        if len(text) == 1 and not text.isalnum() and not text.startswith("/"):
+            return "single_char_symbol"
+        if len(text) == 1 and not text.isdigit() and text.lower() in SINGLE_CHAR_NOISE:
+            return "single_char_noise"
+
+    # 5) 同步重放回声（有同步机制的平台；event_ts 远早于启动窗口）
+    if enable_sync_replay and noise_env(platform, "SYNC_REPLAY", True):
+        if event_ts and startup_ts and event_ts < (startup_ts - 300):
+            return "sync_replay"
+
+    # 6) 语音转文字失败占位符（有 STT 的平台）
+    if enable_stt_failure and noise_env(platform, "STT_FAILURE", True):
+        low = text.lower()
+        if any(p in low for p in STT_FAILURE_PATTERNS):
+            return "stt_failure"
+
+    # 7) 撤回回声
+    if enable_recall and noise_env(platform, "RECALL", True):
+        low = text.lower()
+        if any(p in low for p in RECALL_PATTERNS):
+            return "recall_echo"
+
+    return None
+
+
+# 语义级噪声特征（默认不拦，只记日志——图爸 2026-08-20：微信保守）
+_EMOJI_ONLY_RANGES = (
+    "\U0001F300-\U0001FAFF",  # 各类 emoji 块
+    "\u2600-\u27BF",            # 杂项符号/装饰
+    "\uFE0F",                   # variation selector
+    "\u200D",                   # ZWJ
+)
+
+
+def semantic_reason(body: str, platform: str) -> Optional[str]:
+    """判定语义级噪声（默认不拦只记日志，除非显式开启对应开关）。
+
+    这类噪声可能是真实人类意图（妈妈发个表情、分享个链接），
+    所以默认只记日志观察，不拦截。要拦需显式设 {PLATFORM}_NOISE_FILTER_EMOJI=true 等。
+    """
+    if not noise_enabled(platform):
+        return None
+
+    text = (body or "").strip()
+    if not text:
+        return None
+
+    # 纯表情（默认只记日志，开关 SEMANTIC_EMOJI 默认 false 不拦）
+    import re as _re
+    emoji_pat = "[" + "".join(_EMOJI_ONLY_RANGES) + "]"
+    stripped = _re.sub(emoji_pat, "", text).strip(_PUNCT_STRIP)
+    if not stripped and _re.search(emoji_pat, text):
+        # 是否实际拦截由开关决定（默认 false = 只记日志不拦）
+        if noise_env(platform, "SEMANTIC_EMOJI", False):
+            return "emoji_only"
+        logger.debug("[%s] semantic-noise observed (not blocked): emoji_only %.30r", platform, text)
+        return None
+
+    # 链接卡片无文字（默认只记日志，开关 SEMANTIC_LINK_CARD 默认 false）
+    if text.startswith("http") and len(text) < 120 and " " not in text.strip():
+        if noise_env(platform, "SEMANTIC_LINK_CARD", False):
+            return "link_card_only"
+        logger.debug("[%s] semantic-noise observed (not blocked): link_card_only %.30r", platform, text)
+        return None
+
+    return None
