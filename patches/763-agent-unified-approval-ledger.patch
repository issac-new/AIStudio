+"""统一审批账本（P0b-2）：真实守卫出口与记录语义。"""
+import json
+from pathlib import Path
+
+import pytest
+
+from tools import approval
+from tools.approval_ledger import ledgered_guard, record_approval_decision
+
+
+def _records(tmp_path: Path) -> list[dict]:
+    path = tmp_path / "approval-ledger.jsonl"
+    if not path.exists():
+        return []
+    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line]
+
+
+def test_yolo_allow_is_exempted_without_command_text(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_APPROVAL_LEDGER_DIR", str(tmp_path))
+    record_approval_decision(
+        tool="terminal", result={"approved": True, "message": None},
+        session_id="s1", profile="p1", platform="agent_bridge", mode="yolo",
+    )
+    (record,) = _records(tmp_path)
+    assert record["recordType"] == "approval.exempted"
+    assert record["decidedBy"] == "policy:auto"
+    assert record["mode"] == "yolo"
+    assert record["riskClass"] == "shell"
+    assert record["entryPoint"] == "hermes-agent-bridge"
+    assert record["policyVersion"]
+    assert "command" not in record
+
+
+def test_human_allow_and_deny_are_resolved_with_user_authority(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_APPROVAL_LEDGER_DIR", str(tmp_path))
+    record_approval_decision(
+        tool="terminal", result={"approved": True, "user_approved": True},
+        session_id="s1", profile="p1", platform="agent_bridge", mode="build",
+    )
+    record_approval_decision(
+        tool="terminal", result={"approved": False, "user_consent": False, "outcome": "denied"},
+        session_id="s1", profile="p1", platform="agent_bridge", mode="guarded",
+    )
+    records = _records(tmp_path)
+    assert [r["recordType"] for r in records] == ["approval.resolved", "approval.resolved"]
+    assert [r["decidedBy"] for r in records] == ["user", "user"]
+    assert records[1]["detail"]["outcome"] == "denied"
+
+
+def test_hardline_policy_deny_is_not_mislabeled_human_or_approved(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_APPROVAL_LEDGER_DIR", str(tmp_path))
+    record_approval_decision(
+        tool="terminal", result={"approved": False, "pattern_key": "hardline"},
+        session_id="s1", profile="p1", platform="agent_bridge", mode="yolo",
+    )
+    (record,) = _records(tmp_path)
+    assert record["recordType"] == "approval.resolved"
+    assert record["decidedBy"] == "policy:auto"
+    assert record["mode"] == "yolo"
+    assert record["detail"]["patternKey"] == "hardline"
+
+
+def test_pending_result_is_pending_not_exempted(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_APPROVAL_LEDGER_DIR", str(tmp_path))
+    record_approval_decision(
+        tool="write_file", result={"approval_required": True},
+        session_id="s1", profile="p1", platform="agent_bridge", mode="build",
+    )
+    (record,) = _records(tmp_path)
+    assert record["recordType"] == "approval.pending"
+    assert record["riskClass"] == "write_file"
+    assert record["decidedBy"] == "policy:risk-evaluated"
+
+
+def test_missing_directory_or_write_failure_never_raises(monkeypatch):
+    monkeypatch.delenv("HERMES_APPROVAL_LEDGER_DIR", raising=False)
+    monkeypatch.delenv("HERMES_WEB_UI_HOME", raising=False)
+    record_approval_decision(
+        tool="terminal", result={"approved": True}, session_id="s", profile="p",
+        platform="cli", mode="yolo",
+    )
+
+
+def test_nested_guard_records_only_outermost_result(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_APPROVAL_LEDGER_DIR", str(tmp_path))
+
+    @ledgered_guard(tool="write_file", mode=lambda: "build")
+    def inner():
+        return {"approved": True}
+
+    @ledgered_guard(tool="terminal", mode=lambda: "yolo")
+    def outer():
+        assert inner()["approved"] is True
+        return {"approved": True}
+
+    assert outer()["approved"] is True
+    (record,) = _records(tmp_path)
+    assert record["tool"] == "terminal"
+    assert record["mode"] == "yolo"
+
+
+def test_real_terminal_guard_writes_once_when_session_yolo(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_APPROVAL_LEDGER_DIR", str(tmp_path))
+    monkeypatch.setenv("HERMES_SESSION_KEY", "ledger-test")
+    monkeypatch.setenv("HERMES_SESSION_PLATFORM", "agent_bridge")
+    approval.enable_session_yolo("ledger-test")
+    try:
+        result = approval.check_all_command_guards("echo ledger-test", "local")
+        assert result["approved"] is True
+    finally:
+        approval.disable_session_yolo("ledger-test")
+    records = _records(tmp_path)
+    assert len(records) == 1
+    assert records[0]["entryPoint"] == "hermes-agent-bridge"
+    assert records[0]["sessionId"] == "ledger-test"
