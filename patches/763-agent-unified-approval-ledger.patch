@@ -0,0 +1,128 @@
+"""统一审批账本的 Hermes 写入面（P0b-2）。
+
+只记录守卫终态，不改变审批结果，不保存命令/代码原文。所有业务异常均 fail-soft；
+嵌套守卫只由最外层记账，避免终端守卫与通用审批门重复计数。
+"""
+from __future__ import annotations
+
+import contextvars
+import datetime
+import functools
+import json
+import logging
+import os
+import uuid
+from pathlib import Path
+from typing import Any, Callable
+
+logger = logging.getLogger(__name__)
+
+_GUARD_DEPTH: contextvars.ContextVar[int] = contextvars.ContextVar("approval_ledger_guard_depth", default=0)
+
+_RISK_BY_TOOL = {
+    "read_file": "readonly",
+    "write_file": "write_file",
+    "edit_file": "write_file",
+    "terminal": "shell",
+    "execute_code": "shell",
+    "approval_gate": "shell",
+    "computer_use": "computer_use",
+}
+
+
+def _ledger_path() -> Path | None:
+    explicit = os.environ.get("HERMES_APPROVAL_LEDGER_DIR", "").strip()
+    if explicit:
+        return Path(explicit) / "approval-ledger.jsonl"
+    webui_home = os.environ.get("HERMES_WEB_UI_HOME", "").strip()
+    if not webui_home:
+        return None
+    return Path(webui_home) / "approval-ledger" / "approval-ledger.jsonl"
+
+
+def _entry_point(platform: str) -> str:
+    if platform == "agent_bridge":
+        return "hermes-agent-bridge"
+    return f"hermes:{platform or 'cli'}"
+
+
+def record_approval_decision(
+    *, tool: str, result: dict[str, Any], session_id: str, profile: str,
+    platform: str, mode: str,
+) -> None:
+    """把一次守卫终态写入 append-only JSONL；不落命令、代码、原因原文。"""
+    try:
+        path = _ledger_path()
+        if path is None:
+            return
+        approved = result.get("approved")
+        pending = bool(result.get("approval_required") or result.get("pending_approval"))
+        if pending:
+            record_type = "approval.pending"
+            decided_by = "policy:risk-evaluated"
+        elif approved is True and result.get("user_approved") is True:
+            record_type = "approval.resolved"
+            decided_by = "user"
+        elif approved is True:
+            record_type = "approval.exempted"
+            decided_by = "policy:risk-evaluated" if mode == "guarded" else "policy:auto"
+        elif approved is False:
+            record_type = "approval.resolved"
+            decided_by = "user" if result.get("user_consent") is False else "policy:auto"
+        else:
+            return
+        detail: dict[str, Any] = {}
+        if result.get("outcome"):
+            detail["outcome"] = str(result["outcome"])
+        if result.get("pattern_key"):
+            detail["patternKey"] = str(result["pattern_key"])
+        record = {
+            "recordType": record_type,
+            "tool": str(tool),
+            "riskClass": _RISK_BY_TOOL.get(str(tool), "shell"),
+            "mode": mode if mode in {"build", "guarded", "plan", "yolo"} else "legacy",
+            "policyId": f"four-mode-{mode}" if mode in {"build", "guarded", "plan", "yolo"} else "hermes-approval-legacy",
+            "policyVersion": os.environ.get("HERMES_EXECUTION_CONTRACT_VERSION", "1.0.0"),
+            "sessionId": str(session_id or ""),
+            "profile": str(profile or ""),
+            "entryPoint": _entry_point(platform),
+            "decidedBy": decided_by,
+            "ts": datetime.datetime.now(datetime.timezone.utc).isoformat(),
+            "recordId": str(uuid.uuid4()),
+        }
+        if detail:
+            record["detail"] = detail
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with path.open("a", encoding="utf-8") as handle:
+            handle.write(json.dumps(record, ensure_ascii=False) + "\n")
+    except Exception as exc:
+        logger.warning("approval ledger write failed (tool=%s): %s", tool, type(exc).__name__)
+
+
+def ledgered_guard(*, tool: str, mode: Callable[[], str]):
+    """包装审批守卫：嵌套调用只记最外层，业务返回值原样返回。"""
+    def decorate(fn):
+        @functools.wraps(fn)
+        def wrapped(*args, **kwargs):
+            depth = _GUARD_DEPTH.get()
+            token = _GUARD_DEPTH.set(depth + 1)
+            try:
+                result = fn(*args, **kwargs)
+            finally:
+                _GUARD_DEPTH.reset(token)
+            if depth == 0 and isinstance(result, dict):
+                from tools import approval_context
+
+                profile = (os.environ.get("HERMES_PROFILE_NAME") or os.environ.get("HERMES_PROFILE") or "").strip()
+                if not profile:
+                    profile = Path(os.environ.get("HERMES_HOME", "")).name
+                record_approval_decision(
+                    tool=tool, result=result,
+                    session_id=approval_context.get_current_session_key(default=""),
+                    profile=profile,
+                    platform=approval_context._get_session_platform(),
+                    mode=mode(),
+                )
+            return result
+        return wrapped
+    return decorate
