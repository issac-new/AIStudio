+        return "guarded"
+    return "build"
+
+
+from tools.approval_ledger import ledgered_guard as _ledgered_guard
+
+_run_approval_gate = _ledgered_guard(tool="approval_gate", mode=_approval_ledger_mode)(_run_approval_gate)
+check_all_command_guards = _ledgered_guard(tool="terminal", mode=_approval_ledger_mode)(check_all_command_guards)
+check_execute_code_guard = _ledgered_guard(tool="execute_code", mode=_approval_ledger_mode)(check_execute_code_guard)
+check_dangerous_command = _ledgered_guard(tool="terminal", mode=_approval_ledger_mode)(check_dangerous_command)
