+# turn with AuthError "Unknown provider" — frozen_runtime_config pins the dead name, so live-config
+# heals cannot reach the session. That one failure mode now degrades: resolve the LIVE profile
+# default provider+model with a visible WARNING. Fail-closed everywhere else (see wrapper docstring).
+_INVALID_PROVIDER_FALLBACK_ACTIVE: ContextVar[bool] = ContextVar("_INVALID_PROVIDER_FALLBACK_ACTIVE", default=False)
+
+
 def resolve_runtime_provider(*, requested: Optional[str] = None, explicit_api_key: Optional[str] = None,
                              explicit_base_url: Optional[str] = None, target_model: Optional[str] = None) -> dict[str, Any]:
+    """``_resolve_runtime_provider_once`` plus the frozen-session invalid_provider fallback.
+
+    Only a resolution running inside ``frozen_runtime_config`` (a session receipt route) with
+    ``AuthError(code="invalid_provider")`` falls back to the LIVE profile default provider+model:
+    the frozen snapshot is the broken half and cannot be healed in place. The dead route's
+    explicit key/base_url are dropped (they belong to it), a WARNING naming both ends is logged,
+    and the runtime is stamped ``invalid_provider_fallback={"from", "to_model"}``.
+    Fail-closed: a non-frozen (live) resolution still raises the original AuthError (a live typo
+    is operator-fixable and must stay visible), and when the default route also fails the
+    ORIGINAL dead-provider error is re-raised — the fallback never masks a second real fault.
+    """
+    try:
+        return _resolve_runtime_provider_once(requested=requested, explicit_api_key=explicit_api_key,
+                                              explicit_base_url=explicit_base_url, target_model=target_model)
+    except AuthError as exc:
+        if (getattr(exc, "code", None) != "invalid_provider" or _INVALID_PROVIDER_FALLBACK_ACTIVE.get()
+                or _FROZEN_RUNTIME_CONFIG.get() is None):
+            raise  # fail-closed: live scope, retry already active, or a non-invalid_provider fault
+        dead = (requested or "").strip() or str(_get_model_config().get("provider") or "").strip() or "(auto)"
+        fb_token = _INVALID_PROVIDER_FALLBACK_ACTIVE.set(True)
+        frozen_token = _FROZEN_RUNTIME_CONFIG.set(None)  # the frozen receipt is the broken half; heal from live config
+        try:
+            runtime = resolve_runtime_provider()  # live profile default provider + default model
+        except Exception:
+            raise exc  # default route broken too: surface the ORIGINAL dead-provider AuthError
+        finally:
+            _FROZEN_RUNTIME_CONFIG.reset(frozen_token)
+            _INVALID_PROVIDER_FALLBACK_ACTIVE.reset(fb_token)
+        fallback_model = str(_get_model_config().get("default") or "").strip()
+        runtime["invalid_provider_fallback"] = {"from": dead, "to_model": fallback_model}
+        logger.warning("fallback: %s→%s (invalid_provider)", dead, fallback_model or runtime.get("provider"))
+        return runtime
+# <<< swarm:invalid-provider-fallback <<<
