@@ -0,0 +1,95 @@
+"""Frozen-receipt invalid_provider fallback — t_cd3f31e5 / gap-20261030-038 root fix.
+
+2026-10-22 provider rename custom:cc-switch→cc-switch-route was a half migration: new dm
+sessions froze the dead provider name into their receipts (state_meta key
+``gateway.local_policy.v1:<id>``), and every turn hard-failed with
+``AuthError "Unknown provider 'custom:cc-switch'"`` until a manual heal —
+``frozen_runtime_config`` pins the receipt snapshot, so live-config fixes cannot reach the
+session (worker-coder agent.log 2026-10-24 L1778/L1813).
+
+These tests pin the runtime fallback: a FROZEN route naming a dead provider resolves to the
+LIVE profile default provider+model with a visible WARNING, and stays fail-closed everywhere
+else (live-scope typos raise the original AuthError; a broken default re-raises the ORIGINAL
+dead-provider error instead of masking a second fault).
+"""
+import copy
+import logging
+
+import pytest
+
+from hermes_cli import config as config_mod
+from hermes_cli import runtime_provider as rp
+
+# Live config as healed on 2026-10-26: the custom:cc-switch alias entry is back and the
+# profile default route (model aim) goes through it.
+_LIVE = {
+    "model": {"provider": "custom:cc-switch", "default": "aim"},
+    "custom_providers": [
+        {"name": "custom:cc-switch", "base_url": "http://127.0.0.1:15721",
+         "api_mode": "anthropic_messages"},
+    ],
+}
+# A 10-23..10-26 receipt snapshot: taken AFTER the rename, so the dead name is gone from
+# custom_providers (only cc-switch-route remains) while the frozen route still points at it.
+_FROZEN_DEAD = {
+    "model": {"provider": "custom:cc-switch", "default": "aim"},
+    "custom_providers": [
+        {"name": "cc-switch-route", "base_url": "http://127.0.0.1:15721",
+         "api_mode": "anthropic_messages"},
+    ],
+}
+
+
+@pytest.fixture
+def live_config(monkeypatch):
+    # Patch ONLY the underlying config-module loader: rp.load_config must stay real so the
+    # frozen contextvar keeps serving the frozen snapshot to the first (failing) pass.
+    for var in ("CUSTOM_BASE_URL", "OPENAI_BASE_URL", "OPENAI_API_KEY", "OPENROUTER_API_KEY"):
+        monkeypatch.delenv(var, raising=False)
+    monkeypatch.setattr(config_mod, "load_config", lambda *a, **k: copy.deepcopy(_LIVE))
+
+
+def test_frozen_dead_provider_falls_back_to_live_default(live_config, caplog):
+    """The incident shape: frozen receipt names a provider absent from its own snapshot."""
+    with rp.frozen_runtime_config(copy.deepcopy(_FROZEN_DEAD)):
+        with caplog.at_level(logging.WARNING, logger=rp.logger.name):
+            runtime = rp.resolve_runtime_provider(requested="custom:cc-switch")
+    assert runtime["provider"] == "custom"
+    assert runtime["base_url"] == "http://127.0.0.1:15721"
+    assert runtime["api_mode"] == "anthropic_messages"
+    assert runtime["invalid_provider_fallback"] == {"from": "custom:cc-switch", "to_model": "aim"}
+    assert "fallback: custom:cc-switch→aim (invalid_provider)" in caplog.text
+
+
+def test_frozen_dead_provider_from_receipt_default_falls_back(live_config, caplog):
+    """Same trap with no explicit request: the dead name comes from the frozen model.provider."""
+    with rp.frozen_runtime_config(copy.deepcopy(_FROZEN_DEAD)):
+        with caplog.at_level(logging.WARNING, logger=rp.logger.name):
+            runtime = rp.resolve_runtime_provider()
+    assert runtime["invalid_provider_fallback"]["from"] == "custom:cc-switch"
+    assert runtime["invalid_provider_fallback"]["to_model"] == "aim"
+    assert "fallback: custom:cc-switch→aim (invalid_provider)" in caplog.text
+
+
+def test_live_scope_dead_provider_still_raises(live_config, caplog):
+    """Fail-closed counterexample: outside a frozen receipt the typo must stay visible."""
+    with caplog.at_level(logging.WARNING, logger=rp.logger.name):
+        with pytest.raises(rp.AuthError, match="Unknown provider 'custom:cc-switch-dead'"):
+            rp.resolve_runtime_provider(requested="custom:cc-switch-dead")
+    assert "fallback:" not in caplog.text
+
+
+def test_broken_live_default_reraises_original_error(monkeypatch, caplog):
+    """Fail-closed counterexample: when the live default is broken too, the ORIGINAL
+    dead-provider error surfaces — the fallback never masks a second real fault."""
+    for var in ("CUSTOM_BASE_URL", "OPENAI_BASE_URL", "OPENAI_API_KEY", "OPENROUTER_API_KEY"):
+        monkeypatch.delenv(var, raising=False)
+    monkeypatch.setattr(
+        config_mod, "load_config",
+        lambda *a, **k: {"model": {"provider": "custom:also-dead", "default": "aim"},
+                         "custom_providers": []})
+    with rp.frozen_runtime_config(copy.deepcopy(_FROZEN_DEAD)):
+        with caplog.at_level(logging.WARNING, logger=rp.logger.name):
+            with pytest.raises(rp.AuthError, match="Unknown provider 'custom:cc-switch'"):
+                rp.resolve_runtime_provider(requested="custom:cc-switch")
+    assert "fallback:" not in caplog.text
