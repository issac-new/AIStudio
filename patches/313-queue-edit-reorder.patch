+/** overlay[queue-edit]：按给定 queue_id 顺序重排队列；未列出的保持原相对序排尾部 */
+export function reorderQueueByIds(queue: QueuedRun[], orderedIds: string[]): QueuedRun[] {
+  const byId = new Map(queue.map(q => [q.queue_id, q]))
+  const next: QueuedRun[] = []
+  for (const id of orderedIds) {
+    const item = byId.get(id)
+    if (item) { next.push(item); byId.delete(id) }
+  }
+  for (const q of queue) if (byId.has(q.queue_id)) next.push(q)
+  return next
+}
