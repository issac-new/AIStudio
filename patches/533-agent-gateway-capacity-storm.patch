+                    "(not echoed to chat)", _quick_key)
+                self._queue_capacity_retry(event, source, _quick_key)
+                return None
             return _limit_message
 
         event, source, is_internal = self._hm_rescue_orphaned_fifo(event, source, is_internal, _quick_key)
