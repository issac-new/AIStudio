--- /dev/null
+++ b/tests/hermes_cli/test_kanban_versioned_writes.py
@@ -0,0 +1,149 @@
+"""批二（spec 2026-11-14-superagent-contract-batch2）任务一：行级 version＋迁移 envelope。
+
+覆盖：幂等迁移（旧库补列）、触发器全路径递增（含裸 UPDATE/claim）、complete/block
+CAS 409、兼容缺省放行＋legacy envelope 合成、task_events 四列落库。
+"""
+
+from __future__ import annotations
+
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+
+
+@pytest.fixture
+def kanban_home(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    kb.init_db()
+    return home
+
+
+def _conn() -> sqlite3.Connection:
+    return kbc.connect()
+
+
+def _events(conn, task_id: str) -> list[sqlite3.Row]:
+    return conn.execute(
+        "SELECT * FROM task_events WHERE task_id=? ORDER BY id", (task_id,)
+    ).fetchall()
+
+
+class TestSchema:
+    def test_tasks_version_and_verification_columns_exist(self, kanban_home):
+        cols = {r["name"] for r in _conn().execute("PRAGMA table_info(tasks)")}
+        assert "version" in cols
+        assert "verification" in cols
+
+    def test_task_events_envelope_columns_exist(self, kanban_home):
+        cols = {r["name"] for r in _conn().execute("PRAGMA table_info(task_events)")}
+        assert {"event_version", "actor", "reason", "trace_id"} <= cols
+
+    def test_migration_idempotent_on_legacy_db(self, kanban_home):
+        kb.init_db()
+        conn = _conn()
+        n = conn.execute(
+            "SELECT COUNT(*) FROM sqlite_master WHERE type='trigger' AND name='trg_tasks_version_bump'"
+        ).fetchone()[0]
+        assert n == 1
+
+    def test_new_task_starts_version_zero(self, kanban_home):
+        conn = _conn()
+        tid = kb.create_task(conn, title="v0", assignee="w")
+        v = conn.execute("SELECT version FROM tasks WHERE id=?", (tid,)).fetchone()["version"]
+        assert v == 0
+
+
+class TestVersionBumpAllPaths:
+    def test_raw_update_bumps_via_trigger(self, kanban_home):
+        conn = _conn()
+        tid = kb.create_task(conn, title="t", assignee="w")
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+        v = conn.execute("SELECT version FROM tasks WHERE id=?", (tid,)).fetchone()["version"]
+        assert v >= 1
+
+    def test_claim_bumps_version(self, kanban_home):
+        conn = _conn()
+        tid = kb.create_task(conn, title="t", assignee="w")
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+        v_before = conn.execute("SELECT version FROM tasks WHERE id=?", (tid,)).fetchone()["version"]
+        claimed = kb.claim_task(conn, tid, claimer="w")
+        assert claimed is not None
+        v_after = conn.execute("SELECT version FROM tasks WHERE id=?", (tid,)).fetchone()["version"]
+        assert v_after > v_before
+
+    def test_complete_bumps_version(self, kanban_home):
+        conn = _conn()
+        tid = kb.create_task(conn, title="t", assignee="w")
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+        kb.claim_task(conn, tid, claimer="w")
+        v_before = conn.execute("SELECT version FROM tasks WHERE id=?", (tid,)).fetchone()["version"]
+        assert kb.complete_task(conn, tid, result="done", expected_run_id=None) is True
+        row = conn.execute("SELECT version, status FROM tasks WHERE id=?", (tid,)).fetchone()
+        assert row["status"] == "done" and row["version"] > v_before
+
+
+class TestExpectedVersionCas:
+    def _ready(self, conn):
+        tid = kb.create_task(conn, title="cas", assignee="w")
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+        return tid
+
+    def test_stale_expected_version_rejected_with_current(self, kanban_home):
+        conn = _conn()
+        tid = self._ready(conn)
+        v = conn.execute("SELECT version FROM tasks WHERE id=?", (tid,)).fetchone()["version"]
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET priority=5 WHERE id=?", (tid,))
+        with pytest.raises(Exception) as ei:
+            kb.complete_task(conn, tid, result="late", expected_version=v)
+        assert "version" in str(ei.value).lower()
+        assert conn.execute("SELECT status FROM tasks WHERE id=?", (tid,)).fetchone()["status"] != "done"
+
+    def test_matching_expected_version_passes(self, kanban_home):
+        conn = _conn()
+        tid = self._ready(conn)
+        v = conn.execute("SELECT version FROM tasks WHERE id=?", (tid,)).fetchone()["version"]
+        assert kb.complete_task(conn, tid, result="ok", expected_version=v) is True
+
+    def test_missing_expected_version_compat_passes(self, kanban_home):
+        conn = _conn()
+        tid = self._ready(conn)
+        assert kb.complete_task(conn, tid, result="legacy-ok") is True
+
+
+class TestEventEnvelope:
+    def test_complete_event_carries_envelope_columns(self, kanban_home):
+        conn = _conn()
+        tid = kb.create_task(conn, title="env", assignee="w")
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+        assert kb.complete_task(conn, tid, result="done") is True
+        ev = [e for e in _events(conn, tid) if e["kind"] == "completed"]
+        assert ev, "completed event missing"
+        row = ev[-1]
+        assert isinstance(row["event_version"], int) and row["event_version"] >= 1
+        assert row["actor"]
+        assert row["reason"]
+        assert "legacy" in row["reason"] or "complete" in row["reason"]
+
+    def test_txn_envelope_context_writes_actor_reason_trace(self, kanban_home):
+        conn = _conn()
+        tid = kb.create_task(conn, title="ctx", assignee="w")
+        with kb.write_txn(conn, envelope={"actor": "op:v2", "reason": "manual", "trace_id": "tr-1"}):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+            kb._append_event(conn, tid, "promoted", {"note": "ctx"})
+        row = _events(conn, tid)[-1]
+        assert row["actor"] == "op:v2"
+        assert row["reason"] == "manual"
+        assert row["trace_id"] == "tr-1"
