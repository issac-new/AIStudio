+# ---- live adapter preference ------------------------------------------------
+
+class FakeAdapter:
+    """Stands in for the gateway's authenticated MatrixAdapter."""
+
+    def __init__(self, ok_users=()):
+        self._user_id = "@fanfan:matrix.test"
+        self._homeserver = "http://hs.test"
+        self._access_token = "syt_super_secret_token"
+        self.ok = set(ok_users)
+        self.invited = []
+        self.created = []
+
+    async def invite_user(self, room_id, user):
+        self.invited.append((room_id, user))
+        return user in self.ok
+
+    async def create_room(self, name="", topic="", invite=None, is_direct=False,
+                          preset="private_chat"):
+        self.created.append({"name": name, "topic": topic,
+                             "invite": list(invite or []), "preset": preset})
+        return "!fromadapter:matrix.test"
+
+
+async def _no_http(*_a, **_kw):
+    raise AssertionError("Client-Server API must not be used while the gateway adapter is live")
+
+
+def test_invite_uses_live_adapter_not_the_http_api(creds, monkeypatch):
+    adapter = FakeAdapter(ok_users={"@chen:matrix.test"})
+    monkeypatch.setattr(rt, "_live_matrix_adapter", lambda: adapter)
+    monkeypatch.setattr(rt, "_cs_request", _no_http)
+    out = json.loads(_run(rt.matrix_room_invite(
+        {"room_id": "!room:matrix.test", "users": ["@chen:matrix.test", "@wei:matrix.test"]})))
+    assert adapter.invited == [("!room:matrix.test", "@chen:matrix.test"),
+                               ("!room:matrix.test", "@wei:matrix.test")]
+    assert out["ok"] is False
+    assert out["invited"][0]["result"] == "invited"
+    assert "homeserver refused" in out["failed"][0]["reason"]
+
+
+def test_create_uses_live_adapter(creds, monkeypatch):
