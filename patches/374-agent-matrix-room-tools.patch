+++ b/tests/gateway/test_matrix_room_tools.py
@@ -0,0 +1,414 @@
+"""Tests for the Matrix room-ops agent tools (plugins/platforms/matrix/tools.py).
+
+These tools exist because the RACI dispatch flow needs an Orchestrator to invite
+assignees into a requirement room on its own; the platform adapter already had
+``invite_user()`` but nothing on the agent-callable surface reached it.
+
+The HTTP layer is faked by replacing ``_cs_request`` so no test touches a
+homeserver. One regression guard covers the real bug found during development:
+room ``/state`` returns a bare JSON *list*, which an earlier revision mis-read as
+a mapping, so every room name silently came back blank.
+"""
+import asyncio
+import json
+import os
+from urllib.parse import unquote
+
+import pytest
+
+from plugins.platforms.matrix import tools as rt
+
+
+def _run(coro):
+    return asyncio.run(coro)
+
+
+class FakeHomeserver:
+    """Routes the CS-API paths the tools use; records every call."""
+
+    def __init__(self, joined_rooms=(), members=None, fail_invite=()):
+        self.joined_rooms = list(joined_rooms)
+        self.members = dict(members or {})
+        self.fail_invite = set(fail_invite)
+        self.calls = []
+        self.created = []
+
+    async def __call__(self, homeserver, token, method, path, body=None):
+        self.calls.append((method, path, body))
+        if path.endswith("/joined_rooms"):
+            return 200, {"joined_rooms": self.joined_rooms}
+        if path.endswith("/state/m.room.name"):
+            return 200, {"name": self._room(path).get("name", "")}
+        if path.endswith("/state"):
+            # The trap: a bare list, not a mapping.
+            return 200, [{"type": "m.room.name", "content": {"name": "ignored"}}]
+        if path.endswith("/joined_members"):
+            return 200, {"joined": {m: {} for m in self._room(path).get("joined", [])}}
+        if path.endswith("/invite"):
+            user = (body or {}).get("user_id", "")
+            if user in self.fail_invite:
+                return 403, {"errcode": "M_FORBIDDEN", "error": "You can't invite users to this room"}
+            return 200, {}
+        if path.endswith("/createRoom"):
+            self.created.append(body)
+            return 200, {"room_id": "!newroom:matrix.test"}
+        return 404, {"errcode": "M_UNRECOGNIZED"}
+
+    def _room(self, path: str) -> dict:
+        """Look up a room by the *decoded* ID — tools percent-encode it on the wire."""
+        room = unquote(path.split("/rooms/")[1].split("/")[0])
+        return self.members.get(room, {})
+
+
+@pytest.fixture(autouse=True)
+def no_live_adapter(monkeypatch):
+    """Default to the standalone path so these tests do not depend on whether some
+    gateway happens to be importable in the test process."""
+    monkeypatch.setattr(rt, "_live_matrix_adapter", lambda: None)
+
+
+@pytest.fixture
+def creds(monkeypatch):
+    monkeypatch.setenv("MATRIX_HOMESERVER", "http://hs.test")
+    monkeypatch.setenv("MATRIX_ACCESS_TOKEN", "syt_super_secret_token")
+    monkeypatch.setenv("MATRIX_USER_ID", "@fanfan:matrix.test")
+    # Resolve straight from the environment: whether a test process has a profile
+    # secret scope installed is incidental, and the env-fallback rung differs under it.
+    monkeypatch.setattr(rt, "get_scoped_secret",
+                        lambda name, default="", **kw: os.getenv(name, default))
+    return "syt_super_secret_token"
+
+
+def _install(monkeypatch, fake):
+    monkeypatch.setattr(rt, "_cs_request", fake)
+    return fake
+
+
+# ---- registration surface -------------------------------------------------
+
+def test_registers_three_named_tools():
+    class Ctx:
+        def __init__(self):
+            self.tools = {}
+
+        def register_tool(self, **kw):
+            self.tools[kw["name"]] = kw
+
+    ctx = Ctx()
+    rt.register_tools(ctx)
+    assert set(ctx.tools) == {"matrix_room_invite", "matrix_room_create", "matrix_room_list"}
+    for name, spec in ctx.tools.items():
+        assert spec["toolset"] == "matrix"
+        assert spec["schema"]["name"] == name
+        assert spec["schema"]["parameters"]["type"] == "object"
+        assert callable(spec["handler"])
+    assert ctx.tools["matrix_room_invite"]["schema"]["parameters"]["required"] == ["room_id", "users"]
+    assert ctx.tools["matrix_room_create"]["schema"]["parameters"]["required"] == ["name"]
+
+
+def test_tools_hidden_without_credentials(monkeypatch):
+    for key in ("MATRIX_HOMESERVER", "MATRIX_ACCESS_TOKEN"):
+        monkeypatch.delenv(key, raising=False)
+    monkeypatch.setattr(rt, "get_scoped_secret", lambda *a, **kw: "")
+    assert rt._room_ops_available() is False
+
+
+def test_homeserver_alone_is_not_enough(monkeypatch):
+    monkeypatch.setattr(rt, "get_scoped_secret",
+                        lambda name, *a, **kw: "http://hs.test" if name == "MATRIX_HOMESERVER" else "")
+    assert rt._room_ops_available() is False
+
+
+# ---- credentials ----------------------------------------------------------
+
+def test_credentials_read_from_scope_not_arguments(creds, monkeypatch):
+    """A token must never be an argument a model can pass or echo back."""
+    props = {}
+    class Ctx:
+        def register_tool(self, **kw):
+            props.update(kw["schema"]["parameters"]["properties"])
+    rt.register_tools(Ctx())
+    assert not any("token" in k.lower() for k in props), props
+    homeserver, token, user_id = rt._creds()
+    assert (homeserver, token, user_id) == ("http://hs.test", creds, "@fanfan:matrix.test")
+
+
