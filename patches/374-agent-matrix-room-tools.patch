+def test_list_does_not_misread_bare_state_list(creds, monkeypatch):
+    """Regression: untyped /state returns a JSON list; names must still resolve via
+    the typed endpoint instead of silently blanking out."""
+    seen = []
+    async def route(homeserver, token, method, path, body=None):
+        seen.append(path)
+        if path.endswith("/joined_rooms"):
+            return 200, {"joined_rooms": ["!r:matrix.test"]}
+        if path.endswith("/state/m.room.name"):
+            return 200, {"name": "named room"}
+        if path.endswith("/state"):
+            return 200, [{"type": "m.room.name", "content": {"name": "wrong source"}}]
+        if path.endswith("/joined_members"):
+            return 200, {"joined": {"@x:matrix.test": {}}}
+        return 404, {}
+    monkeypatch.setattr(rt, "_cs_request", route)
+    room = json.loads(_run(rt.matrix_room_list()))["rooms"][0]
+    assert room["name"] == "named room"
