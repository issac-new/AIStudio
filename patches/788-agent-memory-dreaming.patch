+++ b/tests/agent/test_memory_dreaming.py
@@ -0,0 +1,130 @@
+"""Tests for agent/memory_dreaming.py — idle cross-session consolidation (Always-on P5)."""
+
+from __future__ import annotations
+
+import pytest
+
+from agent.memory_dreaming import (
+    DREAM_META_KEY, DREAM_MIN_INTERVAL_SECONDS, run_dreaming,
+)
+
+
+class FakeDB:
+    def __init__(self):
+        self.meta: dict[str, str] = {}
+
+    def get_meta(self, key):
+        return self.meta.get(key)
+
+    def set_meta(self, key, value):
+        self.meta[key] = value
+
+
+class FakeProvider:
+    def __init__(self, reflect_text="stable insight", consolidate=False):
+        self.reflect_text = reflect_text
+        self.calls: list[tuple[str, dict]] = []
+        self.initialized = None
+        self.shutdown_called = False
+        self._bank_id = "bank-1"
+        if consolidate:
+            assert hasattr(self, "_run_hindsight_operation")
+
+    def initialize(self, **kwargs):
+        self.initialized = kwargs
+
+    def handle_tool_call(self, name, args, **kwargs):
+        self.calls.append((name, dict(args)))
+        if name == "hindsight_reflect":
+            return self.reflect_text
+        if name == "hindsight_retain":
+            return "Memory stored successfully."
+        raise AssertionError(f"unexpected tool {name}")
+
+    def shutdown(self):
+        self.shutdown_called = True
+
+
+class ConsolidatingProvider(FakeProvider):
+    def _run_hindsight_operation(self, fn):
+        class Client:
+            def aconsolidate(self, bank_id):
+                Client.bank = bank_id
+                return {"ok": True}
+
+        return fn(Client())
+
+
+@pytest.fixture(autouse=True)
+def _env(monkeypatch):
+    monkeypatch.setenv("HERMES_MEMORY_DREAMING", "1")
+    yield
+
+
+def test_dream_retains_with_tag_and_stamps_budget():
+    db = FakeDB()
+    provider = FakeProvider()
+    result = run_dreaming(now=10_000_000, db=db, provider=provider)
+    assert result["dreamed"] is True
+    assert result["retained_chars"] == len("stable insight")
+    assert db.meta[DREAM_META_KEY] == "10000000"
+    names = [n for n, _ in provider.calls]
+    assert names == ["hindsight_reflect", "hindsight_retain"]
+    retain_args = dict(provider.calls)["hindsight_retain"]
+    assert retain_args["tags"] == ["dream"]
+    assert retain_args["context"] == "dreaming"
+    # provider 由调用方传入：不 shutdown（由调用方管理）
+    assert provider.shutdown_called is False
+
+
+def test_budget_skips_within_24h():
+    db = FakeDB()
+    db.meta[DREAM_META_KEY] = str(1_000_000)
+    provider = FakeProvider()
+    result = run_dreaming(now=1_000_000 + DREAM_MIN_INTERVAL_SECONDS - 1, db=db, provider=provider)
+    assert result == {"dreamed": False, "reason": "budget"}
+    assert provider.calls == []
+
+
+def test_force_bypasses_budget():
+    db = FakeDB()
+    db.meta[DREAM_META_KEY] = str(1_000_000)
+    result = run_dreaming(now=1_000_001, db=db, provider=FakeProvider(), force=True)
+    assert result["dreamed"] is True
+
+
+def test_empty_reflect_does_not_retain_or_stamp():
+    db = FakeDB()
+    provider = FakeProvider(reflect_text="No relevant memories found.")
+    result = run_dreaming(now=10_000_000, db=db, provider=provider)
+    assert result == {"dreamed": False, "reason": "empty"}
+    assert [n for n, _ in provider.calls] == ["hindsight_reflect"]
+    assert DREAM_META_KEY not in db.meta
+
+
+def test_disabled_env(monkeypatch):
+    monkeypatch.setenv("HERMES_MEMORY_DREAMING", "off")
+    result = run_dreaming(now=1, db=FakeDB(), provider=FakeProvider())
+    assert result == {"dreamed": False, "reason": "disabled"}
+
+
+def test_no_provider_configured(monkeypatch):
+    monkeypatch.setattr("agent.memory_dreaming._active_provider_name", lambda: None)
+    result = run_dreaming(now=DREAM_MIN_INTERVAL_SECONDS + 1, db=FakeDB())
+    assert result == {"dreamed": False, "reason": "no-provider"}
+
+
+def test_consolidate_called_when_supported():
+    db = FakeDB()
+    result = run_dreaming(now=10_000_000, db=db, provider=ConsolidatingProvider())
+    assert result["dreamed"] is True
+    assert result["consolidated"] is True
+
+
+def test_reflect_exception_is_fail_soft():
+    class Broken(FakeProvider):
+        def handle_tool_call(self, name, args, **kwargs):
+            raise RuntimeError("backend down")
+
+    result = run_dreaming(now=10_000_000, db=FakeDB(), provider=Broken())
+    assert result == {"dreamed": False, "reason": "reflect-failed"}
