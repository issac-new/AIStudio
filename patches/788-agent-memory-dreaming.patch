+"""空闲 dreaming：跨会话记忆复盘（Always-on Agents P5，2026-11-16）。
+
+语义来源（Anthropic《Building always-on agents》记忆）：agent 空闲时复盘历史会话，
+提炼/更新记忆、淘汰过时信息、挖掘跨会话模式。
+
+实现要点：
+- 只读记忆银行（Hindsight reflect），不重放 transcript；
+- 产出以 tag ``dream`` retain 回同一 bank（可被后续 recall 命中，也可按 tag 审计/清理）；
+- 24h 至多一次（``state_meta: memory:dream:last_at``）；失败 fail-soft，绝不阻断网关；
+- 若底层 client 暴露 ``aconsolidate`` 则顺带合并 observation 层（缺能力跳过——Hindsight
+  服务端版本不承诺该端点）。
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+DREAM_META_KEY = "memory:dream:last_at"
+DREAM_MIN_INTERVAL_SECONDS = 24 * 3600
+DREAM_QUERY = (
+    "复盘最近的工作会话与长期记忆：提炼跨会话重复出现的模式、用户偏好、稳定的约定与"
+    "未完成事项；淘汰已被新信息取代的过时结论。只输出可复用于后续工作的稳定结论，"
+    "不要罗列过程，不要编造未出现过的信息。"
+)
+
+
+def dreaming_enabled() -> bool:
+    import os
+
+    return os.environ.get("HERMES_MEMORY_DREAMING", "1").strip().lower() not in (
+        "0", "false", "off", "no",
+    )
+
+
+def _active_provider_name() -> Optional[str]:
+    try:
+        from plugins.memory import _get_active_memory_provider
+
+        return _get_active_memory_provider()
+    except Exception:  # pragma: no cover - config read failures mean "no provider"
+        return None
+
+
+def _last_dream_at(db: Any) -> float:
+    if db is None:
+        return 0.0
+    try:
+        raw = db.get_meta(DREAM_META_KEY)
+        return float(raw) if raw else 0.0
+    except Exception:
+        return 0.0
+
+
+def _mark_dreamed(db: Any, at: float) -> None:
+    if db is None:
+        return
+    try:
+        db.set_meta(DREAM_META_KEY, str(at))
+    except Exception:
+        logger.debug("dreaming: could not stamp last-dream time", exc_info=True)
+
+
+def _consolidate_if_supported(provider: Any) -> bool:
+    """Hindsight client 有 aconsolidate 才调用；任何异常都跳过（能力探测非承诺）。"""
+    op = getattr(provider, "_run_hindsight_operation", None)
+    bank = getattr(provider, "_bank_id", "")
+    if not callable(op) or not bank:
+        return False
+    try:
+        def _call(client):
+            fn = getattr(client, "aconsolidate", None)
+            return fn(bank_id=bank) if callable(fn) else None
+
+        op(_call)
+        return True
+    except Exception as exc:  # noqa: BLE001 - optional capability
+        logger.debug("dreaming: consolidate skipped: %s", exc)
+        return False
+
+
+def run_dreaming(
+    *,
+    now: Optional[float] = None,
+    db: Any = None,
+    provider: Any = None,
+    force: bool = False,
+) -> dict[str, Any]:
+    """跑一次 dream。返回 ``{dreamed, reason, retained_chars?, consolidated?}``。
+
+    ``db`` 提供 24h 预算（SessionDB 的 get_meta/set_meta）；``provider`` 缺省时按
+    当前 profile 的 ``memory.provider`` 加载（团队部署为 hindsight）。
+    """
+    at = now if now is not None else time.time()
+    if not dreaming_enabled() and not force:
+        return {"dreamed": False, "reason": "disabled"}
+    if not force and at - _last_dream_at(db) < DREAM_MIN_INTERVAL_SECONDS:
+        return {"dreamed": False, "reason": "budget"}
+
+    owns_provider = provider is None
+    if provider is None:
+        name = _active_provider_name()
+        if not name:
+            return {"dreamed": False, "reason": "no-provider"}
+        try:
+            from plugins.memory import load_memory_provider
+
+            provider = load_memory_provider(name, register_skills=False)
+        except Exception as exc:  # noqa: BLE001 - plugin load failures are fail-soft
+            logger.debug("dreaming: provider load failed: %s", exc)
+            return {"dreamed": False, "reason": "provider-load-failed"}
+    if provider is None:
+        return {"dreamed": False, "reason": "provider-unavailable"}
+
+    try:
+        try:
+            provider.initialize(session_id=f"dream-{int(at)}", platform="dreaming")
+        except Exception as exc:  # noqa: BLE001 - some providers initialize lazily
+            logger.debug("dreaming: provider initialize failed (continuing): %s", exc)
+        try:
+            reflect = provider.handle_tool_call("hindsight_reflect", {"query": DREAM_QUERY})
+        except Exception as exc:  # noqa: BLE001 - reflect unsupported/failed
+            logger.debug("dreaming: reflect failed: %s", exc)
+            return {"dreamed": False, "reason": "reflect-failed"}
+        text = str(reflect or "").strip()
+        if not text or text == "No relevant memories found.":
+            return {"dreamed": False, "reason": "empty"}
+        try:
+            provider.handle_tool_call("hindsight_retain", {
+                "content": text,
+                "context": "dreaming",
+                "tags": ["dream"],
+            })
+        except Exception as exc:  # noqa: BLE001 - retain failure means no dream record
+            logger.debug("dreaming: retain failed: %s", exc)
+            return {"dreamed": False, "reason": "retain-failed"}
+        consolidated = _consolidate_if_supported(provider)
+        _mark_dreamed(db, at)
+        logger.info("dreaming: retained %d chars (consolidated=%s)", len(text), consolidated)
+        return {"dreamed": True, "reason": "ok", "retained_chars": len(text), "consolidated": consolidated}
+    finally:
+        if owns_provider:
+            try:
+                provider.shutdown()
+            except Exception:  # noqa: BLE001 - best-effort cleanup
+                logger.debug("dreaming: provider shutdown failed", exc_info=True)
+
+
+def run_dreaming_for_profile(now: Optional[float] = None) -> dict[str, Any]:
+    """watcher 入口：取当前 profile scope 的 SessionDB 与 provider。"""
+    db = None
+    try:
+        from hermes_cli.goals import _get_session_db as _goals_db
+
+        db = _goals_db()
+    except Exception:
+        db = None
+    return run_dreaming(now=now, db=db)
