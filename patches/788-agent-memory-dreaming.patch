@@ -0,0 +1,56 @@
+"""Dreaming watcher：空闲时跨会话记忆复盘（Always-on Agents P5，2026-11-16）。
+
+只在网关无运行中会话（``_running_agents`` 空）且已安静 ≥30 分钟时触发；30 分钟粗节拍
++ provider 侧 24h 预算（``agent/memory_dreaming.py``）。失败 fail-soft：dreaming 是
+锦上添花，永不阻断消息处理。
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import time
+from typing import Optional
+
+logger = logging.getLogger("gateway.run")
+
+IDLE_MIN_SECONDS = 30 * 60
+
+
+class GatewayDreamingMixin:
+    async def _dreaming_watcher(self, interval: float = 1800.0) -> None:
+        from gateway.run import _async_profile_runtime_scope, _resolve_handoff_watch_scopes
+
+        await asyncio.sleep(60)  # let platforms connect before considering idleness
+        # 启动即视为「刚忙过」：给首轮 30 分钟门槛，避免重启风暴里立刻复盘。
+        last_busy = time.time()
+
+        def _scope(profile_home):
+            if profile_home is not None:
+                return _async_profile_runtime_scope(profile_home)
+            from tui_gateway.launch_profile_policy import async_launch_profile_scope_if_multiplexed
+            return async_launch_profile_scope_if_multiplexed()
+
+        while self._running:
+            try:
+                now = time.time()
+                if getattr(self, "_running_agents", None):
+                    last_busy = now
+                elif now - last_busy >= IDLE_MIN_SECONDS:
+                    from agent.memory_dreaming import dreaming_enabled, run_dreaming_for_profile
+
+                    if dreaming_enabled():
+                        for profile_name, profile_home in await _resolve_handoff_watch_scopes(self):
+                            async with _scope(profile_home):
+                                result = await self._run_in_executor_with_context(
+                                    run_dreaming_for_profile, now,
+                                )
+                                if isinstance(result, dict) and result.get("dreamed"):
+                                    logger.info(
+                                        "dreaming: profile=%s retained=%s chars (consolidated=%s)",
+                                        profile_name, result.get("retained_chars"),
+                                        result.get("consolidated"),
+                                    )
+            except Exception as exc:  # noqa: BLE001 - dreaming must never break the gateway
+                logger.debug("dreaming watcher error: %s", exc)
+            await asyncio.sleep(interval)
