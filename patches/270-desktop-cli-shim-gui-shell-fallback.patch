diff --git a/packages/desktop/src/main/cli-shim.ts b/packages/desktop/src/main/cli-shim.ts
index 3f699e08..d239e3d7 100644
--- a/packages/desktop/src/main/cli-shim.ts
+++ b/packages/desktop/src/main/cli-shim.ts
@@ -405,7 +405,12 @@ function shellProfilePaths(homeDir: string, platform: NodeJS.Platform, env: Node
   const shell = env.SHELL?.trim() || ''
   const name = shell.split('/').pop() || ''
   if (name === 'fish') return [join(homeDir, '.config', 'fish', 'conf.d', 'ekko-studio.fish')]
-  if (name === 'bash') return [join(homeDir, '.bash_profile'), join(homeDir, '.bashrc')]
+  // Linux desktop launches (Kylin/UKUI included) often start Electron without
+  // SHELL set; bash is the default there, so write its rc files rather than
+  // only .profile, which interactive bash sessions never read.
+  if (name === 'bash' || (!name && platform === 'linux')) {
+    return [join(homeDir, '.bash_profile'), join(homeDir, '.bashrc')]
+  }
   if (name === 'zsh' || platform === 'darwin') return [join(homeDir, '.zprofile'), join(homeDir, '.zshrc')]
   return [join(homeDir, '.profile')]
 }
