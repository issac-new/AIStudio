+// ─── HERMES_CUSTOM[v020] BEGIN: estimate / projects / board project ────────
+
+export interface KanbanEstimateResult {
+  ok: boolean
+  est_tokens?: number
+  complexity?: 'S' | 'M' | 'L' | null
+  rationale?: string | null
+  model?: string | null
+  reason?: string
+}
+
+export interface KanbanProject {
+  id: string
+  slug: string
+  name: string
+  description?: string | null
+  icon?: string | null
+  color?: string | null
+  board_slug?: string | null
+  primary_path?: string | null
+  archived: boolean
+}
+
+/** Rough token + complexity estimate for an existing task (auxiliary model). */
+export async function estimateTask(taskId: string, opts?: KanbanBoardOptions): Promise<KanbanEstimateResult> {
+  return request<KanbanEstimateResult>(
+    appendQuery(`/api/hermes/kanban/${encodeURIComponent(taskId)}/estimate`, boardParams(opts?.board)),
+    { method: 'POST' },
+  )
+}
+
+/** Estimate from raw title/body — used by the create dialog before a task exists. */
+export async function estimateText(title: string, body?: string): Promise<KanbanEstimateResult> {
+  return request<KanbanEstimateResult>('/api/hermes/kanban/estimate', {
+    method: 'POST',
+    body: JSON.stringify({ title, body }),
+  })
+}
+
+/** List first-class Hermes projects for board scoping. */
+export async function listProjects(): Promise<KanbanProject[]> {
+  const res = await request<{ projects: KanbanProject[] }>('/api/hermes/kanban/projects')
+  return res.projects ?? []
+}
+
+/** Patch a board — currently only the project scope is mutable (null clears). */
+export async function patchBoard(slug: string, patch: { project_id?: string | null }): Promise<{ ok: boolean }> {
+  return request<{ ok: boolean }>(`/api/hermes/kanban/boards/${encodeURIComponent(slug)}`, {
+    method: 'PATCH',
+    body: JSON.stringify(patch),
+  })
+}
+// ─── HERMES_CUSTOM[v020] END ──────────────────────────────────
