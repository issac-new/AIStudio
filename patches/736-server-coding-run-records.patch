+// overlay[execution-records]: run 出口落痕（旁路观测）。appendExecutionRecord 内部
+// 自吞异常，此处不得再包 try 改变主链路行为。outcome 契约见 record.ts：
+// 自然退出 code===0→success、非 0→failed；管理者终止（stop/排队打断/空闲回收/关停）→timeout；
+// 启动前拒绝（更新锁/pty 缺失/spawn 失败/CLI 缺失）→blocked+短码。
+function appendCodingRunRecord(
+  run: ManagedCodingAgentRun,
+  outcome: 'success' | 'failed' | 'timeout' | 'blocked',
+  extras: { exitCode?: number; reason?: string } = {},
+): void {
+  appendExecutionRecord({
+    kind: 'coding-run',
+    runId: run.id,
+    sessionId: run.launch.sessionId,
+    agentId: run.launch.agentId,
+    cli: run.launch.agentId,
+    outcome,
+    exitCode: extras.exitCode,
+    reason: extras.reason,
+    startedAt: run.startedAt,
+    endedAt: Date.now(),
+  })
 }
 
+// overlay[execution-records]: 启动前拒绝——尚无 run 对象，runId 用 agentSessionId（缺省生成一次性 id），
+// 保证被拒绝的尝试不因无 transcript 而隐形。
+function appendCodingLaunchRejected(launch: CodingAgentRunLaunch, reason: string): void {
+  appendExecutionRecord({
+    kind: 'coding-run',
+    runId: launch.agentSessionId || `rejected_${makeId()}`,
+    sessionId: launch.sessionId,
+    agentId: launch.agentId,
+    cli: launch.agentId,
+    outcome: 'blocked',
+    reason,
+    startedAt: Date.now(),
+    endedAt: Date.now(),
+  })
+}
