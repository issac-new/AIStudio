+/**
+ * 历史聚合：跨所有任务合并 task_events + comments，按 created_at 降序。
+ * 用于 cockpit 历史回溯弹窗（避免前端循环调 N 次 GET /:id）。
+ */
+export async function listTimeline(ctx: Context) {
+  const limitRaw = parseInt(ctx.query.limit as string, 10)
+  const limit = Number.isFinite(limitRaw) ? Math.min(Math.max(limitRaw, 1), 500) : 100
+  const since = parseInt(ctx.query.since as string, 10)
+  const sinceTs = Number.isFinite(since) ? since : 0
+
+  const allTasks = await kanbanCli.listTasks({})
+  const items: Array<Record<string, unknown>> = []
+  await Promise.all(allTasks.map(async (t) => {
+    const detail = await kanbanCli.getTask(t.id)
+    if (!detail) return
+    const archived = detail.task.status === 'archived'
+    for (const e of detail.events ?? []) {
+      items.push({
+        source: 'event', id: `evt-${e.id}`, taskId: t.id,
+        taskTitle: t.title, taskArchived: archived,
+        ts: e.created_at, kind: e.kind, payload: e.payload,
+      })
+    }
+    for (const c of detail.comments ?? []) {
+      items.push({
+        source: 'comment', id: `cmt-${c.id}`, taskId: t.id,
+        taskTitle: t.title, taskArchived: archived,
+        ts: c.created_at, author: c.author, body: c.body,
+      })
+    }
+  }))
+
+  const filtered = items
+    .filter(x => (x.ts as number) >= sinceTs)
+    .sort((a, b) => (b.ts as number) - (a.ts as number))
+    .slice(0, limit)
+
+  ctx.body = { items: filtered, total: filtered.length }
+}
