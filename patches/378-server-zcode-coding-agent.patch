@@ -0,0 +1,30 @@
+// overlay[zcode] zcode 引擎事件 → 通用回调面（对齐 grok event-adapter 模式；
+// 回调语义由 run-manager 的 codex 归一化工具消费：text/thought →
+// appendCodexText/appendCodexReasoning，toolStarted/Completed →
+// handleCodexItemStarted/Completed，session → native session 记录）。
+import type { ZcodeStreamEvent } from './streaming-json'
+
+export interface ZcodeEventCallbacks {
+  text: (delta: string) => void
+  thought: (delta: string) => void
+  toolStarted: (value: { id: string; name: string; input: string }) => void
+  toolCompleted: (value: { id: string; output: string; failed: boolean }) => void
+  usage: (usage: import('./streaming-json').ZcodeUsage) => void
+  session: (sessionId: string) => void
+  complete: (usage?: import('./streaming-json').ZcodeUsage) => void
+  error: (message: string) => void
+  status: (message: string) => void
+}
+
+export function applyZcodeStreamEvent(event: ZcodeStreamEvent, cb: ZcodeEventCallbacks): void {
+  switch (event.kind) {
+    case 'text': cb.text(event.delta); return
+    case 'thought': cb.thought(event.delta); return
+    case 'toolStarted': cb.toolStarted({ id: event.id, name: event.name, input: event.input }); return
+    case 'toolCompleted': cb.toolCompleted({ id: event.id, output: event.output, failed: event.failed }); return
+    case 'usage': cb.usage(event.usage); return
+    case 'session': cb.session(event.sessionId); return
+    case 'complete': cb.complete(event.usage); return
+    case 'status': cb.status(event.message); return
+  }
+}
diff --git a/packages/server/src/modules/coding-agents/services/zcode/streaming-json.ts b/packages/server/src/modules/coding-agents/services/zcode/streaming-json.ts
new file mode 100644
index 00000000..a1188a9c
--- /dev/null
+++ b/packages/server/src/modules/coding-agents/services/zcode/streaming-json.ts
@@ -0,0 +1,98 @@
+// overlay[zcode] zcode CLI stream-json 行解析（事件信封与 payload 形状来自
+// R1 实证流 ncwk-sim-aipay/evidence/20260923-zcode-r1/headless-stream.jsonl）。
+// 每行一个 JSON：{type, eventId, sessionId, seq, timestamp, payload?}；
+// 终止行为顶层 {type:'result', sessionId, response, usage?, eventCount}，
+// 产出 session + complete 两条事件。
+export interface ZcodeUsage {
+  input_tokens?: number
+  output_tokens?: number
+  total_tokens?: number
+  cache_read_input_tokens?: number
+}
+
+export type ZcodeStreamEvent =
+  | { kind: 'text'; delta: string }
+  | { kind: 'thought'; delta: string }
+  | { kind: 'toolStarted'; id: string; name: string; input: string }
+  | { kind: 'toolCompleted'; id: string; output: string; failed: boolean }
+  | { kind: 'usage'; usage: ZcodeUsage }
+  | { kind: 'session'; sessionId: string }
+  | { kind: 'complete'; usage?: ZcodeUsage; response: string }
+  | { kind: 'status'; message: string }
+
+function mapUsage(raw: any): ZcodeUsage | undefined {
+  if (!raw || typeof raw !== 'object') return undefined
+  const pick = (v: unknown): number | undefined =>
+    typeof v === 'number' && v >= 0 ? v : undefined
+  const usage: ZcodeUsage = {
+    input_tokens: pick(raw.inputTokens ?? raw.input_tokens),
+    output_tokens: pick(raw.outputTokens ?? raw.output_tokens),
+    total_tokens: pick(raw.totalTokens ?? raw.total_tokens),
+    cache_read_input_tokens: pick(raw.cacheReadTokens ?? raw.cache_read_input_tokens),
+  }
+  return usage.total_tokens === undefined && usage.input_tokens === undefined
+    ? undefined
+    : usage
+}
+
+/** 解析一行 stream-json；无事件行返回空数组。 */
+export function parseZcodeStreamLineEvents(line: string): ZcodeStreamEvent[] {
+  const trimmed = line.trim()
+  if (!trimmed) return []
+  let event: any
+  try {
+    event = JSON.parse(trimmed)
+  } catch {
+    return []
+  }
+  if (!event || typeof event !== 'object') return []
+  const type = String(event.type || '').trim()
+
+  if (type === 'result') {
+    const out: ZcodeStreamEvent[] = []
+    const sessionId = String(event.sessionId || '').trim()
+    if (sessionId) out.push({ kind: 'session', sessionId })
+    out.push({ kind: 'complete', usage: mapUsage(event.usage), response: String(event.response || '') })
+    return out
+  }
+
+  const payload = event.payload || {}
+  if (type === 'model.streaming') {
+    const streamKind = String(payload.kind || '')
+    if (streamKind === 'text_delta') return [{ kind: 'text', delta: String(payload.delta || '') }]
+    if (streamKind === 'reasoning_delta') return [{ kind: 'thought', delta: String(payload.delta || '') }]
+    return []
+  }
+  if (type === 'tool.updated') {
+    const toolKind = String(payload.kind || '')
+    const id = String(payload.toolCallId || '').trim()
+    if (toolKind === 'scheduled') {
+      return [{ kind: 'toolStarted', id, name: String(payload.toolName || ''), input: String(payload.input || '') }]
+    }
+    if (toolKind === 'result' || toolKind === 'error') {
+      const resultRaw = payload.result ?? payload.error
+      let output: string
+      if (resultRaw && typeof resultRaw === 'object') {
+        const content = (resultRaw as any).content
+        output = typeof content === 'string' ? content : JSON.stringify(resultRaw)
+      } else {
+        output = String(resultRaw ?? '')
+      }
+      return [{ kind: 'toolCompleted', id, output, failed: toolKind === 'error' }]
+    }
+    return []
+  }
+  if (type === 'turn.completed') {
+    const usage = mapUsage(payload.usage || payload.tokenCount)
+    return usage ? [{ kind: 'usage', usage }] : []
+  }
+  if (type === 'session.created') {
+    const sessionId = String(event.sessionId || '').trim()
+    return sessionId ? [{ kind: 'session', sessionId }] : []
+  }
+  if (type === 'turn.started') {
+    return [{ kind: 'status', message: `turn ${payload.turnNumber ?? ''}`.trim() }]
+  }
+  // session.updated/session.titleUpdated/session.resumed/batch 等：无 UI 语义
+  return []
+}
diff --git a/packages/server/src/modules/coding-agents/services/zcode/turn-process.ts b/packages/server/src/modules/coding-agents/services/zcode/turn-process.ts
new file mode 100644
index 00000000..b8bb27bc
--- /dev/null
+++ b/packages/server/src/modules/coding-agents/services/zcode/turn-process.ts
@@ -0,0 +1,55 @@
+// overlay[zcode] zcode 无头 CLI 回合进程：spawn node <cjs> -p … --output-format
+// stream-json（prompt 走 argv，非 stdin——与 codex exec 的 `-` 位置参数不同）。
+// 每回合一个进程；resume 用 --resume <sessionId>（sessionId 来自 result 行）。
+import { spawn, type ChildProcess } from 'child_process'
+import { parseZcodeStreamLineEvents, type ZcodeStreamEvent, type ZcodeUsage } from './streaming-json'
+
+export interface ZcodeTurnProcessInput {
+  cliEntry: string
+  workspaceDir: string
+  env: NodeJS.ProcessEnv
+  nativeSessionId: string
+  resume: boolean
+  input: string
+  onEvent: (event: ZcodeStreamEvent) => void
+  onStderr: (chunk: Buffer) => void
+  onError: (error: Error) => void
+  onClose: (code: number | null) => void
+}
+
+export function buildZcodeTurnArgs(input: ZcodeTurnProcessInput): string[] {
+  return [
+    input.cliEntry,
+    '--output-format', 'stream-json',
+    '--cwd', input.workspaceDir,
+    ...(input.nativeSessionId && input.resume ? ['--resume', input.nativeSessionId] : []),
+    '-p', input.input,
+  ]
+}
+
+export function startZcodeTurnProcess(input: ZcodeTurnProcessInput): ChildProcess {
+  const child = spawn(process.execPath, buildZcodeTurnArgs(input), {
+    cwd: input.workspaceDir,
+    env: input.env,
+    stdio: ['ignore', 'pipe', 'pipe'],
+    windowsHide: true,
+  })
+  let stdoutBuffer = ''
+  child.stdout?.on('data', (chunk: Buffer) => {
+    stdoutBuffer += chunk.toString('utf8')
+    const lines = stdoutBuffer.split(/\r?\n/)
+    stdoutBuffer = lines.pop() || ''
+    for (const line of lines) {
+      for (const event of parseZcodeStreamLineEvents(line)) input.onEvent(event)
+    }
+  })
+  child.stderr?.on('data', input.onStderr)
+  child.on('error', (error) => input.onError(error))
+  child.on('close', (code) => {
+    for (const event of parseZcodeStreamLineEvents(stdoutBuffer)) input.onEvent(event)
+    input.onClose(code)
+  })
+  return child
+}
+
+export type { ZcodeUsage }
