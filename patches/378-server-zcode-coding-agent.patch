@@ -0,0 +1,26 @@
+// overlay[zcode] ZCode coding agent definition（受管 fork，见 overlay zcode-patches/）。
+// zcode 是本仓二开底座（specs/2026-09-23-zcode-foundation-design.md）：CLI 入口
+// 是 upstream/zcode 的构建产物 dist/zcode.cjs（node 直跑），无全局 bin——
+// command 固定为 node，cjs 路径在 launch prep 与探测处解析。
+import { existsSync } from 'fs'
+import { resolve } from 'path'
+
+export const ZCODE_CODING_AGENT_DEFINITION = {
+  id: 'zcode',
+  name: 'ZCode',
+  provider: 'ZAI',
+  command: 'node',
+  packageName: 'zcode',
+} as const
+
+/** 解析 zcode CLI 构建产物路径：ZCODE_CLI_CJS env 覆盖 > ncwk/upstream/zcode 相对 cwd。 */
+export function resolveZcodeCliEntry(): string | null {
+  const override = String(process.env.ZCODE_CLI_CJS || '').trim()
+  if (override) return override
+  // server 以 upstream/hermes-studio 为 cwd 启动（serve-server.mjs），
+  // zcode 仓与其同级。cwd 不匹配时返回 null → 探测报未安装（诚实态）。
+  const candidate = resolve(
+    process.cwd(), '../zcode/apps/zcode-cli/packages/cli/dist/zcode.cjs',
+  )
+  return existsSync(candidate) ? candidate : null
+}
