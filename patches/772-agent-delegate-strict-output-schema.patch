diff --git a/tests/tools/test_delegate_strict_output_schema.py b/tests/tools/test_delegate_strict_output_schema.py
new file mode 100644
--- /dev/null
+++ b/tests/tools/test_delegate_strict_output_schema.py
@@ -0,0 +1,151 @@
+"""772 strict_output_schema（spec 2026-11-13-superagent-contract-closure）。
+
+每任务可选 ``strict_output_schema: boolean``（默认 false）：
+- true 时必须有合法 output_schema（spawn 前拒绝）；
+- 一次既有纠正后仍不合格 → status=failed、exit_reason=output_schema_invalid，
+  原始文本保留在 summary（失败关闭，不冒充完成）；
+- interrupted / 执行错误 / max_iterations 的原始终止原因不被覆盖；
+- 默认宽松行为字节级不变（原 test_delegate_output_schema 互证）。
+"""
+
+from tools.delegate_tool import DELEGATE_TASK_SCHEMA, _run_single_child
+from tools.delegate_tool_tasks import _validate_strict_flags
+
+
+ADDRESS_SCHEMA = {
+    "type": "object",
+    "properties": {"city": {"type": "string"}},
+    "required": ["city"],
+}
+
+PROSE = 'Findings:\n```json\n{"town": "Oslo"}\n```\nlet me know.'
+
+
+class _StubChild:
+    """Minimal child double（照 test_delegate_output_schema:117-151，结果改为
+    全量 dict 以便逐例控制 completed/interrupted）。"""
+
+    tool_progress_callback = None
+    _delegate_saved_tool_names: list = []
+    _credential_pool = None
+    _subagent_id = None
+    _delegate_depth = 1
+    _parent_subagent_id = None
+    _delegate_output_schema = None
+    _delegate_strict_output = False
+    model = "test-model"
+    session_prompt_tokens = 0
+    session_completion_tokens = 0
+    session_estimated_cost_usd = 0.0
+    session_reasoning_tokens = 0
+    session_cost_status = None
+
+    def __init__(self, results):
+        self.results = [dict(r) for r in results]
+        self.calls: list = []
+
+    def get_activity_summary(self):
+        return {"api_call_count": 1, "max_iterations": 5, "current_tool": None}
+
+    def run_conversation(self, user_message, task_id=None, **_kwargs):
+        self.calls.append(user_message)
+        r = dict(self.results.pop(0))
+        r.setdefault("final_response", "")
+        r.setdefault("completed", True)
+        r.setdefault("api_calls", 1)
+        r.setdefault("messages", [])
+        return r
+
+    def close(self):
+        return None
+
+
+class _StubParent:
+    _current_task_id = None
+    _delegate_depth = 0
+
+    def _touch_activity(self, _desc):
+        return None
+
+
+def _run(child):
+    return _run_single_child(0, "produce the address", child, _StubParent())
+
+
+class TestStrictFailClosed:
+    def test_strict_fail_twice_is_failed_with_raw_summary(self):
+        child = _StubChild([{"final_response": PROSE}, {"final_response": PROSE}])
+        child._delegate_output_schema = ADDRESS_SCHEMA
+        child._delegate_strict_output = True
+        entry = _run(child)
+        assert entry["status"] == "failed"
+        assert entry["exit_reason"] == "output_schema_invalid"
+        assert entry["summary"] == PROSE
+        assert entry["schema_valid"] is False
+        assert entry["schema_errors"]
+        assert entry["schema_retries"] == 1
+        assert len(child.calls) == 2  # 既有唯一一次纠正
+        assert "strict_output_schema" in entry["error"]
+
+    def test_strict_retry_then_valid_stays_completed(self):
+        child = _StubChild([{"final_response": PROSE}, {"final_response": '{"city": "Oslo"}'}])
+        child._delegate_output_schema = ADDRESS_SCHEMA
+        child._delegate_strict_output = True
+        entry = _run(child)
+        assert entry["status"] == "completed"
+        assert entry["exit_reason"] == "completed"
+        assert entry["schema_valid"] is True
+        assert "error" not in entry
+
+    def test_strict_budget_exhausted_keeps_max_iterations_reason(self):
+        child = _StubChild([
+            {"final_response": PROSE, "completed": False},
+            {"final_response": PROSE},
+        ])
+        child._delegate_output_schema = ADDRESS_SCHEMA
+        child._delegate_strict_output = True
+        entry = _run(child)
+        # 预算耗尽保留既有语义：状态仍 completed（truncated 旗标承载预算事实），
+        # 严格标志只补 schema_valid=false，不改终止类结果。
+        assert entry["status"] == "completed"
+        assert entry["exit_reason"] == "max_iterations"
+        assert entry["truncated"] is True
+        assert entry["schema_valid"] is False
+
+    def test_strict_interrupted_keeps_interrupted_reason(self):
+        child = _StubChild([{"final_response": PROSE, "interrupted": True}])
+        child._delegate_output_schema = ADDRESS_SCHEMA
+        child._delegate_strict_output = True
+        entry = _run(child)
+        assert entry["status"] == "interrupted"
+        assert entry["exit_reason"] == "interrupted"
+        assert len(child.calls) == 1  # 中断不做 schema 纠正
+
+    def test_lenient_default_unchanged_completed_with_raw_text(self):
+        child = _StubChild([{"final_response": PROSE}, {"final_response": PROSE}])
+        child._delegate_output_schema = ADDRESS_SCHEMA
+        entry = _run(child)
+        assert entry["status"] == "completed"
+        assert entry["summary"] == PROSE
+        assert entry["schema_valid"] is False
+        assert "UNVALIDATED" in entry["schema_note"]
+
+
+class TestSpawnPreValidation:
+    def test_strict_without_schema_rejected(self):
+        err = _validate_strict_flags([{"goal": "g", "strict_output_schema": True}], [None])
+        assert err and "output_schema" in err
+
+    def test_non_bool_strict_rejected(self):
+        err = _validate_strict_flags([{"goal": "g", "strict_output_schema": "yes"}], [ADDRESS_SCHEMA])
+        assert err and "boolean" in err
+
+    def test_false_and_absent_pass(self):
+        assert _validate_strict_flags([{"goal": "g", "strict_output_schema": False}], [None]) is None
+        assert _validate_strict_flags([{"goal": "g"}], [ADDRESS_SCHEMA]) is None
+
+
+class TestSchemaAdvertise:
+    def test_strict_flag_advertised_per_task(self):
+        props = DELEGATE_TASK_SCHEMA["parameters"]["properties"]["tasks"]["items"]["properties"]
+        assert props["strict_output_schema"]["type"] == "boolean"
