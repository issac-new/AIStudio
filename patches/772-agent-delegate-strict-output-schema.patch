+def _validate_strict_flags(
+    task_list: list[dict[str, Any]], task_schemas: list[Optional[dict[str, Any]]]
+) -> Optional[str]:
+    """补丁 772（2026-11-13 超级智能体吸收批一）：``strict_output_schema`` 预检。
+
+    严格合同必须显式声明且自带 schema——非布尔值或 strict=true 而无 output_schema
+    在任何子代理启动前拒绝整个调用（返回可操作错误；None=通过）。
+    """
+    for i, task in enumerate(task_list):
+        raw = task.get("strict_output_schema")
+        if raw is None:
+            continue
+        if not isinstance(raw, bool):
+            return f"Task {i} strict_output_schema must be a boolean, got {type(raw).__name__}."
+        if raw and not (i < len(task_schemas) and isinstance(task_schemas[i], dict)):
+            return (
+                f"Task {i} sets strict_output_schema=true but declares no output_schema; "
+                "add the schema on the same task or drop the strict flag."
+            )
+    return None
+
 def _coerce_task_schemas(
     task_list: list[dict[str, Any]], output_schema: Optional[dict[str, Any]]
 ) -> tuple[list[Optional[dict[str, Any]]], Optional[str]]:
