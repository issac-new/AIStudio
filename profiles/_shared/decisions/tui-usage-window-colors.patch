+// Compact usage + last-request line for the active cc switch provider, merged
+// into the status bar's tail (lowest-priority segment, drops first on narrow
+// terminals). Replaces the old standalone dock-top widget row.
+function useCcSwitchExtra(): CcExtra {
+  const [extra, setExtra] = useState<CcExtra>({ text: '', segs: [] })
+
+  useEffect(() => {
+    let cancelled = false
+
