+// A single colored segment of the cc-extra status line.
+// `t` is the text shown; `k` is a semantic key the renderer maps to a theme
+// color (prov | usage | usagePct | latency | tokens | status | statusOk |
+// statusErr | ip | sep). Numbers get urgency-based colors: high usage → warn,
+// slow latency → warn, non-200 status → error, 200 → good.
+type CcSegment = { t: string; k?: string }
+
+// Structured cc-switch status: `text` for width math, `segs` for colored render.
+type CcExtra = { text: string; segs: CcSegment[] }
+
+// Map a usage percentage to a semantic urgency key.
+function usageKey(pct: number | null): string {
+  if (pct == null) {return 'usage'}
+
+  if (pct >= 80) {return 'usageBad'}
+
+  if (pct >= 50) {return 'usageWarn'}
+
+  return 'usageOk'
+}
+
+// >>> swarm:usage-window-colors >>> per-window usage coloring
+// One usage window chunk (e.g. "5h 62% ↻3h") plus its raw percentage, so each
+// window (5h / 7d / mo) carries its own green/yellow/red urgency color.
+type UsagePiece = { t: string; pct?: number | null }
+
+// Render usage pieces as colored segments: each window keyed by its own
+// percentage (usageKey); separators between windows stay muted. `sep` lets the
+// caller keep its historical separator (' | ' for kimi/bigmodel, ' │ ' for volc).
+function usagePiecesToSegs(pieces: UsagePiece[], sep = ' | '): CcSegment[] {
+  const segs: CcSegment[] = []
+
+  pieces.forEach((p, i) => {
+    if (i > 0) {segs.push({ t: sep, k: 'sep' })}
+
+    segs.push({ t: p.t, k: p.pct == null ? 'usage' : usageKey(p.pct) })
+  })
+
+  return segs
+}
+// <<< swarm:usage-window-colors <<<
+
+// Map a latency in ms to a semantic urgency key.
+function latencyKey(ms: number | null): string {
+  if (ms == null) {return 'latency'}
+
+  if (ms >= 30000) {return 'latencyBad'}
+
+  if (ms >= 10000) {return 'latencyWarn'}
+
+  return 'latencyOk'
+}
