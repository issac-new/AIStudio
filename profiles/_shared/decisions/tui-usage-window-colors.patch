+        // a circuit-breaker trip or manual failover, /status reports the new
+        // active provider while is_current still points at the old one. Querying
+        // by is_current would return the stale provider's model, usage, token,
+        // and last-request row — making the status bar freeze on old data.
+        const provRes = await fetch('http://127.0.0.1:15721/status', { signal: AbortSignal.timeout(2500) }).then(r => r.ok ? r.json() as { current_provider?: string; current_provider_id?: string } : null).catch(() => null)
+        const provId = provRes?.current_provider_id || ''
+        // Fallback to is_current if the proxy is unreachable or the id is absent.
+        const whereClause = provId && /^[\w-]+$/.test(provId) ? `p.id='${provId}'` : `p.is_current=1`
+
+        const rows = JSON.parse(sql(`SELECT json_extract(p.settings_config,'$.env.ANTHROPIC_AUTH_TOKEN') as token, json_extract(p.settings_config,'$.env.ANTHROPIC_BASE_URL') as baseUrl, p.name, p.id, p.meta FROM providers p WHERE p.app_type='claude' AND ${whereClause} LIMIT 1;`) || '[]')
+
+        if (!rows.length) {return}
+        const r = rows[0]
+        const name = r.name || ''
+        const baseUrl = (r.baseUrl || '').toLowerCase()
+        const token = r.token || ''
+        let meta: any = {}
+
+        try {
+          meta = JSON.parse(r.meta || '{}')
+        } catch {
+          meta = {}
+        }
+
+        // public IP + weather (cached 10 min via fetchIpWeather)
+        const ipw = await fetchIpWeather()
+
+        // usage by provider type — each window (5h/7d/mo) is a separate
+        // piece carrying its own percentage so it gets its own color
+        // (>>> swarm:usage-window-colors <<<)
+        let usageText = ''
