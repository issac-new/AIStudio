+          usageText = `5h ${h5}${h5Reset ? ' ' + h5Reset : ''} | 7d ${d7}${d7Reset ? ' ' + d7Reset : ''}`
+
+          // percentage strings like "62%" → numeric pct for color mapping
+          const pctOf = (s: string): number | null => {
