+// Poll the local cc switch proxy (127.0.0.1:15721) for the ACTUAL upstream
+// provider+model. The proxy ignores the requested model name and routes to
+// whichever provider is active in its failover queue, so the declared model
+// (e.g. "glm-5.2") is often wrong. Returns "provider/model" or '' on failure.
+function useCcSwitchModel(): string {
+  const [model, setModel] = useState('')
+
+  useEffect(() => {
+    let cancelled = false
+
+    async function poll() {
+      try {
+        const res = await fetch('http://127.0.0.1:15721/status', {
+          signal: AbortSignal.timeout(2500)
+        })
+
+        if (!res.ok) {return}
+        const j = await res.json() as { current_provider?: string; current_provider_id?: string }
+        const provider = j.current_provider || ''
+        const providerId = j.current_provider_id || ''
+
+        if (!provider || cancelled) {return}
+        // Query the cc-switch SQLite DB for the actual model on the RUNTIME
+        // current provider (from /status), NOT the DB is_current flag. The
+        // is_current flag reflects the user's manual selection and lags
+        // behind proxy failover/circuit-breaker switches — after a failover
+        // the proxy routes to a different provider while is_current still
+        // points at the old one, making the status bar show stale model+usage.
+        const { execSync } = await import('child_process')
+        const dbPath = (process.env.HOME || '') + '/.cc-switch/cc-switch.db'
+        const sqlWhere = providerId && /^[\w-]+$/.test(providerId) ? `p.id='${providerId}'` : `p.is_current=1`
+        const sql = `SELECT json_extract(p.settings_config, '$.env.ANTHROPIC_MODEL') as model FROM providers p WHERE p.app_type='claude' AND ${sqlWhere} LIMIT 1;`
+        const out = execSync(`sqlite3 -json "${dbPath}" "${sql.replace(/\n/g, ' ')}"`, { timeout: 2000 }).toString().trim()
+        const rows = out ? JSON.parse(out) : []
+        const actualModel = rows.length ? rows[0].model : ''
+
+        if (!cancelled) {setModel(`${provider}/${actualModel}`)}
+      } catch {
+        // cc switch not running — leave model empty so ui.info.model is used
+      }
+    }
+
+    poll()
+    const id = setInterval(poll, 5000)
+
+    return () => { cancelled = true; clearInterval(id) }
+  }, [])
+
+  return model
+}
