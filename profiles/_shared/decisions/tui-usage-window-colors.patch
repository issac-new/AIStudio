+        } else {
+          // rate-limit proxy for weekly-z.ai / opus5 etc.
+          const reqs = JSON.parse(sql(`SELECT COUNT(*) as n FROM proxy_request_logs WHERE provider_id='${r.id}' AND created_at >= strftime('%s','now','-1 hour');`) || '[]')
+          const n = reqs.length ? Number(reqs[0].n) : 0
+          usagePct = Number((n / 500 * 100).toFixed(0))
+          usageText = `${usagePct}%`
+        }
+
+        // last request — tokens, latency, status, time (compact: ms→s, drop model)
+        const lr = JSON.parse(sql(`SELECT latency_ms, first_token_ms, input_tokens, output_tokens, status_code, error_message, datetime(created_at,'unixepoch','localtime') as ts FROM proxy_request_logs ORDER BY created_at DESC LIMIT 1;`) || '[]')
+        const lr0 = lr.length ? lr[0] : null
+        const latMs = lr0 ? lr0.latency_ms : null
+        const fmtMs = (ms: number | null) => ms == null ? '' : ms >= 1000 ? `${(ms / 1000).toFixed(0)}s` : `${ms}ms`
+        const lastL = fmtMs(latMs)
+        const lastFT = lr0 && lr0.first_token_ms != null ? `ttft${fmtMs(lr0.first_token_ms)}` : ''
+        const lastTok = lr0 ? `${fmtK(lr0.input_tokens || 0)}\u2192${fmtK(lr0.output_tokens || 0)}` : ''
+        const isOk = lr0 ? lr0.status_code === 200 : false
