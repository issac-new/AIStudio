+          const d7 = ((u.limits || [])[0] || {}).detail || {}
+          const d7Pct = u.usage?.limit !== '?' && u.usage?.remaining !== '?' ? Number(((1 - Number(u.usage?.remaining) / Number(u.usage?.limit)) * 100).toFixed(0)) : null
+          const h5Pct = d7.limit && d7.used ? Number((Number(d7.used) / Number(d7.limit) * 100).toFixed(0)) : null
+          usagePct = d7Pct ?? h5Pct
+          usageText = `5h ${h5Pct ?? '?'}% | 7d ${d7Pct ?? '?'}%`
+          usageSegs = usagePiecesToSegs([
+            { t: `5h ${h5Pct ?? '?'}%`, pct: h5Pct },
+            { t: `7d ${d7Pct ?? '?'}%`, pct: d7Pct },
+          ])
+        } else if (baseUrl.includes('open.bigmodel.cn')) {
+          const u = await (await fetch('https://open.bigmodel.cn/api/monitor/usage/quota/limit', { headers: { Authorization: 'Bearer ' + token }, signal: AbortSignal.timeout(3000) })).json() as { data?: { limits?: Array<{ type?: string; unit?: number; percentage?: number; nextResetTime?: number }> } }
+          let h5 = '?', d7 = '?', h5Reset = '', d7Reset = ''
+
+          // Reset countdown: API returns nextResetTime (epoch ms). Show as
+          // ↻Xh Ym (5h window) / ↻Xd Yh (7d window) — user-requested 09-05.
+          const fmtReset = (ms?: number): string => {
+            if (!ms) {return ''}
+            const left = ms - Date.now()
+
+            if (left <= 0) {return '↻now'}
