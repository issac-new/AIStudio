+def _g2_lineage_markings(conn, task_id: str):
+    """Compute inherited markings for `task_id` using the gate module's own
+    parsing helpers, tolerating boards whose tasks table predates the
+    markings/metadata columns (SELECT falls back to (id, body); the gate's
+    column/metadata readers then yield empty sets and its §5.1 leaf default
+    {TLP:GREEN} applies — identical semantics to clearance_gate on a schema
+    where the columns exist). Returns None when a lineage node is unreadable
+    (same fail-closed contract as compute_inherited_markings)."""
+    import sqlite3 as _sq
+
+    gate = _clearance_gate_mod
+    seen, stack = set(), [task_id]
+    inherited = set()
+    while stack:
+        cur = stack.pop()
+        if cur in seen:
+            continue  # cycle-safe
+        seen.add(cur)
+        try:
+            cur_desc = conn.execute(
+                "SELECT id, markings, metadata, body FROM tasks WHERE id = ?",
+                (cur,)).description
+        except Exception:
+            cur_desc = None
+        want = [c[0] for c in cur_desc] if cur_desc else ["id", "body"]
+        try:
+            row = conn.execute(
+                f"SELECT {', '.join(want)} FROM tasks WHERE id = ?", (cur,)).fetchone()
+        except Exception:
+            row = None
+        if row is None:
+            return None  # unreadable/missing node -> fail-closed
+        d = dict(zip(want, row))
+        mk = gate._markings_from_column(d.get("markings"))
+        if not mk:
+            mk = gate._markings_from_metadata(d.get("metadata"))
+        if not mk:
+            mk = gate._markings_from_body(d.get("body") or "")
+        if not mk:
+            mk = {"TLP:GREEN"}  # gate §5.1 leaf default
+        inherited |= mk
+        try:
+            stack.extend(r[0] for r in conn.execute(
+                "SELECT parent_id FROM task_links WHERE child_id = ?", (cur,)))
+        except Exception:
+            pass  # no task_links table -> leaf
+    return inherited
