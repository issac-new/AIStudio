+++ b/tools/mcp_tool_registration.py
@@ -257,6 +257,20 @@ def _tool_candidates(name: str, tools: Iterable[Any], should_register: Callable[
         if not should_register(t.name):
             logger.debug("MCP server '%s': skipping tool '%s' (filtered by config)", name, t.name)
             continue
+        # >>> swarm:tool_schema_gate >>>
+        # Pre-admission schema gate (gap-20260922-004): scan the FULL tool def
