{
  "id": "memos-local-plugin",
  "name": "MemOS Local Memory (V7)",
  "description": "Reflect2Evolve V7 memory — L1/L2/L3 + skill crystallization + tier 1/2/3 retrieval + decision repair.",
  "kind": "memory",
  "version": "2.0.7",
  "homepage": "https://github.com/MemTensor/MemOS",
  "requirements": { "node": ">=20.0.0" },
  "extensions": ["./dist/adapters/openclaw/index.js"],
  "contracts": {
    "tools": [
      "memos_search",
      "memos_get",
      "memos_timeline",
      "memos_skill_list",
      "memos_environment",
      "memos_skill_get"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "description": "Edit $HOME/.openclaw/memos-plugin/config.yaml to tune LLM / embedding / viewer.",
    "properties": {
      "viewerPort": { "type": "number", "description": "Memory Viewer HTTP port (default 18799)" }
    }
  }
}
