# Hermes Agent — .env Example Template

# Copy this file to .env and fill in your actual values.
# Each profile (orchestrator, worker-coder, etc.) needs its own .env.

# === LLM Provider ===
DEEPSEEK_API_KEY=sk-your-deepseek-key

# === Matrix (if using Matrix gateway) ===
MATRIX_ACCESS_TOKEN=your-matrix-token
MATRIX_HOMESERVER=http://your-homeserver:8008
MATRIX_USER_ID=@user:homeserver
MATRIX_HOME_ROOM=!roomid:homeserver
GATEWAY_ALLOW_ALL_USERS=true

# === Hindsight API (if using local Hindsight) ===
# Only needed if Hindsight LLM uses SiliconFlow (local embedding/reranker doesn't need this)
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# === API Server ===
API_SERVER_ENABLED=true
API_SERVER_KEY=desk-your-api-key

# === Email (if using email gateway) ===
EMAIL_ADDRESS=your@email.com
EMAIL_PASSWORD=your-app-password
EMAIL_IMAP_HOST=imap.your-provider.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.your-provider.com
EMAIL_SMTP_PORT=465
EMAIL_POLL_INTERVAL=30
EMAIL_ALLOWED_USERS=your@email.com
EMAIL_HOME_ADDRESS=your@email.com

# === Optional Providers ===
# OPENAI_API_KEY=sk-your-openai-key
# KIMI_API_KEY=sk-your-kimi-key
# ANTHROPIC_AUTH_TOKEN=your-token
# ANTHROPIC_BASE_URL=http://127.0.0.1:15721

# === Terminal ===
TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300

# === Browser ===
BROWSERBASE_PROXIES=true
BROWSERBASE_ADVANCED_STEALTH=false
BROWSER_SESSION_TIMEOUT=300
BROWSER_INACTIVITY_TIMEOUT=120
