{
  "name": "swarmstudio",
  "desktopName": "com.hermeswebui.studio.desktop",
  "version": "0.7.39",
  "description": "SwarmStudio desktop distribution with bundled Python runtime and hermes-agent",
  "homepage": "https://hermes-studio.ai",
  "author": {
    "name": "SwarmStudio Contributors",
    "email": "noreply@swarmstudio.local"
  },
  "license": "BSL-1.1",
  "private": true,
  "main": "dist/main/entry.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build": "npm run build:main",
    "test:updater": "npm run build && node --test tests/*.test.cjs",
    "fetch:node": "node scripts/fetch-node.mjs",
    "fetch:git": "node scripts/fetch-git.mjs",
    "fetch:python": "node scripts/fetch-python.mjs",
    "fetch:hermes": "node scripts/fetch-hermes.mjs",
    "install:hermes": "node scripts/install-hermes.mjs",
    "write:runtime-release": "node scripts/write-runtime-release.mjs",
    "prepare:runtime": "npm run fetch:node && npm run fetch:git && npm run fetch:python && npm run fetch:hermes && npm run install:hermes && npm run prune:python",
    "prepare:python": "npm run prepare:runtime",
    "package:runtime": "node scripts/package-runtime.mjs",
    "runtime:asset-name": "node scripts/runtime-asset-name.mjs",
    "prune:python": "node scripts/prune-python.mjs",
    "dev": "npm run build:main && electron .",
    "dist": "npm run build && node scripts/electron-builder.mjs",
    "dist:update-test": "npm run build && node scripts/build-update-test.mjs",
    "dist:mac": "npm run build && node scripts/electron-builder.mjs --mac",
    "dist:win": "npm run build && node scripts/electron-builder.mjs --win",
    "dist:linux": "npm run build && node scripts/electron-builder.mjs --linux"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "electron": "^42.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "dbus-next": "0.10.2",
    "electron-updater": "^6.3.9",
    "tar": "^7.5.16"
  }
}
